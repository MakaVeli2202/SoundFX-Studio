                                                                            </Trigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#3310B981"/>
                                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsEnabled" Value="False">
                                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>
                                                            <TextBlock x:Name="AdvancedA1Status" Text="A1: unknown"
                                                                       VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#8891B8" FontSize="12"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="#22081428" CornerRadius="10" Padding="12,10" Margin="0,0,0,10"
                                                        BorderBrush="#338B5CF6" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="VIRTUAL INPUT STRIP B1 (processed voice → Discord/teams)"
                                                                   Foreground="#C9D7F0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ToggleButton x:Name="AdvancedVirtualB1ToggleBtn"
                                                                          Content="Teammates (Virtual Input B1)"
                                                                          ClickMode="Press"
                                                                          Checked="AdvancedVirtualB1Toggle_Checked"
                                                                          Unchecked="AdvancedVirtualB1Toggle_Unchecked"
                                                                          Height="34"
                                                                          Background="#222A2A66" BorderBrush="#10B981"
                                                                          Foreground="#A7F3D0" Cursor="Hand" FontWeight="SemiBold" FontSize="12"
                                                                          ToolTip="Routes the Voicemeeter virtual input to B1 — what teammates hear in Discord/teams">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#3310B981"/>
                                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#3310B981"/>
                                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsEnabled" Value="False">
                                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>
                                                            <TextBlock x:Name="AdvancedVirtualB1Status" Text="Virtual B1: unknown"
                                                                       VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#8891B8" FontSize="12"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Button x:Name="AdvancedConfigureVmOnlyBtn"
                                                            Content="Configure Voicemeeter Only"
                                                            Click="AdvancedConfigureVmOnly_Click"
                                                            Height="34"
                                                            Background="#222A2A66" BorderBrush="#10B981"
                                                            Foreground="White" Cursor="Hand" FontSize="12">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#442A2A66"/>
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button x:Name="AdvancedRouteInputOnlyBtn"
                                                            Content="Set Input To B1 Only"
                                                            Margin="8,0,0,0"
                                                            Click="AdvancedRouteInputOnly_Click"
                                                            Height="34"
                                                            Background="#222A2A66" BorderBrush="#F59E0B"
                                                            Foreground="White" Cursor="Hand" FontSize="12">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#442A2A66"/>
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#F59E0B"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>

                                                <Button x:Name="AdvancedTestHearBtn"
                                                        Content="Hear what others hear (B1 monitor)"
                                                        Margin="0,0,0,10"
                                                        Click="AdvancedTestHear_Click"
                                                        Height="34"
                                                        Background="#22112233" BorderBrush="#10B981"
                                                        Foreground="#A7F3D0" Cursor="Hand" FontSize="12"
                                                        ToolTip="Listen to the exact mix your mic sends to Discord (VoiceMeeter B1)">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#3310B981"/>
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button x:Name="AdvancedResetWindowsBtn"
                                                        Content="Reset Windows Settings"
                                                        Margin="0,0,0,10"
                                                        Click="AdvancedResetWindows_Click"
                                                        Height="34"
                                                        Background="#222A2A66" BorderBrush="#F43F5E"
                                                        Foreground="White" Cursor="Hand" FontSize="12"
                                                        ToolTip="Restore Windows sound devices and reset Voicemeeter routing">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#44F43F5E"/>
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#F43F5E"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <TextBlock x:Name="AdvancedVmStatus" Text="Voicemeeter not checked"
                                                           Foreground="#8891B8" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="AdvancedResetStatus" Text=""
                                                           Foreground="#8891B8" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="#A1B2D2"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Bottom"
                                           Margin="18,0,18,12"/>

                            </Grid>
                        </Border>
                    </Grid>
            </Border>

            <!-- Title Bar -->

                <Border HorizontalAlignment="Stretch"
                    Height="44"
                    VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Style="{StaticResource WindowChromeBar}"
                    CornerRadius="0">
                <Grid Margin="18,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="SOUNDFX STUDIO"
                               VerticalAlignment="Center"
                               Foreground="#E6F4FF"
                               FontSize="17"
                               FontWeight="Bold"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowChromeButton}"
                                Content="&#x2212;"
                                FontSize="17"
                                Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource WindowChromeCloseButton}"
                                Content="&#x2715;"
                                FontSize="15"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>



            <!-- Sidebar -->

                <Border Style="{StaticResource GlassPanel}"
                    Width="252"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="35,74,0,0"
                    ClipToBounds="True">

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,18,16,16">

                        <Border Height="150"
                                Background="#111D30"
                                BorderBrush="#2A3F5E"
                                BorderThickness="1"
                                CornerRadius="14"
                                ClipToBounds="True"
                                Margin="0,0,0,12">
                            <Image x:Name="SidebarLogoImage" Source="/Assets/UI/MainDashboardLogo.png" Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry RadiusX="14" RadiusY="14">
                                        <RectangleGeometry.Rect>
                                            <MultiBinding Converter="{StaticResource SizeToRectConverter}">
                                                <Binding ElementName="SidebarLogoImage" Path="ActualWidth"/>
                                                <Binding ElementName="SidebarLogoImage" Path="ActualHeight"/>
                                            </MultiBinding>
                                        </RectangleGeometry.Rect>
                                    </RectangleGeometry>
                                </Image.Clip>
                            </Image>
                        </Border>

                        <!-- NAVIGATION -->
                        <Grid Margin="4,2,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="NAVIGATION" FontSize="11" FontWeight="Bold" Foreground="#00D4FF" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Home -->
                        <Button Click="NavigateHome_Click"
                                AutomationProperties.Name="Home"
                                ToolTip="Home">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                            <Setter Property="Background" Value="#2A00D4FF"/>
                                            <Setter Property="BorderBrush" Value="#00D4FF"/>
                                            <Setter Property="Foreground" Value="#7FDBFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="Home" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Sound Library -->
                        <Button Click="NavigateSoundLibrary_Click"
                                AutomationProperties.Name="Sound Library"
                                ToolTip="Sound Library">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="SoundLibrary">
                                            <Setter Property="Background" Value="#2AA855F7"/>
                                            <Setter Property="BorderBrush" Value="#A855F7"/>
                                            <Setter Property="Foreground" Value="#D8B4FE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="Sound Library" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Effects -->
                        <Button Click="NavigateEffects_Click"
                                AutomationProperties.Name="Voice Changer"
                                ToolTip="Voice Changer">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="Effects">
                                            <Setter Property="Background" Value="#2AFF4DC8"/>
                                            <Setter Property="BorderBrush" Value="#FF4DC8"/>
                                            <Setter Property="Foreground" Value="#FFB3E6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="Voice Changer" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Settings -->
                        <Button Click="NavigateSettings_Click"
                                AutomationProperties.Name="Settings"
                                ToolTip="Settings">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                                            <Setter Property="Background" Value="#2AFFB020"/>
                                            <Setter Property="BorderBrush" Value="#FFB020"/>
                                            <Setter Property="Foreground" Value="#FFD488"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#1B3157" Margin="6,8,6,12"/>

                        <!-- AUDIO STATUS -->
                        <TextBlock Text="AUDIO STATUS" FontSize="11" FontWeight="Bold" Foreground="#00D4FF" Margin="6,14,0,8"/>

                        <Border Background="#8C0C1424" BorderBrush="#1B3157" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE983;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#2CE96E" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Output" FontSize="10.5" Foreground="#7F899C"/>
                                        <TextBlock Text="{Binding CurrentOutputDevice}" FontSize="12.5" Foreground="#DDEAFF" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#2CE96E" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Input" FontSize="10.5" Foreground="#7F899C"/>
                                        <TextBlock Text="{Binding CurrentInputDevice}" FontSize="12.5" Foreground="#DDEAFF" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" HorizontalAlignment="Left" Margin="4,0,0,0"
                                             VerticalAlignment="Center" Fill="{Binding IsSoundboardActiveColor}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Soundboard" FontSize="10.5" Foreground="#7F899C"/>
                                        <TextBlock Text="{Binding IsSoundboardActiveText}" FontSize="12.5" Foreground="{Binding IsSoundboardActiveColor}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding RoutingStatus}" FontSize="10.5" Foreground="#7F899C" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>


            <!-- Footer Bar -->
                <Border Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                    Margin="35,0,35,35"
                    Background="#121E31" BorderBrush="#33507AAE" BorderThickness="1" CornerRadius="14"
                    Padding="18,10,18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x266B;" FontSize="14" Foreground="#00D4FF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="#94AFD0" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="SOUNDFX STUDIO" Foreground="#5A7CA8" FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>

        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource ShellPulseStoryboard}"/>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</Window>