<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\UI\HeroSection.png" />
    <None Remove="Assets\UI\MainDashboardLogo.png" />
    <None Remove="Assets\ArtTune\ArtTune-OneClick.ps1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\Keyboards\" />
    <Folder Include="Controls\" />
    <Folder Include="Views\Dialogs\" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SoundFXStudioLogo.png" />
    <Resource Include="Assets\Keyboards\LEDOFF.png" />
    <Resource Include="Assets\Keyboards\LEDON.png" />
    <Resource Include="Assets\Keyboards\SoundFXKeyBoard.png" />
    <Resource Include="Assets\UI\HeroSection.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\UI\MainDashboardLogo.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Pics\MainWindowBackground.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Content Include="Assets\ArtTune\ArtTune-OneClick.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.1.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageReference Include="SwatRecords.NetCDF" Version="1.0.2" />
  </ItemGroup>

</Project>
