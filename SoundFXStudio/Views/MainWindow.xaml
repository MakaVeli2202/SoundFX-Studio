<Window x:Class="SoundFXStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundFXStudio.Controls"
        xmlns:converters="clr-namespace:SoundFXStudio.Converters"
        xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore"
        Title="SoundFX Studio"
        Icon="/Assets/SoundFXStudioLogo.png"
        Width="1366"
        Height="900"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>



        <!-- ═══ MyBoard-Style Button Templates ═══ -->

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F43F5E" Offset="0"/>
            <GradientStop Color="#E11D48" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="RoundButton" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
        </Style>

        <Style x:Key="RoundButtonSecondary" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="RoundButtonDanger" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="{StaticResource DangerGradient}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#F43F5E" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Settings Panel Button ═══ -->
        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDEAFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#1A2A2A66"/>
            <Setter Property="BorderBrush" Value="#558B5CF6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                         <ControlTemplate.Triggers>
                             <Trigger Property="IsMouseOver" Value="True">
                                 <Setter TargetName="Bd" Property="Background" Value="#228B5CF6"/>
                                 <Setter TargetName="Bd" Property="BorderBrush" Value="#8B5CF6"/>
                                 <Setter TargetName="Bd" Property="Effect">
                                     <Setter.Value>
                                         <effects:DropShadowEffect Color="#8B5CF6" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                     </Setter.Value>
                                 </Setter>
                             </Trigger>
                             <Trigger Property="IsPressed" Value="True">
                                 <Setter TargetName="Bd" Property="Background" Value="#338B5CF6"/>
                                 <Setter TargetName="Bd" Property="BorderBrush" Value="#7C3AED"/>
                             </Trigger>
                         </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Sidebar Navigation Button ═══ -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#8F9DB5"/>
            <Setter Property="Background" Value="#0C1424"/>
            <Setter Property="BorderBrush" Value="#1B3157"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16223D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2F4A78"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2E52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Settings Section Nav Button ═══ -->
        <Style x:Key="SettingsSectionButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ═══ MyBoard 3D Keycap Tile Style ═══ -->
        <Style x:Key="SoundTileButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="190"/>
            <Setter Property="MinHeight" Value="132"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="16"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderAccentBrush}"
                                BorderThickness="1"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1A2A48"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#14233D"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrandMagenta}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrandCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="8,0,8,8"
        CornerRadius="16"
        Background="#0A111C">

        <Border.Effect>
            <DropShadowEffect BlurRadius="50"
                          ShadowDepth="0"
                          Color="#000000"
                          Opacity="0.6"/>
        </Border.Effect>

        <Border.BorderBrush>

            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,0">

                <GradientStop Color="#2AB8FF"
                              Offset="0"/>

                <GradientStop Color="#377DFF"
                              Offset="1"/>

            </LinearGradientBrush>

        </Border.BorderBrush>

        <Border.BorderThickness>2</Border.BorderThickness>

        <Grid>

            <!-- Dashboard Skin removed for modern clean shell -->
                 <Image Source="/Assets/UI/MainWindowBackground.png"
                     Stretch="Fill"
                     Margin="0,44,0,0"
                     Visibility="Collapsed"/>

            <!-- Dashboard Logo -->


                <Image Source="/Assets/UI/MainDashboardLogo.png"
                   Width="250"
                   Height="110"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                    Margin="35,70,0,0"
                   Visibility="Collapsed">
            </Image>

            <!-- Dashboard Hero Section -->
            <Border x:Name="HeroSectionBorder"
                    MinHeight="360"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="300,70,35,120">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="24" ClipToBounds="True" MinHeight="300">
                        <Grid>
                            <Image Source="/Assets/UI/HeroSection.png" Stretch="UniformToFill"/>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#CC071321" Offset="0"/>
                                        <GradientStop Color="#66071423" Offset="0.55"/>
                                        <GradientStop Color="#CC071321" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Border VerticalAlignment="Stretch" Background="#3308121D" Padding="28,24,28,24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" MaxWidth="520">
                                        <TextBlock Text="SOUNDBOARD" Foreground="#9BC1E5" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="Fast trigger control"
                                                   Foreground="#F7FAFF"
                                                   FontSize="34"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                        <TextBlock Text="Open the keyboard, cue the right sound, and stay in flow without losing context."
                                                   Foreground="#DDE7F8"
                                                   FontSize="14"
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button x:Name="OpenKeyboardOverlayButton"
                                            Grid.Column="1"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Width="206"
                                            Height="44"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="24,0,0,0"
                                            AutomationProperties.Name="Open Keyboard"
                                            AutomationProperties.AutomationId="OpenKeyboardButton"
                                            Click="OpenKeyboardWindowButton_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#EAF1FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Open Keyboard" FontSize="13.5" FontWeight="SemiBold" Foreground="#EAF1FF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource SurfaceCardStyle}"
                                Margin="0,0,8,0"
                                Padding="16">
                            <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="NavigateSoundLibrary_Click">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#8B5CF6"/>
                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                        <TextBlock Text="Browse sounds" Foreground="#F7FAFF" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Search, filter, and jump straight to a sound." Foreground="#8EA2C0" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource SurfaceCardStyle}"
                                Margin="8,0,8,0"
                                Padding="16">
                            <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="NavigateEffects_Click">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#10B981"/>
                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                        <TextBlock Text="Voice changer" Foreground="#F7FAFF" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Adjust your voice workflow and monitor status." Foreground="#8EA2C0" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource SurfaceCardStyle}"
                                Margin="8,0,0,0"
                                Padding="16">
                            <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="NavigateSettings_Click">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#2AB8FF"/>
                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                        <TextBlock Text="Settings" Foreground="#F7FAFF" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Tune devices, routing, and hotkeys when needed." Foreground="#8EA2C0" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Effects Page -->
            <Border Height="700"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="300,70,35,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Effects">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="VOICE CHANGER" Foreground="#8B5CF6" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Route your microphone through the voice pipeline, then refine the effect with presets and tone controls."
                                       Foreground="#7F899C" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" MinWidth="260">
                            <StackPanel>
                                <TextBlock Text="FLOW" Foreground="#8B5CF6" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock Text="Microphone → Voice Changer → Output" Foreground="#F7FAFF" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="Use the status snapshot below to confirm your current input and routing before you start." Foreground="#8EA2C0" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="INPUT" Foreground="#8B5CF6" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentInputDevice, FallbackValue='No input device selected'}" Foreground="#F7FAFF" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                <TextBlock Text="STATUS" Foreground="#8B5CF6" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock x:Name="VoiceChangerSummaryText" Text="Ready to start" Foreground="#10B981" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="OUTPUT" Foreground="#8B5CF6" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentOutputDevice, FallbackValue='No output device selected'}" Foreground="#F7FAFF" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="PRIMARY CONTROLS" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Start or stop the real-time processing pipeline and preview what your team hears." Foreground="#A1B2D2" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <Button x:Name="VoiceChangerToggleBtn"
                                        Content="Start Voice Changer"
                                        Height="38" HorizontalAlignment="Left" Padding="18,0"
                                        Background="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource BorderAccentBrush}" Foreground="White"
                                        BorderThickness="1" Cursor="Hand" FontSize="12" FontWeight="SemiBold" AutomationProperties.Name="Start Voice Changer"/>
                                <Border Margin="0,12,0,0" Background="#1AFFFFFF" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="VoiceChangerStatusDot" Width="8" Height="8" CornerRadius="4" Background="#E85555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="VoiceChangerStatus" Text="Stopped"
                                                   Foreground="#E85555" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <TextBlock Text="&#xE7C1;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="MONITOR" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Hear what your mic sends to your team while you talk." Foreground="#A1B2D2" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button x:Name="TeamMonitorToggleBtn"
                                        Content="Hear What People Hear"
                                        Height="34" HorizontalAlignment="Left" Padding="14,0"
                                        Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderAccentBrush}" Foreground="White"
                                        BorderThickness="1" Cursor="Hand" FontSize="11.5" FontWeight="SemiBold"
                                        Click="TeamMonitorToggle_Click" AutomationProperties.Name="Hear What People Hear"/>
                                <Border Margin="0,10,0,0" Background="#1AFFFFFF" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="TeamMonitorStatusDot" Width="8" Height="8" CornerRadius="4" Background="#98A0C0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TeamMonitorStatus" Text="Off"
                                                   Foreground="#98A0C0" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="EFFECT CONTROLS" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Choose a preset, then tune the pitch and formant to match your voice." Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,6"/>
                                <ComboBox x:Name="VoiceChangerPresetCombo" Height="30" HorizontalAlignment="Stretch"
                                          Background="#44111A2E" BorderBrush="#558B5CF6" Foreground="White" FontSize="12"
                                          BorderThickness="1" Padding="6,1" Margin="0,0,0,4"
                                          DisplayMemberPath="Name"/>
                                <TextBlock x:Name="PresetSummaryText" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="PITCH" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Shift your voice up or down in semitones." Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="PitchSlider" Grid.Column="0"
                                            Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="1"
                                            TickFrequency="2" TickPlacement="BottomRight"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="5" Padding="8,3">
                                        <TextBlock x:Name="PitchValueText" Text="0.0 st"
                                                   Foreground="White" FontSize="11" FontWeight="Bold"
                                                   MinWidth="40" TextAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="FORMANT" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Change voice character without pitch." Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="FormantSlider" Grid.Column="0"
                                            Minimum="0.5" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="5" Padding="8,3">
                                        <TextBlock x:Name="FormantValueText" Text="1.00x"
                                                   Foreground="White" FontSize="11" FontWeight="Bold"
                                                   MinWidth="40" TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Library Page (tile grid) — MyBoard design with dark theme -->
                    <Border Height="700"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="300,70,35,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="SoundLibrary">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="LIBRARY"
                                   Foreground="#8B5CF6"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <TextBlock Grid.Row="1"
                                   Text="Find the sound you need quickly, then trigger, edit, or manage it from one place."
                                   Foreground="#8EA2C0"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>
                    </Grid>

                    <!-- TOOLBAR -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" ItemHeight="36">
                                <Button Content="+ Add Sound"
                                        Style="{StaticResource RoundButton}"
                                        Command="{Binding AddSoundCommand}"/>
                                <Button Content="&#x1F310; URL"
                                        Style="{StaticResource RoundButtonSecondary}"
                                        Command="{Binding AddSoundFromUrlCommand}"/>
                                <Button Content="&#x1F3A4; Mic"
                                        Style="{StaticResource RoundButtonSecondary}"
                                        Click="LibraryMicButton_Click"/>
                                <Button Content="&#x1F5D1; Delete"
                                        Style="{StaticResource RoundButtonDanger}"
                                        Command="{Binding DeleteMarkedSoundsCommand}"/>
                            </WrapPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#171F33" BorderBrush="#2B3F5E" BorderThickness="1" CornerRadius="999" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Sounds.Count, StringFormat='{}{0} sounds'}" Foreground="#DDE7F8" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#171F33" BorderBrush="#2B3F5E" BorderThickness="1" CornerRadius="999" Padding="10,4">
                                    <TextBlock Text="{Binding SoundsView.Count, StringFormat='{}{0} visible'}" Foreground="#8EA2C0" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SEARCH & FILTERS -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="#0C1424" CornerRadius="10" BorderBrush="#1B3157" BorderThickness="1" Padding="0">
                                <Grid>
                                    <TextBlock Text="&#x1F50D;" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox x:Name="LibrarySearchBox"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="White" FontSize="12" CaretBrush="White"
                                             VerticalAlignment="Center"
                                             Margin="30,0,8,0">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Text="Search sounds..." Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                               VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <ComboBox Grid.Column="1"
                                      Width="180"
                                      Margin="10,0,0,0"
                                      ItemsSource="{Binding Categories}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Name"
                                      SelectedValue="{Binding SelectedCategoryFilter, Mode=TwoWay}">
                                <ComboBox.Items>
                                    <ComboBoxItem Content="All"/>
                                </ComboBox.Items>
                            </ComboBox>

                            <CheckBox Grid.Column="2"
                                      Margin="10,0,0,0"
                                      Content="Favorites only"
                                      Foreground="#DDE7F8"
                                      IsChecked="{Binding FavoritesOnly, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- TILES - MyBoard 3D keycap style -->
                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="4,0,4,0">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollViewer">
                                            <Grid>
                                                <ScrollContentPresenter Margin="0,0,6,0"/>
                                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                                           Value="{TemplateBinding VerticalOffset}"
                                                           Maximum="{TemplateBinding ScrollableHeight}"
                                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                           Background="#0A1424"
                                                           BorderBrush="#1B3157"
                                                           BorderThickness="1"
                                                           Width="8"
                                                           Cursor="Hand">
                                                    <ScrollBar.Template>
                                                        <ControlTemplate TargetType="ScrollBar">
                                                            <Grid>
                                                                <Track x:Name="PART_Track">
                                                                    <Track.Thumb>
                                                                        <Thumb BorderBrush="#8B5CF6" Background="#228B5CF6" BorderThickness="1">
                                                                            <Thumb.Template>
                                                                                <ControlTemplate TargetType="Thumb">
                                                                                    <Border CornerRadius="4" Background="#228B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" Margin="0,1"/>
                                                                                </ControlTemplate>
                                                                            </Thumb.Template>
                                                                        </Thumb>
                                                                    </Track.Thumb>
                                                                </Track>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </ScrollBar.Template>
                                                </ScrollBar>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Style>

                        <ItemsControl ItemsSource="{Binding SoundsView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SoundTileButton}"
                                            Command="{Binding DataContext.PlaySoundCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                            CommandParameter="{Binding}">
                                        <Grid Margin="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="34" Height="34" CornerRadius="10" Background="#171F33" BorderBrush="#2B3F5E" BorderThickness="1" VerticalAlignment="Center">
                                                    <TextBlock Text="&#x266B;" FontSize="16" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="#F7FAFF" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Category}" Foreground="#8EA2C0" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <Border Grid.Column="2" Background="#221A2F" BorderBrush="#6D4AFF" BorderThickness="1" CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Hotkey, TargetNullValue=''}" Foreground="#DDE7F8" FontSize="10.5" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Tap to trigger" Foreground="#DDE7F8" FontSize="11.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="Use the context menu to edit, bind, or favorite it." Foreground="#7F899C" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Background="#171F33" BorderBrush="#2B3F5E" BorderThickness="1" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding AssignedKeyLabel, TargetNullValue='+ key'}" Foreground="#A7B6CF" FontSize="10.5"/>
                                                </Border>

                                                <Border Grid.Column="1" Background="#131B2F" BorderBrush="#1B3157" BorderThickness="1" CornerRadius="8" Padding="8,4">
                                                    <TextBlock Text="{Binding Volume, StringFormat='Volume {0:F0}%'}" Foreground="#8EA2C0" FontSize="10.5"/>
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <Button.ContextMenu>
                                            <ContextMenu Background="#1A1A2E"
                                                         BorderBrush="#2A2A4E"
                                                         BorderThickness="1"
                                                         Foreground="White"
                                                         FontSize="12"
                                                         HasDropShadow="True">
                                                <ContextMenu.Resources>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Background" Value="#1A1A2E"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#2A2A4E"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="12,6"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter Property="Background" Value="#282850"/>
                                                                <Setter Property="BorderBrush" Value="#3535D0"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style TargetType="Separator">
                                                        <Setter Property="Background" Value="#2A2A4E"/>
                                                        <Setter Property="Margin" Value="6,2"/>
                                                        <Setter Property="Height" Value="1"/>
                                                    </Style>
                                                </ContextMenu.Resources>
                                                <MenuItem Header="&#x25B6; Play" Click="SoundTileMenu_Play"/>
                                                <MenuItem Header="&#x270E; Edit" Click="SoundTileMenu_Edit"/>
                                                <MenuItem Header="&#x1F4CC; Assign to Key" Click="SoundTileMenu_Assign"/>
                                                <Separator/>
                                                <MenuItem Header="&#x1F4CE; Duplicate" Click="SoundTileMenu_Duplicate"/>
                                                <MenuItem Header="&#x2B50; Toggle Favorite" Click="SoundTileMenu_Favorite"/>
                                                <Separator/>
                                                <MenuItem Header="&#x1F5BC; Choose Image" Click="SoundTileMenu_ChooseImage"/>
                                                <MenuItem Header="&#x274C; Remove Image" Click="SoundTileMenu_RemoveImage"/>
                                                <MenuItem Header="&#x1F511; Remove Binding" Click="SoundTileMenu_ClearBinding"/>
                                                <Separator/>
                                                <MenuItem Header="&#x1F5D1; Delete" Foreground="#F43F5E" Click="SoundTileMenu_Delete"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Settings Page -->
                        <Border Height="700"
                        HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                        Margin="300,70,35,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
