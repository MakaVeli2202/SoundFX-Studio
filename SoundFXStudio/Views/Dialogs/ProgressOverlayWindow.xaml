<Window x:Class="SoundFXStudio.Views.Dialogs.ProgressOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundFX Studio"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <PathGeometry x:Key="SpinnerArcGeometry">
            <PathFigure StartPoint="60,10">
                <ArcSegment Point="16.7,35" Size="50,50" SweepDirection="Clockwise" IsLargeArc="True"/>
            </PathFigure>
        </PathGeometry>

        <Storyboard x:Key="SpinnerSpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:1.15"/>
        </Storyboard>

        <Storyboard x:Key="SpinnerGlowPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SpinnerGlow"
                             Storyboard.TargetProperty="Effect.Opacity"
                             From="0.45" To="0.9"
                             Duration="0:0:0.75"/>
        </Storyboard>

        <Storyboard x:Key="AmbientGlowStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="AmbientGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.8"
                             Duration="0:0:1.7"/>
        </Storyboard>
    </Window.Resources>

    <Border Margin="24"
            CornerRadius="30"
            Background="#B3080D17"
            BorderThickness="1.5"
            ClipToBounds="True">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00D4FF" Offset="0"/>
                <GradientStop Color="#7B3FFF" Offset="0.55"/>
                <GradientStop Color="#FF2DAF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#3300D4FF" BlurRadius="34" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Border Margin="5" CornerRadius="25">
                <Border.Background>
                    <ImageBrush ImageSource="/Assets/Pics/MainWindowBackground.png"
                                Stretch="UniformToFill"
                                Opacity="0.62"/>
                </Border.Background>
            </Border>

            <StackPanel Margin="30,26">
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,0">
                    <Border Width="64" Height="64" CornerRadius="18"
                            Background="#CC141E2D" BorderBrush="#334A647F" BorderThickness="1"
                            HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#3300D4FF" BlurRadius="18" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <Image Source="/Assets/SoundFXStudioLogo.png" Width="40" Height="40"/>
                    </Border>
                    <TextBlock Text="SOUNDFX STUDIO" HorizontalAlignment="Center" Margin="0,12,0,0"
                               Foreground="#9CEBFF" FontSize="10" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock x:Name="TitleText"
                           Text="Working…"
                           Foreground="White"
                           FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>

                <Grid Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,14,0,6">
                    <Ellipse x:Name="AmbientGlow" Width="130" Height="130" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#3300D4FF" Offset="0"/>
                                <GradientStop Color="#0000D4FF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid Width="88" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="Spinner"
                              Stroke="#2E5C7896" StrokeThickness="5"
                              Visibility="Visible">
                            <Path.Data>
                                <EllipseGeometry Center="44,44" RadiusX="36" RadiusY="36"/>
                            </Path.Data>
                        </Path>

                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Grid.RenderTransform>
                            <Path x:Name="SpinnerGlow" Data="{StaticResource SpinnerArcGeometry}"
                                  StrokeThickness="8"
                                  Stroke="{StaticResource AppBorderGradient}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Visible">
                                <Path.Effect>
                                    <DropShadowEffect Color="#00D4FF" BlurRadius="12" ShadowDepth="0" Opacity="0.75"/>
                                </Path.Effect>
                            </Path>
                            <Path x:Name="SpinnerBright" Data="{StaticResource SpinnerArcGeometry}"
                                  StrokeThickness="4"
                                  Stroke="#CCEAF1FF"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Opacity="0.9"
                                  Visibility="Visible"/>
                        </Grid>

                        <Path x:Name="CheckIcon"
                              Visibility="Collapsed"
                              Stroke="#10B981"
                              StrokeThickness="6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Path.Data>
                                <PathGeometry Figures="M 0,12 L 8,20 L 22,2"/>
                            </Path.Data>
                        </Path>
                    </Grid>
                </Grid>

                <TextBlock x:Name="StepText"
                           Text="Setting up…"
                           Foreground="#BCD0EC"
                           FontSize="12.5"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="340"/>
            </StackPanel>
        </Grid>

        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource SpinnerSpinStoryboard}"/>
                <BeginStoryboard Storyboard="{StaticResource SpinnerGlowPulseStoryboard}"/>
                <BeginStoryboard Storyboard="{StaticResource AmbientGlowStoryboard}"/>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</Window>
