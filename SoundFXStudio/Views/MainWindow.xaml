<Window x:Class="SoundFXStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundFXStudio.Controls"
        xmlns:converters="clr-namespace:SoundFXStudio.Converters"
        xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore"
        Title="SoundFX Studio"
        Icon="/Assets/SoundFXStudioLogo.png"
        Width="1366"
        Height="900"
        Background="#0B1226"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <converters:SizeToRectConverter x:Key="SizeToRectConverter"/>

        <Storyboard x:Key="LedTravelStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="MarqueeTopA" Storyboard.TargetProperty="Offset" From="-0.2" To="1.3" Duration="0:0:5" BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeTopB" Storyboard.TargetProperty="Offset" From="-0.12" To="1.38" Duration="0:0:5" BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeTopC" Storyboard.TargetProperty="Offset" From="-0.08" To="1.42" Duration="0:0:5" BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeTopD" Storyboard.TargetProperty="Offset" From="-0.04" To="1.46" Duration="0:0:5" BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeTopE" Storyboard.TargetProperty="Offset" From="0.04" To="1.54" Duration="0:0:5" BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeRightA" Storyboard.TargetProperty="Offset" From="-0.2" To="1.3" Duration="0:0:5" BeginTime="0:0:1.25"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeRightB" Storyboard.TargetProperty="Offset" From="-0.12" To="1.38" Duration="0:0:5" BeginTime="0:0:1.25"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeRightC" Storyboard.TargetProperty="Offset" From="-0.08" To="1.42" Duration="0:0:5" BeginTime="0:0:1.25"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeRightD" Storyboard.TargetProperty="Offset" From="-0.04" To="1.46" Duration="0:0:5" BeginTime="0:0:1.25"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeRightE" Storyboard.TargetProperty="Offset" From="0.04" To="1.54" Duration="0:0:5" BeginTime="0:0:1.25"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeBottomA" Storyboard.TargetProperty="Offset" From="-0.2" To="1.3" Duration="0:0:5" BeginTime="0:0:2.5"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeBottomB" Storyboard.TargetProperty="Offset" From="-0.12" To="1.38" Duration="0:0:5" BeginTime="0:0:2.5"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeBottomC" Storyboard.TargetProperty="Offset" From="-0.08" To="1.42" Duration="0:0:5" BeginTime="0:0:2.5"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeBottomD" Storyboard.TargetProperty="Offset" From="-0.04" To="1.46" Duration="0:0:5" BeginTime="0:0:2.5"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeBottomE" Storyboard.TargetProperty="Offset" From="0.04" To="1.54" Duration="0:0:5" BeginTime="0:0:2.5"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeLeftA" Storyboard.TargetProperty="Offset" From="-0.2" To="1.3" Duration="0:0:5" BeginTime="0:0:3.75"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeLeftB" Storyboard.TargetProperty="Offset" From="-0.12" To="1.38" Duration="0:0:5" BeginTime="0:0:3.75"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeLeftC" Storyboard.TargetProperty="Offset" From="-0.08" To="1.42" Duration="0:0:5" BeginTime="0:0:3.75"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeLeftD" Storyboard.TargetProperty="Offset" From="-0.04" To="1.46" Duration="0:0:5" BeginTime="0:0:3.75"/>
            <DoubleAnimation Storyboard.TargetName="MarqueeLeftE" Storyboard.TargetProperty="Offset" From="0.04" To="1.54" Duration="0:0:5" BeginTime="0:0:3.75"/>
        </Storyboard>

        <Storyboard x:Key="OpenKeyboardLedRingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RingStopA" Storyboard.TargetProperty="Offset" From="1.0" To="-1.0" Duration="0:0:4"/>
            <DoubleAnimation Storyboard.TargetName="RingStopB" Storyboard.TargetProperty="Offset" From="0.8" To="-1.2" Duration="0:0:4"/>
            <DoubleAnimation Storyboard.TargetName="RingStopC" Storyboard.TargetProperty="Offset" From="0.6" To="-1.4" Duration="0:0:4"/>
        </Storyboard>

        <Storyboard x:Key="ShellPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="ShellGlow" Storyboard.TargetProperty="Opacity" From="0.14" To="0.24" Duration="0:0:3.4"/>
        </Storyboard>

        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Background" Value="#85141E2D"/>
            <Setter Property="BorderBrush" Value="#334A647F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>



        <!-- ═══ MyBoard-Style Button Templates ═══ -->

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F43F5E" Offset="0"/>
            <GradientStop Color="#E11D48" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="RoundButton" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
        </Style>

        <Style x:Key="RoundButtonSecondary" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="RoundButtonDanger" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="{TemplateBinding Padding}" Background="{StaticResource DangerGradient}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#F43F5E" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Settings Panel Button ═══ -->
        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDEAFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#122036"/>
            <Setter Property="BorderBrush" Value="#4A00D4FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                         <ControlTemplate.Triggers>
                             <Trigger Property="IsMouseOver" Value="True">
                                 <Setter TargetName="Bd" Property="Background" Value="#2A00D4FF"/>
                                 <Setter TargetName="Bd" Property="BorderBrush" Value="#AA00D4FF"/>
                                 <Setter TargetName="Bd" Property="Effect">
                                     <Setter.Value>
                                         <effects:DropShadowEffect Color="#00D4FF" BlurRadius="16" ShadowDepth="0" Opacity="0.38"/>
                                     </Setter.Value>
                                 </Setter>
                             </Trigger>
                             <Trigger Property="IsPressed" Value="True">
                                 <Setter TargetName="Bd" Property="Background" Value="#3A00D4FF"/>
                                 <Setter TargetName="Bd" Property="BorderBrush" Value="#00D4FF"/>
                             </Trigger>
                         </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Sidebar Navigation Button ═══ -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#A9BAD3"/>
            <Setter Property="Background" Value="#0F192B"/>
            <Setter Property="BorderBrush" Value="#22344D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="ActiveGlow"
                                    CornerRadius="14"
                                    Margin="1"
                                    BorderThickness="1.5"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderBrush.Color}"/>
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <effects:DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55">
                                        <effects:DropShadowEffect.Color>
                                            <Binding Path="BorderBrush.Color" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        </effects:DropShadowEffect.Color>
                                    </effects:DropShadowEffect>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Bd" CornerRadius="12"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,10,0"/>
                            </Border>
                            <Border x:Name="ActiveStrip"
                                    Width="3"
                                    Margin="0,10,0,10"
                                    HorizontalAlignment="Left"
                                    CornerRadius="3"
                                    Background="{TemplateBinding BorderBrush}"
                                    Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15253D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B5E87"/>
                                <Setter TargetName="ActiveStrip" Property="Opacity" Value="0.45"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background.Color" To="#15253D" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="BorderBrush.Color" To="#3B5E87" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveStrip" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D3154"/>
                                <Setter TargetName="ActiveStrip" Property="Opacity" Value="0.8"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="BorderBrush" Value="#00D4FF">
                                <Setter TargetName="ActiveStrip" Property="Opacity" Value="1"/>
                                <Setter TargetName="Bd" Property="Background" Value="#2200D4FF"/>
                                <Setter TargetName="ActiveGlow" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveStrip" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="(Border.Effect).(effects:DropShadowEffect.Opacity)" From="0.35" To="0.75" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="BorderBrush" Value="#A855F7">
                                <Setter TargetName="ActiveStrip" Property="Opacity" Value="1"/>
                                <Setter TargetName="Bd" Property="Background" Value="#22A855F7"/>
                                <Setter TargetName="ActiveGlow" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveStrip" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="(Border.Effect).(effects:DropShadowEffect.Opacity)" From="0.35" To="0.75" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="BorderBrush" Value="#FF4DC8">
                                <Setter TargetName="ActiveStrip" Property="Opacity" Value="1"/>
                                <Setter TargetName="Bd" Property="Background" Value="#22FF4DC8"/>
                                <Setter TargetName="ActiveGlow" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveStrip" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="(Border.Effect).(effects:DropShadowEffect.Opacity)" From="0.35" To="0.75" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="BorderBrush" Value="#FFB020">
                                <Setter TargetName="ActiveStrip" Property="Opacity" Value="1"/>
                                <Setter TargetName="Bd" Property="Background" Value="#22FFB020"/>
                                <Setter TargetName="ActiveGlow" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveStrip" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="(Border.Effect).(effects:DropShadowEffect.Opacity)" From="0.35" To="0.75" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Settings Section Nav Button ═══ -->
        <Style x:Key="SettingsSectionButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- ═══ MyBoard 3D Keycap Tile Style ═══ -->
        <Style x:Key="SoundTileButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="OuterShell" CornerRadius="20" Margin="0,0,0,6">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3A5680" Offset="0"/>
                                        <GradientStop Color="#172B4F" Offset="0.35"/>
                                        <GradientStop Color="#0A1126" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <effects:DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.7"/>
                                </Border.Effect>
                                <Border Margin="1" CornerRadius="18" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4A6A9E" Offset="0"/>
                                            <GradientStop Color="#142447" Offset="0.22"/>
                                            <GradientStop Color="#0B1226" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                            <Border x:Name="InnerFace" Margin="0,0,0,10" CornerRadius="16" BorderBrush="#2AFFFFFF" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#16233E" Offset="0"/>
                                        <GradientStop Color="#0A1122" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Border Margin="7,7,7,9" CornerRadius="11" ClipToBounds="True" Background="#0D0A1424">
                                        <Grid>
                                            <ContentPresenter x:Name="TileContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        </Grid>
                                    </Border>
                                    <Border VerticalAlignment="Top" Height="14" Margin="7,7,7,0" CornerRadius="11,11,0,0" IsHitTestVisible="False" Opacity="0.4">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#2AFFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InnerFace" Property="BorderBrush" Value="#8800D4FF"/>
                                <Setter TargetName="OuterShell" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#00D4FF" BlurRadius="22" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.13"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.13"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InnerFace" Property="BorderBrush" Value="#FF2DAF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="InnerFace" Property="BorderBrush" Value="#00D4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="0"
        CornerRadius="10">
        <Border.BorderBrush>

            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,0">

                <GradientStop Color="#2AB8FF"
                              Offset="0"/>

                <GradientStop Color="#377DFF"
                              Offset="1"/>

            </LinearGradientBrush>

        </Border.BorderBrush>

        <Border.BorderThickness>1.5</Border.BorderThickness>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.RowSpan="2" RadiusX="12" RadiusY="12" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="/Assets/Pics/MainWindowBackground.png"
                                Stretch="Fill"/>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle Grid.RowSpan="2" RadiusX="12" RadiusY="12" Fill="#4D000000" IsHitTestVisible="False"/>

            <Border x:Name="ShellGlow"
                    Margin="3"
                    CornerRadius="18"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Opacity="0.14">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#2200D4FF"/>
                </Border.BorderBrush>
            </Border>

            <Border Margin="2"
                    CornerRadius="18"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Opacity="0.58">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="LedStopA" Color="#0000D4FF" Offset="-0.4"/>
                        <GradientStop x:Name="LedStopB" Color="#D000D4FF" Offset="-0.2"/>
                        <GradientStop x:Name="LedStopC" Color="#00FF2DAF" Offset="0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="#2900D4FF" BlurRadius="10" ShadowDepth="0" Opacity="0.36"/>
                </Border.Effect>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource LedTravelStoryboard}"/>
                    </EventTrigger>
                </Border.Triggers>
            </Border>

            <!-- Circling LED frame -->
            <Rectangle x:Name="MarqueeTop" Height="3" Margin="3,3,3,0"
                       VerticalAlignment="Top" HorizontalAlignment="Stretch"
                       RadiusX="2" RadiusY="2" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="MarqueeTopA" Color="#0000D4FF" Offset="-0.2"/>
                        <GradientStop x:Name="MarqueeTopB" Color="#5F00D4FF" Offset="-0.12"/>
                        <GradientStop x:Name="MarqueeTopC" Color="#FF4DEBFF" Offset="-0.08"/>
                        <GradientStop x:Name="MarqueeTopD" Color="#5F00D4FF" Offset="-0.04"/>
                        <GradientStop x:Name="MarqueeTopE" Color="#0000D4FF" Offset="0.04"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle x:Name="MarqueeRight" Width="3" Margin="0,3,3,3"
                       VerticalAlignment="Stretch" HorizontalAlignment="Right"
                       RadiusX="2" RadiusY="2" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="MarqueeRightA" Color="#0000D4FF" Offset="-0.2"/>
                        <GradientStop x:Name="MarqueeRightB" Color="#5F00D4FF" Offset="-0.12"/>
                        <GradientStop x:Name="MarqueeRightC" Color="#FF4DEBFF" Offset="-0.08"/>
                        <GradientStop x:Name="MarqueeRightD" Color="#5F00D4FF" Offset="-0.04"/>
                        <GradientStop x:Name="MarqueeRightE" Color="#0000D4FF" Offset="0.04"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle x:Name="MarqueeBottom" Height="3" Margin="0,0,3,3"
                       VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                       RadiusX="2" RadiusY="2" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                        <GradientStop x:Name="MarqueeBottomA" Color="#0000D4FF" Offset="-0.2"/>
                        <GradientStop x:Name="MarqueeBottomB" Color="#5F00D4FF" Offset="-0.12"/>
                        <GradientStop x:Name="MarqueeBottomC" Color="#FF4DEBFF" Offset="-0.08"/>
                        <GradientStop x:Name="MarqueeBottomD" Color="#5F00D4FF" Offset="-0.04"/>
                        <GradientStop x:Name="MarqueeBottomE" Color="#0000D4FF" Offset="0.04"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle x:Name="MarqueeLeft" Width="3" Margin="3,3,0,3"
                       VerticalAlignment="Stretch" HorizontalAlignment="Left"
                       RadiusX="2" RadiusY="2" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop x:Name="MarqueeLeftA" Color="#0000D4FF" Offset="-0.2"/>
                        <GradientStop x:Name="MarqueeLeftB" Color="#5F00D4FF" Offset="-0.12"/>
                        <GradientStop x:Name="MarqueeLeftC" Color="#FF4DEBFF" Offset="-0.08"/>
                        <GradientStop x:Name="MarqueeLeftD" Color="#5F00D4FF" Offset="-0.04"/>
                        <GradientStop x:Name="MarqueeLeftE" Color="#0000D4FF" Offset="0.04"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Dashboard Hero Section -->
            <Border x:Name="HeroSectionBorder"
                    MinHeight="420"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="308,82,40,70">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Image x:Name="HeroImage"
                           Source="/Assets/UI/HeroSection.png"
                           Stretch="Fill">
                        <Image.Clip>
                            <RectangleGeometry RadiusX="26" RadiusY="26">
                                <RectangleGeometry.Rect>
                                    <MultiBinding Converter="{StaticResource SizeToRectConverter}">
                                        <Binding ElementName="HeroImage" Path="ActualWidth"/>
                                        <Binding ElementName="HeroImage" Path="ActualHeight"/>
                                    </MultiBinding>
                                </RectangleGeometry.Rect>
                            </RectangleGeometry>
                        </Image.Clip>
                    </Image>

                    <Grid Margin="22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">

                            <Button x:Name="OpenKeyboardOverlayButton"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Width="220"
                                    Height="48"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="36,488,0,0"
                                    AutomationProperties.Name="Open Keyboard"
                                    AutomationProperties.AutomationId="OpenKeyboardButton"
                                    Click="OpenKeyboardWindowButton_Click"
                                    Background="Transparent"
                                    BorderBrush="#00D4FF"
                                    BorderThickness="1"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Root"
                                                CornerRadius="12"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#0000D4FF" BlurRadius="10" ShadowDepth="0" Opacity="0"/>
                                            </Border.Effect>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#2A00D4FF"/>
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#7FDBFF"/>
                                                <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="Root" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00D4FF" BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Border x:Name="OpenKeyboardLedRing"
                                    Width="220"
                                    Height="48"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="36,488,0,0"
                                    CornerRadius="12"
                                    BorderThickness="2"
                                    IsHitTestVisible="False"
                                    SnapsToDevicePixels="True">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RingStopA" Color="#0000D4FF" Offset="1.0"/>
                                        <GradientStop x:Name="RingStopB" Color="#D000D4FF" Offset="0.8"/>
                                        <GradientStop x:Name="RingStopC" Color="#00FF2DAF" Offset="0.6"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <DropShadowEffect Color="#2900D4FF" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard Storyboard="{StaticResource OpenKeyboardLedRingStoryboard}"/>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#9C141E2D"
                                BorderBrush="#2200D4FF"
                                BorderThickness="1"
                                CornerRadius="16"
                                Margin="0,0,8,0"
                                ClipToBounds="True">
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="NavigateSoundLibrary_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border x:Name="HoverGlow" CornerRadius="16" BorderBrush="#00D4FF" BorderThickness="1.5" Opacity="0" IsHitTestVisible="False"/>
                                            <Border x:Name="Bd" CornerRadius="16" Background="Transparent">
                                                <Grid Margin="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="12"
                                                            Background="#1A00D4FF" BorderBrush="#3300D4FF" BorderThickness="1"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                                                   Foreground="#00D4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Browse sounds" Foreground="#F7FAFF" FontSize="14.5" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Search, filter, and jump straight to a sound." Foreground="#8EA2C0" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#5B6C84" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1400D4FF"/>
                                                <Setter TargetName="HoverGlow" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#9C141E2D"
                                BorderBrush="#228B5CF6"
                                BorderThickness="1"
                                CornerRadius="16"
                                Margin="8,0,8,0"
                                ClipToBounds="True">
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="NavigateEffects_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border x:Name="HoverGlow" CornerRadius="16" BorderBrush="#00D4FF" BorderThickness="1.5" Opacity="0" IsHitTestVisible="False"/>
                                            <Border x:Name="Bd" CornerRadius="16" Background="Transparent">
                                                <Grid Margin="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="12"
                                                            Background="#1A00D4FF" BorderBrush="#334A647F" BorderThickness="1"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                                                   Foreground="#00D4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Voice changer" Foreground="#F7FAFF" FontSize="14.5" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Adjust your voice workflow and monitor status." Foreground="#8EA2C0" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#5B6C84" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#148B5CF6"/>
                                                <Setter TargetName="HoverGlow" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#9C141E2D"
                                BorderBrush="#227B3FFF"
                                BorderThickness="1"
                                CornerRadius="16"
                                Margin="8,0,0,0"
                                ClipToBounds="True">
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="NavigateSettings_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border x:Name="HoverGlow" CornerRadius="16" BorderBrush="#7B3FFF" BorderThickness="1.5" Opacity="0" IsHitTestVisible="False"/>
                                            <Border x:Name="Bd" CornerRadius="16" Background="Transparent">
                                                <Grid Margin="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="12"
                                                            Background="#1A7B3FFF" BorderBrush="#337B3FFF" BorderThickness="1"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                                                   Foreground="#7B3FFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Settings" Foreground="#F7FAFF" FontSize="14.5" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Tune devices, routing, and hotkeys when needed." Foreground="#8EA2C0" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#5B6C84" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#147B3FFF"/>
                                                <Setter TargetName="HoverGlow" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            </Border>

            <!-- Effects Page -->
            <Border HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="308,82,40,70">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Effects">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="VOICE CHANGER"
                                       Foreground="#00D4FF"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Route your mic through the live voice pipeline and shape the output with presets, pitch, and formant controls."
                                       Foreground="#A2B4CC"
                                       FontSize="13"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#191B2736"
                                BorderBrush="#3300D4FF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,12"
                                MinWidth="280">
                            <StackPanel>
                                <TextBlock Text="SIGNAL FLOW" Foreground="#00D4FF" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock Text="Microphone → Voice Changer → Output" Foreground="#F7FAFF" FontSize="13.5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="Keep the input and output paths aligned before you start processing." Foreground="#8EA2C0" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Style="{StaticResource SurfaceCardStyle}"
                            Background="#9C141E2D"
                            Padding="20"
                            Margin="0,0,0,14"
                            CornerRadius="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="INPUT DEVICE" Foreground="#00D4FF" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentInputDevice, FallbackValue='No input device selected'}" Foreground="#F7FAFF" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                <TextBlock Text="PROCESSING STATUS" Foreground="#00D4FF" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock x:Name="VoiceChangerSummaryText" Text="Ready to start" Foreground="#22C55E" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="OUTPUT DEVICE" Foreground="#00D4FF" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentOutputDevice, FallbackValue='No output device selected'}" Foreground="#F7FAFF" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#1A192438"
                                BorderBrush="#2F3E58"
                                BorderThickness="1"
                                Padding="20"
                                Margin="0,0,8,0"
                                CornerRadius="18">
                            <StackPanel>
                                <Border Background="#161E31" BorderBrush="#2C476A" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BF;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="PRIMARY CONTROLS" Foreground="#00D4FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Start or stop the real-time pipeline and monitor what your team hears." Foreground="#A1B2D2" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <Button x:Name="VoiceChangerToggleBtn"
                                        Content="Start Voice Changer"
                                        Height="38"
                                        HorizontalAlignment="Left"
                                        Padding="18,0"
                                        Background="{StaticResource AccentBlueBrush}"
                                        BorderBrush="{StaticResource BorderAccentBrush}"
                                        Foreground="White"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        AutomationProperties.Name="Start Voice Changer"/>

                                <Border Margin="0,12,0,0" Background="#1AFFFFFF" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="VoiceChangerStatusDot" Width="8" Height="8" CornerRadius="4" Background="#E85555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="VoiceChangerStatus" Text="Stopped" Foreground="#E85555" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <TextBlock Text="&#xE7C1;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="MONITOR" Foreground="#00D4FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Preview the route your team receives while you talk." Foreground="#A1B2D2" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button x:Name="TeamMonitorToggleBtn"
                                        Content="Hear What People Hear"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        Padding="14,0"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderAccentBrush}"
                                        Foreground="White"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Click="TeamMonitorToggle_Click"
                                        AutomationProperties.Name="Hear What People Hear"/>
                                <Border Margin="0,10,0,0" Background="#1AFFFFFF" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="TeamMonitorStatusDot" Width="8" Height="8" CornerRadius="4" Background="#98A0C0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TeamMonitorStatus" Text="Off" Foreground="#98A0C0" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#1A192438"
                                BorderBrush="#2F3E58"
                                BorderThickness="1"
                                Padding="20"
                                Margin="8,0,0,0"
                                CornerRadius="18">
                            <StackPanel>
                                <Border Background="#161E31" BorderBrush="#2C476A" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="EFFECT CONTROLS" Foreground="#00D4FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Choose a preset, then fine-tune the pitch and formant to match your voice." Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,6"/>

                                <ComboBox x:Name="VoiceChangerPresetCombo"
                                          Height="30"
                                          HorizontalAlignment="Stretch"
                                          Background="#122036"
                                          BorderBrush="#334A647F"
                                          Foreground="White"
                                          FontSize="12"
                                          BorderThickness="1"
                                          Padding="6,1"
                                          Margin="0,0,0,4"
                                          DisplayMemberPath="Name"/>
                                <TextBlock x:Name="PresetSummaryText" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="PITCH" Foreground="#00D4FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Shift voice pitch in semitones." Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="PitchSlider"
                                            Grid.Column="0"
                                            Minimum="-12"
                                            Maximum="12"
                                            SmallChange="0.5"
                                            LargeChange="1"
                                            TickFrequency="2"
                                            TickPlacement="BottomRight"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                                    <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="5" Padding="8,3">
                                        <TextBlock x:Name="PitchValueText" Text="0.0 st" Foreground="White" FontSize="11" FontWeight="Bold" MinWidth="40" TextAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="FORMANT" Foreground="#00D4FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Adjust the voice character without touching pitch." Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="FormantSlider"
                                            Grid.Column="0"
                                            Minimum="0.5"
                                            Maximum="2.0"
                                            SmallChange="0.05"
                                            LargeChange="0.1"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                                    <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="5" Padding="8,3">
                                        <TextBlock x:Name="FormantValueText" Text="1.00x" Foreground="White" FontSize="11" FontWeight="Bold" MinWidth="40" TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Gaming Enhancement Page -->
            <Border HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="308,82,40,70">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Gaming">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:GamingPanel x:Name="GamingPanelControl" DataContext="{Binding Gaming}"/>
            </Border>

            <!-- Library Page (tile grid) — MyBoard design with dark theme -->
                    <Border
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="308,82,40,70">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="SoundLibrary">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SOUND LIBRARY"
                                   Foreground="#00D4FF"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock Grid.Row="1"
                                   Text="Find the sound you need quickly, then trigger, edit, or manage it from one place."
                                   Foreground="#A2B4CC"
                                   FontSize="13"
                                   Margin="0,4,0,0"/>
                    </Grid>

                    <!-- TOOLBAR -->
                    <Border Grid.Row="1" Background="#1A192438" CornerRadius="16" Padding="14,12" Margin="0,0,0,14" BorderBrush="#2F3E58" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" ItemHeight="40">
                                <Button Content="+ Add Sound"
                                        Style="{StaticResource RoundButton}"
                                        Margin="0,0,8,0"
                                        Command="{Binding AddSoundCommand}"/>
                                <Button Content="&#x1F310; URL"
                                        Style="{StaticResource RoundButtonSecondary}"
                                        Margin="0,0,8,0"
                                        Command="{Binding AddSoundFromUrlCommand}"/>
                                <Button Content="&#x1F3A4; Mic"
                                        Style="{StaticResource RoundButtonSecondary}"
                                        Margin="0,0,8,0"
                                        Click="LibraryMicButton_Click"/>
                                <Button Content="&#x1F5D1; Delete"
                                        Style="{StaticResource RoundButtonDanger}"
                                        Command="{Binding DeleteMarkedSoundsCommand}"/>
                            </WrapPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                                <TextBlock Text="LEVEL" Foreground="#8EA2C0" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Slider Width="96" Minimum="5" Maximum="100" Margin="7,0,0,0"
                                        Value="{Binding MasterVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center"
                                        ToolTip="Master volume for all sound playback (percent)"/>
                                <TextBlock Text="{Binding MasterVolumePercent, StringFormat='{}{0:0}%'}"
                                           Foreground="#00D4FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="7,0,0,0"/>
                                <Button Content="&#x2696; Equalize"
                                        Style="{StaticResource RoundButtonSecondary}"
                                        Command="{Binding EqualizeSoundsCommand}"
                                        Margin="10,0,0,0"
                                        ToolTip="Analyze every sound and set each gain so they all play at the same loudness"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#152137" BorderBrush="#2C476A" BorderThickness="1" CornerRadius="999" Padding="12,5" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Sounds.Count, StringFormat='{}{0} sounds'}" Foreground="#DDE7F8" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#152137" BorderBrush="#2C476A" BorderThickness="1" CornerRadius="999" Padding="12,5">
                                    <TextBlock Text="{Binding SoundsView.Count, StringFormat='{}{0} visible'}" Foreground="#8EA2C0" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SEARCH & FILTERS -->
                    <Border Grid.Row="2" Background="#1A192438" CornerRadius="16" BorderBrush="#2F3E58" BorderThickness="1" Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="#0E182A" CornerRadius="12" BorderBrush="#2C476A" BorderThickness="1" Padding="0">
                                <Grid>
                                    <TextBlock Text="&#x1F50D;" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox x:Name="LibrarySearchBox"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="White" FontSize="12" CaretBrush="White"
                                             VerticalAlignment="Center"
                                             Margin="30,0,8,0">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Text="Search sounds..." Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                               VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <ComboBox Grid.Column="1"
                                      Width="180"
                                      Margin="12,0,0,0"
                                      ItemsSource="{Binding Categories}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Name"
                                      SelectedValue="{Binding SelectedCategoryFilter, Mode=TwoWay}"/>

                            <CheckBox Grid.Column="2"
                                      Margin="12,0,0,0"
                                      Content="Favorites only"
                                      Foreground="#DDE7F8"
                                      IsChecked="{Binding FavoritesOnly, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- TILES - MyBoard 3D keycap style -->
                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent"
                                  BorderThickness="0">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="9"/>
                                <Setter Property="Background" Value="#0A1424"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Background="#0A1424">
                                                <Track x:Name="PART_Track"
                                                       VerticalAlignment="Stretch"
                                                       IsDirectionReversed="True">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                                    </Track.IncreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb>
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border CornerRadius="4"
                                                                            Background="#228B5CF6"
                                                                            BorderBrush="#00D4FF"
                                                                            BorderThickness="1"
                                                                            Margin="1,2"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Resources>

                        <ItemsControl ItemsSource="{Binding SoundsView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SoundTileButton}"
                                            Command="{Binding DataContext.PlaySoundCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <!-- image only inside the inner section, clipped to the smooth rounded corners -->
                                            <Border CornerRadius="11" ClipToBounds="True">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#14000000"/>
                                                </Border.Background>
                                                <Grid>
                                                    <Image x:Name="TileImage" Source="{Binding ImagePath}"
                                                           Stretch="UniformToFill"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                        <Image.Clip>
                                                            <RectangleGeometry RadiusX="11" RadiusY="11">
                                                                <RectangleGeometry.Rect>
                                                                    <MultiBinding Converter="{StaticResource SizeToRectConverter}">
                                                                        <Binding ElementName="TileImage" Path="ActualWidth"/>
                                                                        <Binding ElementName="TileImage" Path="ActualHeight"/>
                                                                    </MultiBinding>
                                                                </RectangleGeometry.Rect>
                                                            </RectangleGeometry>
                                                        </Image.Clip>
                                                    </Image>

                                                    <!-- icon fallback when no image -->
                                                    <TextBlock Text="&#x266B;" FontSize="34" Foreground="#28364F"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <!-- overlay: name + key badge -->
                                            <Grid Margin="12,10,12,12" VerticalAlignment="Stretch">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="White"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="32"
                                                               TextTrimming="CharacterEllipsis"
                                                               LineHeight="14">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1" Opacity="0.9"/>
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Category}"
                                                               Foreground="#9CEBFF"
                                                               FontSize="10.5"
                                                               Margin="0,2,0,0">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.9"/>
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Border Grid.Row="2"
                                                        CornerRadius="7"
                                                        Padding="8,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom"
                                                        Background="#B3141E2D"
                                                        BorderBrush="#00D4FF"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding AssignedKeyLabel, TargetNullValue='+ key'}" Foreground="#DDEAFF" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <Button.ContextMenu>
                                            <ContextMenu Background="#1A1A2E"
                                                         BorderBrush="#2A2A4E"
                                                         BorderThickness="1"
                                                         Foreground="White"
                                                         FontSize="12"
                                                         HasDropShadow="True">
                                                <ContextMenu.Resources>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Background" Value="#1A1A2E"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#2A2A4E"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="12,6"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter Property="Background" Value="#282850"/>
                                                                <Setter Property="BorderBrush" Value="#3535D0"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style TargetType="Separator">
                                                        <Setter Property="Background" Value="#2A2A4E"/>
                                                        <Setter Property="Margin" Value="6,2"/>
                                                        <Setter Property="Height" Value="1"/>
                                                    </Style>
                                                </ContextMenu.Resources>
                                                <MenuItem Header="&#x25B6; Play" Click="SoundTileMenu_Play"/>
                                                <MenuItem Header="&#x270E; Edit" Click="SoundTileMenu_Edit"/>
                                                <MenuItem Header="&#x1F4CC; Assign to Key" Click="SoundTileMenu_Assign"/>
                                                <Separator/>
                                                <MenuItem Header="&#x1F4CE; Duplicate" Click="SoundTileMenu_Duplicate"/>
                                                <MenuItem Header="&#x2B50; Toggle Favorite" Click="SoundTileMenu_Favorite"/>
                                                <Separator/>
                                                <MenuItem Header="&#x1F5BC; Choose Image" Click="SoundTileMenu_ChooseImage"/>
                                                <MenuItem Header="&#x274C; Remove Image" Click="SoundTileMenu_RemoveImage"/>
                                                <MenuItem Header="&#x1F511; Remove Binding" Click="SoundTileMenu_ClearBinding"/>
                                                <Separator/>
                                                <MenuItem Header="&#x1F5D1; Delete" Foreground="#F43F5E" Click="SoundTileMenu_Delete"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Settings Page -->
                        <Border
                        HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                        Margin="308,82,40,70">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ═══ SETTINGS SECTION RAIL ═══ -->
                        <Border Grid.Column="0" Background="#8C0C1424" BorderBrush="#1B3157"
                                BorderThickness="1" CornerRadius="18" Margin="14,14,8,14">
                            <StackPanel Margin="12">
                                <TextBlock Text="SETTINGS"
                                           Foreground="#00D4FF"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="10,8,0,14"/>
                                <TextBlock Text="Tune audio routing, hotkeys and general behavior."
                                           Foreground="#9CB0CB" FontSize="12.5" TextWrapping="Wrap" Margin="10,0,6,14"/>

                                <Button x:Name="SettingsSectionGeneralButton" Tag="General" Click="SettingsSectionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSectionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="General">
                                                    <Setter Property="Background" Value="#2A00D4FF"/>
                                                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="26" VerticalAlignment="Center"/>
                                        <TextBlock Text="General" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="SettingsSectionAudioButton" Tag="Audio" Click="SettingsSectionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSectionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Audio">
                                                    <Setter Property="Background" Value="#2A00D4FF"/>
                                                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="26" VerticalAlignment="Center"/>
                                        <TextBlock Text="Audio" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="SettingsSectionKeybindsButton" Tag="Keybinds" Click="SettingsSectionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSectionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Keybinds">
                                                    <Setter Property="Background" Value="#2A00D4FF"/>
                                                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="26" VerticalAlignment="Center"/>
                                        <TextBlock Text="Keybinds" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="SettingsSectionToolsButton" Tag="Tools" Click="SettingsSectionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSectionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Tools">
                                                    <Setter Property="Background" Value="#2A00D4FF"/>
                                                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7C4;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="26" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tools" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- ═══ SETTINGS CONTENT ═══ -->
                        <Border Grid.Column="1" Background="#8C0C1424" BorderBrush="#1B3157"
                            BorderThickness="1" CornerRadius="18" Margin="8,14,14,14">
                            <Grid>

                                <!-- ══ GENERAL ══ -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="General">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Margin="24">
                                        <TextBlock x:Name="SettingsGeneralHeader"
                                                   Text="GENERAL" Foreground="#00D4FF" FontSize="16" FontWeight="Bold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Foreground="#7F899C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"
                                                   Text="Startup and app behavior."/>

                                        <Border Background="#B4141E2D" BorderBrush="#334A647F" BorderThickness="1"
                                            CornerRadius="12" Padding="18,16">
                                            <StackPanel>
                                                <CheckBox x:Name="ShowWizardOnStartupCheck"
                                                          Content="Show setup wizard on startup"
                                                          IsChecked="{Binding Settings.ShowSetupWizardOnStartup, Mode=TwoWay}"
                                                          Foreground="#DDEAFF" FontSize="12" Margin="0,0,0,10"/>
                                                <CheckBox x:Name="StartMinimizedCheck"
                                                          Content="Start minimized to tray"
                                                          IsChecked="{Binding Settings.StartMinimized, Mode=TwoWay}"
                                                          Foreground="#DDEAFF" FontSize="12"/>
                                                <TextBlock Foreground="#7F899C" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                                                           Text="Device selection, routing and reset live in the Setup Wizard."/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#B4141E2D" BorderBrush="#334A647F" BorderThickness="1"
                                            CornerRadius="12" Padding="18,16" Margin="0,12,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Keyboard window size" Foreground="#DDEAFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding KeyboardWindowScale, StringFormat='{}{0:P0}', ConverterCulture=en-US}"
