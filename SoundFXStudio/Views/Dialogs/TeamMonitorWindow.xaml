<Window x:Class="SoundFXStudio.Views.Dialogs.TeamMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hear what others hear"
        Width="560" Height="700"
        WindowStyle="None"
        Background="#08091F"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Closed="Window_Closed"
        SourceInitialized="Window_SourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource AppWindowRoot}"
            CornerRadius="18"
            BorderThickness="1.5">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
                <Border Grid.Row="0" Background="#141E2D" CornerRadius="18,18,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Hear what others hear" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Background="#1A00D4FF" CornerRadius="6" Padding="8,3" Margin="12,0,0,0"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <TextBlock Text="B1 monitor" Foreground="#8891B8" FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="Done_Click" Cursor="Hand" Height="30">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                                    <Path Data="M 8 8 L 22 22 M 22 8 L 8 22" Stroke="#8891B8"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E8F43F5E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
                <StackPanel Grid.Row="1" Margin="24,22,24,10">
                <TextBlock Text="This plays back the EXACT mix your mic sends to Discord (VoiceMeeter B1) — your voice + all your soundboard/app audio — through your speakers or headphones."
                           Foreground="#C7CEEA" FontSize="12.5" TextWrapping="Wrap" LineHeight="20"/>

                    <Border Background="#1400D4FF" CornerRadius="10" Padding="12,9" Margin="0,12,0,0" BorderBrush="#3300D4FF" BorderThickness="1">
                    <TextBlock Text="Tip: use headphones so your mic doesn't pick the monitor up and create an echo."
                               Foreground="#8891B8" FontSize="11" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="What to hear" Foreground="#8891B8" FontSize="11" FontWeight="Bold" Margin="0,18,0,6"/>
                <ComboBox x:Name="ModeCombo" Height="34"
                          Background="#44111A2E" BorderBrush="#5A00D4FF"
                          Foreground="White" FontSize="12"
                          SelectionChanged="ModeCombo_SelectionChanged"/>

                <TextBlock Text="Monitor from (mic mix — VoiceMeeter B1)" Foreground="#8891B8" FontSize="11" FontWeight="Bold" Margin="0,14,0,4"/>
                <ComboBox x:Name="CaptureCombo" Height="32" DisplayMemberPath="Name"
                          Background="#44111A2E" BorderBrush="#5A00D4FF" Foreground="White" FontSize="12"/>

                <TextBlock Text="Play through" Foreground="#8891B8" FontSize="11" FontWeight="Bold" Margin="0,12,0,4"/>
                <ComboBox x:Name="PlaybackCombo" Height="32" DisplayMemberPath="Name"
                          Background="#44111A2E" BorderBrush="#5A00D4FF" Foreground="White" FontSize="12"/>

                <TextBlock Text="Volume" Foreground="#8891B8" FontSize="11" FontWeight="Bold" Margin="0,14,0,4"/>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.8"
                        VerticalAlignment="Center"
                        ValueChanged="VolumeSlider_ValueChanged"/>

                <TextBlock x:Name="MonitorStatus" Margin="0,18,0,0"
                           Foreground="#10B981" FontSize="11.5" TextWrapping="Wrap"
                           FontFamily="Consolas"/>
            </StackPanel>

            <!-- Footer -->
                <Border Grid.Row="2" Background="#101722" CornerRadius="0,0,18,18" BorderBrush="#26394F" BorderThickness="1,1,1,0">
                <Grid Margin="20,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DevicesText" Grid.Row="0" Foreground="#8891B8" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="CloseBtn" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Content="Close" Click="Done_Click" Cursor="Hand" Height="42"
                                Margin="0,0,10,0"
                                Background="#1F13233A" BorderBrush="#3A5A8A" Foreground="#9AAFD0"
                                FontWeight="SemiBold" FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="10"
                                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#442A2A66"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#00D4FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="StartBtn" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Content="Start" Click="StartStop_Click" Cursor="Hand" Height="42"
                                FontWeight="SemiBold" FontSize="13" Foreground="White">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="10"
                                            Background="#222A2A66" BorderBrush="#5A00D4FF" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#442A2A66"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#00D4FF"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#11222233"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#33555A7A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
