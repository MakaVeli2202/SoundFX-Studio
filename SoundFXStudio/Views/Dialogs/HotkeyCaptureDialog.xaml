<Window x:Class="SoundFXStudio.Views.Dialogs.HotkeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture Hotkey"
        Width="460"
        Height="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Storyboard x:Key="ListeningPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="KeyDisplayBorder" Storyboard.TargetProperty="Opacity" From="0.9" To="1" Duration="0:0:1.2"/>
            <DoubleAnimation Storyboard.TargetName="CapturedKeyText" Storyboard.TargetProperty="Opacity" From="0.84" To="1" Duration="0:0:1.2"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="28" ClipToBounds="True" BorderThickness="1.5">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00D4FF" Offset="0"/>
                <GradientStop Color="#7B3FFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="0" Color="#3B00D4FF" Opacity="0.55"/>
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" CornerRadius="22" Background="#C1141E2D" BorderBrush="#334A647F" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Image Source="/Assets/UI/MainDashboardLogo.png" Height="40" Stretch="Uniform"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="SOUNDFX STUDIO" Foreground="#00D4FF" FontWeight="Bold"/>
                            <TextBlock Text="Capture Hotkey" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="CancelButton" Height="36" Content="&#x2715;"
                            Background="#40212A39" BorderBrush="#00D4FF" Foreground="White"
                            HorizontalAlignment="Right" Margin="0,8,8,8"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <Border Grid.Row="1" CornerRadius="22" Background="#C1141E2D" BorderBrush="#334A647F" BorderThickness="1" Margin="0,12,0,12">
                <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="InstructionText" Text="Press a key combination to assign..." FontSize="14" Foreground="#A1B2D2"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <Border x:Name="KeyDisplayBorder" Background="#1C0F1826" BorderBrush="#7000D4FF" BorderThickness="1.5" CornerRadius="18" Padding="30,18" MinHeight="118" MinWidth="360" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#3600D4FF" BlurRadius="14" ShadowDepth="0" Opacity="0.44"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ModifierText" Text="" FontSize="15" Foreground="#7B3FFF"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock x:Name="CapturedKeyText" Text="Listening..." FontSize="34" FontWeight="Black" Foreground="#00D4FF"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="330"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ChordHintText" Text="" FontSize="12" Foreground="#94A8C8"
                               HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- FOOTER -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="SaveButton" Content="Save" Margin="0,0,10,0" IsDefault="True"
                        IsEnabled="False" Click="SaveButton_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00D4FF" Offset="0"/>
                            <GradientStop Color="#7B3FFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="14"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="ClearButton" Content="Clear" Margin="0,0,10,0" IsEnabled="False" Click="ClearButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Foreground" Value="#DDEAFF"/>
                            <Setter Property="Background" Value="#1F13233A"/>
                            <Setter Property="BorderBrush" Value="#4A00D4FF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="14"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D4FF"/>
                                                <Setter TargetName="Bd" Property="Background" Value="#2A00D4FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Cancel" IsCancel="True" Click="CancelButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Foreground" Value="#DDEAFF"/>
                            <Setter Property="Background" Value="#1F13233A"/>
                            <Setter Property="BorderBrush" Value="#4A00D4FF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="14"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D4FF"/>
                                                <Setter TargetName="Bd" Property="Background" Value="#2A00D4FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource ListeningPulse}"/>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</Window>
