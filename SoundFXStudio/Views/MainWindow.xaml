<Window x:Class="SoundFXStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundFXStudio.Controls"
        xmlns:converters="clr-namespace:SoundFXStudio.Converters"
        xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore"
        Title="SoundFX Studio"
        Icon="/Assets/SoundFXStudioLogo.png"
        Width="1366"
        Height="900"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="#CC111A2A"/>
            <Setter Property="BorderBrush" Value="#33476684"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>



        <Style x:Key="HeroOverlayButton"
       TargetType="Button">

            <Setter Property="Background"
            Value="Transparent"/>

            <Setter Property="BorderThickness"
            Value="0"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="HoverBorder"
                        CornerRadius="14"
                        Background="#33081428"
                        BorderBrush="#5508A0F0"
                        BorderThickness="1">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="HoverBorder"
                                Property="Background"
                                Value="#558B5CF6"/>

                                <Setter TargetName="HoverBorder"
                                Property="BorderBrush"
                                Value="#AAFFFF"/>

                                <Setter TargetName="HoverBorder"
                                Property="BorderThickness"
                                Value="1"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter TargetName="HoverBorder"
                                Property="Background"
                                Value="#888B5CF6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ═══ MyBoard-Style Button Templates ═══ -->

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2AB8FF" Offset="0"/>
            <GradientStop Color="#377DFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradientHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#57D4FF" Offset="0"/>
            <GradientStop Color="#599BFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F43F5E" Offset="0"/>
            <GradientStop Color="#E11D48" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="{StaticResource PrimaryGradient}">
                            <Border.Effect>
                                <effects:DropShadowEffect Color="#8B5CF6" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryGradientHover}"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#8B5CF6" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8822AA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundButtonSecondary" TargetType="Button">
            <Setter Property="Foreground" Value="#DDEAFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#14FFFFFF" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderBrush="#558B5CF6" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#228B5CF6"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8B5CF6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#338B5CF6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundButtonDanger" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="{StaticResource DangerGradient}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#F43F5E" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Settings Panel Button ═══ -->
        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDEAFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#1A2A2A66"/>
            <Setter Property="BorderBrush" Value="#558B5CF6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                         <ControlTemplate.Triggers>
                             <Trigger Property="IsMouseOver" Value="True">
                                 <Setter TargetName="Bd" Property="Background" Value="#228B5CF6"/>
                                 <Setter TargetName="Bd" Property="BorderBrush" Value="#8B5CF6"/>
                                 <Setter TargetName="Bd" Property="Effect">
                                     <Setter.Value>
                                         <effects:DropShadowEffect Color="#8B5CF6" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                     </Setter.Value>
                                 </Setter>
                             </Trigger>
                             <Trigger Property="IsPressed" Value="True">
                                 <Setter TargetName="Bd" Property="Background" Value="#338B5CF6"/>
                                 <Setter TargetName="Bd" Property="BorderBrush" Value="#7C3AED"/>
                             </Trigger>
                         </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Sidebar Navigation Button ═══ -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#8F9DB5"/>
            <Setter Property="Background" Value="#0C1424"/>
            <Setter Property="BorderBrush" Value="#1B3157"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16223D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2F4A78"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2E52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Settings Section Nav Button ═══ -->
        <Style x:Key="SettingsSectionButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ═══ MyBoard 3D Keycap Tile Style ═══ -->
        <Style x:Key="SoundTileButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="118"/>
            <Setter Property="Height" Value="118"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Skirt" CornerRadius="16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#252A4E" Offset="0"/>
                                        <GradientStop Color="#141838" Offset="0.5"/>
                                        <GradientStop Color="#0A0E20" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <effects:DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.55"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Face" Margin="4,4,4,10" CornerRadius="13" BorderBrush="#2AFFFFFF" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1E2448" Offset="0"/>
                                        <GradientStop Color="#141838" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <ContentPresenter x:Name="TileContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    <Border VerticalAlignment="Top" Height="22" Margin="2,1,2,0" CornerRadius="12,12,0,0" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#18FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#803535D0"/>
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#282E58" Offset="0"/>
                                            <GradientStop Color="#1C2248" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Skirt" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#3535D0" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.13"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.13"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Margin" Value="4,9,4,5"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#8B5CF6"/>
                                <Setter TargetName="Skirt" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#8B5CF6" BlurRadius="26" ShadowDepth="0" Opacity="0.7"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="8,0,8,8"
        CornerRadius="16"
        Background="#0A111C">

        <Border.Effect>
            <DropShadowEffect BlurRadius="50"
                          ShadowDepth="0"
                          Color="#000000"
                          Opacity="0.6"/>
        </Border.Effect>

        <Border.BorderBrush>

            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,0">

                <GradientStop Color="#2AB8FF"
                              Offset="0"/>

                <GradientStop Color="#377DFF"
                              Offset="1"/>

            </LinearGradientBrush>

        </Border.BorderBrush>

        <Border.BorderThickness>2</Border.BorderThickness>

        <Grid>

            <!-- Dashboard Skin removed for modern clean shell -->
                 <Image Source="/Assets/UI/MainWindowBackground.png"
                     Stretch="Fill"
                     Margin="0,44,0,0"
                     Visibility="Collapsed"/>

            <!-- Dashboard Logo -->


                <Image Source="/Assets/UI/MainDashboardLogo.png"
                   Width="250"
                   Height="110"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                    Margin="35,70,0,0"
                   Visibility="Collapsed">
            </Image>

            <!-- Dashboard Hero Section -->
                <Border x:Name="HeroSectionBorder"
                    Height="520"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="300,70,35,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Border Margin="16" CornerRadius="14" ClipToBounds="True">
                        <Grid>
                            <Image Source="/Assets/UI/HeroSection.png" Stretch="Fill"/>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#CC0C1321" Offset="0"/>
                                        <GradientStop Color="#660C1321" Offset="0.55"/>
                                        <GradientStop Color="#220C1321" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="56,0,0,0" MaxWidth="460">
                        <TextBlock Text="SOUNDBOARD" Foreground="#97B6D5" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="Fast trigger control"
                                   Foreground="#EAF1FF"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Same hero feel, cleaner layout and better spacing."
                                   Foreground="#B7C7DD"
                                   FontSize="14"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                        <Button x:Name="OpenKeyboardOverlayButton"
                                Style="{StaticResource RoundButton}"
                                Width="206"
                                Height="42"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"
                                AutomationProperties.Name="Open Keyboard"
                                AutomationProperties.AutomationId="OpenKeyboardButton"
                                Click="OpenKeyboardWindowButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#EAF1FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Open Keyboard" FontSize="13.5" FontWeight="SemiBold" Foreground="#EAF1FF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Effects Page -->
                    <Border Height="700"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="300,70,35,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Effects">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="VOICE CHANGER" Foreground="#8B5CF6" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Real-time mic effects. Pick your mic in Settings, then start here."
                                       Foreground="#7F899C" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: MASTER CARD -->
                        <Border Grid.Column="0" Background="#66081428" BorderBrush="#558B5CF6" BorderThickness="1"
                                CornerRadius="14" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="MASTER" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Turn the voice changer on or off. It routes your microphone through SoundFX in real time."
                                           Foreground="#A1B2D2" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <Button x:Name="VoiceChangerToggleBtn"
                                        Content="Start Voice Changer"
                                        Height="38" HorizontalAlignment="Left" Padding="18,0"
                                        Background="#222A2A66" BorderBrush="#558B5CF6" Foreground="White"
                                        BorderThickness="1" Cursor="Hand" FontSize="12" FontWeight="SemiBold"/>
                                <Border Margin="0,12,0,0" Background="#1AFFFFFF" CornerRadius="5" Padding="10,4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="VoiceChangerStatusDot" Width="8" Height="8" CornerRadius="4" Background="#E85555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="VoiceChangerStatus" Text="Stopped"
                                                   Foreground="#E85555" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <TextBlock Text="&#xE7C1;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="MONITOR" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Hear exactly what your mic sends to Discord (VoiceMeeter B1) while you talk."
                                           Foreground="#A1B2D2" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button x:Name="TeamMonitorToggleBtn"
                                        Content="Hear What People Hear"
                                        Height="34" HorizontalAlignment="Left" Padding="14,0"
                                        Background="#222A2A66" BorderBrush="#558B5CF6" Foreground="White"
                                        BorderThickness="1" Cursor="Hand" FontSize="11.5" FontWeight="SemiBold"
                                        Click="TeamMonitorToggle_Click"/>
                                <Border Margin="0,10,0,0" Background="#1AFFFFFF" CornerRadius="5" Padding="10,4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="TeamMonitorStatusDot" Width="8" Height="8" CornerRadius="4" Background="#98A0C0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TeamMonitorStatus" Text="Off"
                                                   Foreground="#98A0C0" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- RIGHT: CONTROLS CARD -->
                        <Border Grid.Column="1" Background="#66081428" BorderBrush="#558B5CF6" BorderThickness="1"
                                CornerRadius="14" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="PRESET" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Starting point for pitch and formant." Foreground="#A1B2D2" FontSize="10.5" Margin="0,0,0,6"/>
                                <ComboBox x:Name="VoiceChangerPresetCombo" Height="30" HorizontalAlignment="Stretch"
                                          Background="#44111A2E" BorderBrush="#558B5CF6" Foreground="White" FontSize="12"
                                          BorderThickness="1" Padding="6,1" Margin="0,0,0,4"
                                          DisplayMemberPath="Name"/>
                                <TextBlock x:Name="PresetSummaryText" Foreground="#A1B2D2" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="PITCH" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Shift your voice up or down in semitones." Foreground="#A1B2D2" FontSize="10.5" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="PitchSlider" Grid.Column="0"
                                            Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="1"
                                            TickFrequency="2" TickPlacement="BottomRight"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="5" Padding="8,3">
                                        <TextBlock x:Name="PitchValueText" Text="0.0 st"
                                                   Foreground="White" FontSize="11" FontWeight="Bold"
                                                   MinWidth="40" TextAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="FORMANT" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Change voice character without pitch." Foreground="#A1B2D2" FontSize="10.5" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="FormantSlider" Grid.Column="0"
                                            Minimum="0.5" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="5" Padding="8,3">
                                        <TextBlock x:Name="FormantValueText" Text="1.00x"
                                                   Foreground="White" FontSize="11" FontWeight="Bold"
                                                   MinWidth="40" TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Library Page (tile grid) — MyBoard design with dark theme -->
                    <Border Height="700"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="300,70,35,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="SoundLibrary">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <TextBlock Text="LIBRARY"
                               Foreground="#8B5CF6"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <!-- TOOLBAR - MyBoard style -->
                    <Border Grid.Row="1" Background="#0AFFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" ItemHeight="36">
                                <Button Content="+ Add Sound"
                                        Style="{StaticResource RoundButton}"
                                        Command="{Binding AddSoundCommand}"/>
                                <Button Content="&#x1F310; URL"
                                        Style="{StaticResource RoundButtonSecondary}"
                                        Command="{Binding AddSoundFromUrlCommand}"/>
                                <Button Content="&#x1F3A4; Mic"
                                        Style="{StaticResource RoundButtonSecondary}"
                                        Click="LibraryMicButton_Click"/>
                                <Button Content="&#x1F5D1; Delete"
                                        Style="{StaticResource RoundButtonDanger}"
                                        Command="{Binding DeleteMarkedSoundsCommand}"/>
                                </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- SEARCH - MyBoard style -->
                    <Border Grid.Row="2" Background="#14FFFFFF" CornerRadius="10" BorderBrush="#338B5CF6" BorderThickness="1" Height="34" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="&#x1F50D;" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#8891B8"/>
                            <TextBox x:Name="LibrarySearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="White" FontSize="12" CaretBrush="White"
                                     VerticalAlignment="Center"
                                     Margin="30,0,8,0">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock Text="Search sounds..." Foreground="#5A6488" FontSize="12"
                                       VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- TILES - MyBoard 3D keycap style -->
                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="4,0,4,0">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollViewer">
                                            <Grid>
                                                <ScrollContentPresenter Margin="0,0,6,0"/>
                                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                                           Value="{TemplateBinding VerticalOffset}"
                                                           Maximum="{TemplateBinding ScrollableHeight}"
                                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                           Background="#0A1424"
                                                           BorderBrush="#1B3157"
                                                           BorderThickness="1"
                                                           Width="8"
                                                           Cursor="Hand">
                                                    <ScrollBar.Template>
                                                        <ControlTemplate TargetType="ScrollBar">
                                                            <Grid>
                                                                <Track x:Name="PART_Track">
                                                                    <Track.Thumb>
                                                                        <Thumb BorderBrush="#8B5CF6" Background="#228B5CF6" BorderThickness="1">
                                                                            <Thumb.Template>
                                                                                <ControlTemplate TargetType="Thumb">
                                                                                    <Border CornerRadius="4" Background="#228B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" Margin="0,1"/>
                                                                                </ControlTemplate>
                                                                            </Thumb.Template>
                                                                        </Thumb>
                                                                    </Track.Thumb>
                                                                </Track>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </ScrollBar.Template>
                                                </ScrollBar>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Style>

                        <ItemsControl ItemsSource="{Binding SoundsView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SoundTileButton}"
                                            Command="{Binding DataContext.EditSoundCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <!-- Image area -->
                                            <Border CornerRadius="12" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding ImagePath}"
                                                           Stretch="UniformToFill"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <!-- icon fallback when no image -->
                                                    <TextBlock Text="&#x266B;" FontSize="28" Foreground="#334466"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding ImagePath, TargetNullValue=Visible, FallbackValue=Collapsed}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border Background="#44000000"/>
                                                </Grid>
                                            </Border>

                                            <!-- overlay: name + key badge -->
                                            <Grid Margin="8,6,8,7" VerticalAlignment="Stretch">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="30"
                                                           TextTrimming="CharacterEllipsis"
                                                           LineHeight="13"
                                                           VerticalAlignment="Top"
                                                           Margin="0,0,4,0">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.9"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>

                                                <Border Grid.Row="2"
                                                        CornerRadius="5"
                                                        Padding="6,2,6,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom"
                                                        Background="#558891B8">
                                                    <TextBlock Text="{Binding AssignedKeyLabel, TargetNullValue='+ key'}"
                                                               Foreground="White"
                                                               FontSize="11"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <Button.ContextMenu>
                                            <ContextMenu Background="#1A1A2E"
                                                         BorderBrush="#2A2A4E"
                                                         BorderThickness="1"
                                                         Foreground="White"
                                                         FontSize="12"
                                                         HasDropShadow="True">
                                                <ContextMenu.Resources>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Background" Value="#1A1A2E"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#2A2A4E"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="12,6"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter Property="Background" Value="#282850"/>
                                                                <Setter Property="BorderBrush" Value="#3535D0"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style TargetType="Separator">
                                                        <Setter Property="Background" Value="#2A2A4E"/>
                                                        <Setter Property="Margin" Value="6,2"/>
                                                        <Setter Property="Height" Value="1"/>
                                                    </Style>
                                                </ContextMenu.Resources>
                                                <MenuItem Header="&#x25B6; Play" Click="SoundTileMenu_Play"/>
                                                <MenuItem Header="&#x270E; Edit" Click="SoundTileMenu_Edit"/>
                                                <MenuItem Header="&#x1F4CC; Assign to Key" Click="SoundTileMenu_Assign"/>
                                                <Separator/>
                                                <MenuItem Header="&#x1F4CE; Duplicate" Click="SoundTileMenu_Duplicate"/>
                                                <MenuItem Header="&#x2B50; Toggle Favorite" Click="SoundTileMenu_Favorite"/>
                                                <Separator/>
                                                <MenuItem Header="&#x1F5BC; Choose Image" Click="SoundTileMenu_ChooseImage"/>
                                                <MenuItem Header="&#x274C; Remove Image" Click="SoundTileMenu_RemoveImage"/>
                                                <MenuItem Header="&#x1F511; Remove Binding" Click="SoundTileMenu_ClearBinding"/>
                                                <Separator/>
                                                <MenuItem Header="&#x1F5D1; Delete" Foreground="#F43F5E" Click="SoundTileMenu_Delete"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Settings Page -->
                        <Border Height="700"
                        HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                        Margin="300,70,35,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ═══ SETTINGS SECTION RAIL ═══ -->
                        <Border Grid.Column="0" Background="#0C1424" BorderBrush="#1B3157"
                                BorderThickness="1" CornerRadius="14" Margin="12,12,6,12">
                            <StackPanel Margin="12">
                                <TextBlock Text="SETTINGS"
                                           Foreground="#8B5CF6"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="8,4,0,12"/>
                                <TextBlock Text="Tune audio routing, hotkeys and general behavior."
                                           Foreground="#7F899C" FontSize="12" TextWrapping="Wrap" Margin="8,0,4,12"/>

                                <Button x:Name="SettingsSectionGeneralButton" Tag="General" Click="SettingsSectionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSectionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="General">
                                                    <Setter Property="Background" Value="#228B5CF6"/>
                                                    <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="26" VerticalAlignment="Center"/>
                                        <TextBlock Text="General" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="SettingsSectionAudioButton" Tag="Audio" Click="SettingsSectionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSectionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Audio">
                                                    <Setter Property="Background" Value="#228B5CF6"/>
                                                    <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="26" VerticalAlignment="Center"/>
                                        <TextBlock Text="Audio" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

