<UserControl x:Class="SoundFXStudio.Controls.KeyboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SoundFXStudio.Controls"
             xmlns:converters="clr-namespace:SoundFXStudio.Converters"
             xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore"
             Background="Transparent"
             Width="1512.6"
             Height="608"
             ClipToBounds="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:KeyboardLabelForegroundConverter x:Key="KeyboardLabelForegroundConverter" />
        <converters:InnerSectionMarginConverter x:Key="InnerSectionMarginConverter" />
        <converters:SizeToRectConverter x:Key="SizeToRectConverter" />
        <converters:LedReflectionBrushConverter x:Key="LedReflectionBrushConverter" />
        <converters:LedReflectionWidthConverter x:Key="LedReflectionWidthConverter" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F5F7FB" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <Border x:Name="Frame"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Opacity="1" />

                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Margin="0"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="Transparent"
            CornerRadius="0"
            BorderBrush="Transparent"
            BorderThickness="0"
            Padding="0">
                 <Grid Width="1536" Height="1024" Margin="-12.31,-179.69,0,0">
                     <Image Source="/Assets/Keyboards/SoundFXKeyBoard.png"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" />

                          <Canvas Width="1536"
                            Height="1024"
                            IsHitTestVisible="False"
                            Panel.ZIndex="50">
                           <Grid Width="{Binding DataContext.CapsLockIndicatorSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Canvas.Left="{Binding DataContext.CapsLockIndicatorOffsetX, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Canvas.Top="{Binding DataContext.CapsLockIndicatorOffsetY, RelativeSource={RelativeSource AncestorType=UserControl}}">
                               <Grid.RowDefinitions>
                                   <RowDefinition/>
                                   <RowDefinition Height="Auto"/>
                               </Grid.RowDefinitions>
                               <Grid Grid.Row="0"
                                     Width="{Binding DataContext.CapsLockIndicatorSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Height="{Binding DataContext.CapsLockIndicatorSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                   <Image Source="/Assets/Keyboards/LEDOFF.png" Opacity="1">
                                       <Image.Style>
                                           <Style TargetType="Image">
                                               <Setter Property="Visibility" Value="Visible"/>
                                               <Style.Triggers>
                                                   <DataTrigger Binding="{Binding IsCapsLockOn, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                       <Setter Property="Visibility" Value="Collapsed"/>
                                                   </DataTrigger>
                                               </Style.Triggers>
                                           </Style>
                                       </Image.Style>
                                   </Image>
                                   <Image Source="/Assets/Keyboards/LEDON.png" Opacity="1">
                                       <Image.Style>
                                           <Style TargetType="Image">
                                               <Setter Property="Visibility" Value="Collapsed"/>
                                               <Style.Triggers>
                                                   <DataTrigger Binding="{Binding IsCapsLockOn, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                       <Setter Property="Visibility" Value="Visible"/>
                                                   </DataTrigger>
                                               </Style.Triggers>
                                           </Style>
                                       </Image.Style>
                                   </Image>
                               </Grid>
                                 <TextBlock Grid.Row="1" Text="CAPS" HorizontalAlignment="Center" Margin="-29,4,-29,0"
                                            Width="70" TextAlignment="Center" TextWrapping="NoWrap"
                                            FontSize="13" FontWeight="Bold" Foreground="#F5F7FB" />
                           </Grid>
                           <Grid Width="{Binding DataContext.NumLockIndicatorSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Canvas.Left="{Binding DataContext.NumLockIndicatorOffsetX, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Canvas.Top="{Binding DataContext.NumLockIndicatorOffsetY, RelativeSource={RelativeSource AncestorType=UserControl}}">
                               <Grid.RowDefinitions>
                                   <RowDefinition/>
                                   <RowDefinition Height="Auto"/>
                               </Grid.RowDefinitions>
                               <Grid Grid.Row="0"
                                     Width="{Binding DataContext.NumLockIndicatorSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Height="{Binding DataContext.NumLockIndicatorSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                   <Image Source="/Assets/Keyboards/LEDOFF.png" Opacity="1">
                                       <Image.Style>
                                           <Style TargetType="Image">
                                               <Setter Property="Visibility" Value="Visible"/>
                                               <Style.Triggers>
                                                   <DataTrigger Binding="{Binding IsNumLockOn, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                       <Setter Property="Visibility" Value="Collapsed"/>
                                                   </DataTrigger>
                                               </Style.Triggers>
                                           </Style>
                                       </Image.Style>
                                   </Image>
                                   <Image Source="/Assets/Keyboards/LEDON.png" Opacity="1">
                                       <Image.Style>
                                           <Style TargetType="Image">
                                               <Setter Property="Visibility" Value="Collapsed"/>
                                               <Style.Triggers>
                                                   <DataTrigger Binding="{Binding IsNumLockOn, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                       <Setter Property="Visibility" Value="Visible"/>
                                                   </DataTrigger>
                                               </Style.Triggers>
                                           </Style>
                                       </Image.Style>
                                   </Image>
                               </Grid>
                                 <TextBlock Grid.Row="1" Text="NUM" HorizontalAlignment="Center" Margin="-29,4,-29,0"
                                            Width="70" TextAlignment="Center" TextWrapping="NoWrap"
                                            FontSize="13" FontWeight="Bold" Foreground="#F5F7FB" />
                           </Grid>
                           <Grid Width="{Binding DataContext.ScrollLockIndicatorSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Canvas.Left="{Binding DataContext.ScrollLockIndicatorOffsetX, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Canvas.Top="{Binding DataContext.ScrollLockIndicatorOffsetY, RelativeSource={RelativeSource AncestorType=UserControl}}">
                               <Grid.RowDefinitions>
                                   <RowDefinition/>
                                   <RowDefinition Height="Auto"/>
                               </Grid.RowDefinitions>
                               <Grid Grid.Row="0"
                                     Width="{Binding DataContext.ScrollLockIndicatorSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Height="{Binding DataContext.ScrollLockIndicatorSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                   <Image Source="/Assets/Keyboards/LEDOFF.png" Opacity="1">
                                       <Image.Style>
                                           <Style TargetType="Image">
                                               <Setter Property="Visibility" Value="Visible"/>
                                               <Style.Triggers>
                                                   <DataTrigger Binding="{Binding IsScrollLockOn, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                       <Setter Property="Visibility" Value="Collapsed"/>
                                                   </DataTrigger>
                                               </Style.Triggers>
                                           </Style>
                                       </Image.Style>
                                   </Image>
                                   <Image Source="/Assets/Keyboards/LEDON.png" Opacity="1">
                                       <Image.Style>
                                           <Style TargetType="Image">
                                               <Setter Property="Visibility" Value="Collapsed"/>
                                               <Style.Triggers>
                                                   <DataTrigger Binding="{Binding IsScrollLockOn, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                       <Setter Property="Visibility" Value="Visible"/>
                                                   </DataTrigger>
                                               </Style.Triggers>
                                           </Style>
                                       </Image.Style>
                                   </Image>
                               </Grid>
                                 <TextBlock Grid.Row="1" Text="SCROLL" HorizontalAlignment="Center" Margin="-29,4,-29,0"
                                            Width="70" TextAlignment="Center" TextWrapping="NoWrap"
                                            FontSize="13" FontWeight="Bold" Foreground="#F5F7FB" />
                           </Grid>
                          </Canvas>

            <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Panel.ZIndex="1">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:KeyboardLayoutPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button AutomationProperties.AutomationId="{Binding Id}"
                            AutomationProperties.Name="{Binding AutomationName}"
                            Command="{Binding KeyClickedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">

                            <Grid>

                                <Border IsHitTestVisible="False"
                                        CornerRadius="9"
                                        Margin="-3"
                                        Panel.ZIndex="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                        <Condition Binding="{Binding ShowSelectionHighlight, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="BorderBrush" Value="#A78BFA"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <Grid Margin="1">
                                    <Border x:Name="FaceSectionBorder"
                                            CornerRadius="7"
                                            Background="Transparent"
                                            ClipToBounds="True">
                                        <Border.Clip>
                                            <RectangleGeometry RadiusX="7" RadiusY="7">
                                                <RectangleGeometry.Rect>
                                                    <MultiBinding Converter="{StaticResource SizeToRectConverter}">
                                                        <Binding ElementName="FaceSectionBorder" Path="ActualWidth" />
                                                        <Binding ElementName="FaceSectionBorder" Path="ActualHeight" />
                                                    </MultiBinding>
                                                </RectangleGeometry.Rect>
                                            </RectangleGeometry>
                                        </Border.Clip>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                            <Condition Binding="{Binding CalibrationSelectionHighlight, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="BorderBrush" Value="#A78BFA"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                            <Condition Binding="{Binding ShowSelectionHighlight, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="BorderBrush" Value="#A78BFA"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Pressed">
                                                        <Setter Property="BorderBrush" Value="{Binding PressHighlightColor}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Margin>
                                            <MultiBinding Converter="{StaticResource InnerSectionMarginConverter}">
                                                <Binding RelativeSource="{RelativeSource AncestorType=Button}" Path="ActualWidth" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=Button}" Path="ActualHeight" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="InnerInsetXPercent" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="InnerInsetYPercent" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="InnerOffsetXPercent" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="InnerOffsetYPercent" />
                                                <Binding Path="InnerInsetAdjustmentPercent" />
                                                <Binding Path="InnerInsetXAdjustmentPercent" />
                                                <Binding Path="InnerInsetYAdjustmentPercent" />
                                                <Binding Path="InnerOffsetXAdjustmentPercent" />
                                                <Binding Path="InnerOffsetYAdjustmentPercent" />
                                            </MultiBinding>
                                        </Border.Margin>

                                        <Grid>
                                            <Border Opacity="0.95"
                                                    SnapsToDevicePixels="True"
                                                    Visibility="{Binding HasAssignment, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding ImagePath}"
                                                                Stretch="UniformToFill"
                                                                AlignmentX="Center"
                                                                AlignmentY="Center" />
                                                </Border.Background>
                                            </Border>

                                            <Grid Margin="4,2,4,2">
                                                <TextBlock Text="{Binding DisplayLabel}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Opacity="1">
                                                    <TextBlock.Foreground>
                                                        <MultiBinding Converter="{StaticResource KeyboardLabelForegroundConverter}">
                                                            <Binding Path="State" />
                                                            <Binding Path="DataContext.Settings.KeyboardPressedTextColor"
                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid VerticalAlignment="Bottom"
                                      Margin="4,0,4,2"
                                      Visibility="{Binding HasAssignment, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                        <TextBlock Text="{Binding BindingDisplayText}"
                                                   Foreground="#FFFFFFFF"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   Margin="2,0,2,0" />
                                    </Viewbox>
                                </Grid>

                                <Border IsHitTestVisible="False"
                                        CornerRadius="9"
                                        Margin="-3"
                                        Panel.ZIndex="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Pressed">
                                                    <Setter Property="BorderBrush" Value="{Binding PressHighlightColor}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                        <Condition Binding="{Binding ShowSelectionHighlight, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="BorderBrush" Value="#A78BFA"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>