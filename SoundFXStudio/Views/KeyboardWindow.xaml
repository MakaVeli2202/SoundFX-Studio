<Window x:Class="SoundFXStudio.Views.KeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundFXStudio.Controls"
        Title="Keyboard"
        Width="1536"
        Height="1024"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="KeyboardWindow_PreviewKeyDown"
        PreviewKeyUp="KeyboardWindow_PreviewKeyUp"
        MouseLeftButtonDown="KeyboardWindow_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="TopBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#AABBCC"/>
            <Setter Property="Background" Value="#1A2A4580"/>
            <Setter Property="BorderBrush" Value="#5580CFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2200D8FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootSurface" Background="Transparent" SizeChanged="RootSurface_SizeChanged">

        <!-- Soundboard status bar -->
        <Border x:Name="SoundboardStatusBar"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                Padding="18,6" CornerRadius="8" BorderThickness="1"
                BorderBrush="#5580CFFF">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1410B981"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.IsSoundboardActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                            <Setter Property="Background" Value="#14F43F5E"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="SoundboardStatusText"
                       Text="{Binding ViewModel.IsSoundboardActiveText, RelativeSource={RelativeSource AncestorType=Window}}"
                       Foreground="{Binding ViewModel.IsSoundboardActiveColor, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="13" FontWeight="Bold"/>
        </Border>

        <Viewbox Stretch="Uniform">
            <controls:KeyboardControl ItemsSource="{Binding ViewModel.KeyboardKeys, RelativeSource={RelativeSource AncestorType=Window}}"
                          DataContext="{Binding ViewModel, RelativeSource={RelativeSource AncestorType=Window}}"
                                      ButtonScale="{Binding PreviewButtonScale, RelativeSource={RelativeSource AncestorType=Window}}"
                                      InnerInsetXPercent="{Binding PreviewInnerInsetXPercent, RelativeSource={RelativeSource AncestorType=Window}}"
                                      InnerInsetYPercent="{Binding PreviewInnerInsetYPercent, RelativeSource={RelativeSource AncestorType=Window}}"
                                      InnerOffsetXPercent="{Binding PreviewInnerOffsetXPercent, RelativeSource={RelativeSource AncestorType=Window}}"
                                      InnerOffsetYPercent="{Binding PreviewInnerOffsetYPercent, RelativeSource={RelativeSource AncestorType=Window}}"
                                       />
        </Viewbox>

        <!-- Top-right controls: scale, close -->
        <StackPanel x:Name="TopControls"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="18">

            <Border Padding="6,5" CornerRadius="8" Background="#1A2A4580" BorderBrush="#5580CFFF" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource TopBtn}" Content="−" FontSize="16" Click="ZoomOutScale_Click"/>
                    <TextBlock x:Name="ScaleDisplay" Text="100%" VerticalAlignment="Center"
                               Width="48" TextAlignment="Center" FontSize="11" Foreground="#AABBCC"
                               FontWeight="SemiBold"/>
                    <Button Style="{StaticResource TopBtn}" Content="+" FontSize="14" Click="ZoomInScale_Click"/>
                    <Border Width="1" Background="#5580CFFF" Margin="6,2,6,2"/>
                    <Button Style="{StaticResource TopBtn}" Content="&#x2715;" FontSize="12" Click="CloseButton_Click"
                            Foreground="#FF8A8A"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>