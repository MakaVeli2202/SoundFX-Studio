<Window x:Class="SoundFXStudio.Views.Dialogs.MicrophoneRecorderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Audio"
        Width="420"
        Height="300"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Style="{StaticResource AppWindowRoot}"
            CornerRadius="28"
            BorderThickness="1.5">

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="24" Background="#C1141E2D" BorderBrush="#334A647F" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Image Source="/Assets/UI/MainDashboardLogo.png" Height="40" Stretch="Uniform"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="SOUNDFX STUDIO" Foreground="#00D4FF" FontWeight="Bold"/>
                            <TextBlock Text="Record Audio" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" CornerRadius="24" Background="#C1141E2D" BorderBrush="#334A647F" BorderThickness="1" Margin="0,12,0,12">
                <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border x:Name="StatusCircle" Width="80" Height="80" CornerRadius="40"
                            Background="#1A2A2A66" BorderBrush="#5A00D4FF" BorderThickness="2"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock x:Name="StatusIcon" Text="&#x1F3A4;" FontSize="36"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="StatusText" Text="Ready to record" FontSize="16" Foreground="#9AAFD0"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TimerText" Text="00:00" FontSize="28" FontWeight="Bold" Foreground="#00D4FF"
                               HorizontalAlignment="Center"/>
                    <TextBox x:Name="NameBox" Text="Mic Recording" Width="260"
                             Background="#22000000" BorderBrush="#3300D4FF" BorderThickness="1" Foreground="White"
                             Padding="6,4" FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,0"
                             Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="RecordButton" Content="&#x25B6; Record" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryActionButtonStyle}" Height="40"
                        Click="RecordButton_Click"/>
                <Button x:Name="SaveButton" Content="Save" Margin="0,0,10,0" IsDefault="True"
                        Visibility="Collapsed" Click="SaveButton_Click"
                        Style="{StaticResource PrimaryGradientButtonStyle}"/>
                <Button Content="Cancel" IsCancel="True" Click="CancelButton_Click"
                        Style="{StaticResource SecondaryActionButtonStyle}" Height="40"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
