<UserControl x:Class="SoundFXStudio.Controls.WindowControlBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="MinimizeGlowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2A00D4FF" Offset="0"/>
            <GradientStop Color="#2E7B3FFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CloseGlowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4DF43F5E" Offset="0"/>
            <GradientStop Color="#33E11D48" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="OuterRingBrush" Color="#7AD8E4FF"/>

        <Style x:Key="BarCapsuleButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#9FB4D8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Glow" CornerRadius="13"
                                    Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                    Opacity="0"/>
                            <Border x:Name="HoverRing" CornerRadius="13"
                                    BorderBrush="#8AFFFFFF" BorderThickness="1" Opacity="0"/>
                            <Border x:Name="OuterRing" Margin="-3" CornerRadius="15"
                                    BorderBrush="{StaticResource OuterRingBrush}" BorderThickness="2" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="OuterRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="OuterRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="0.93" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="0.93" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="BarEntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="BarSurface" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="BarTranslate" Storyboard.TargetProperty="Y" From="-12" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <StackPanel x:Name="BarSurface"
                Orientation="Horizontal">
        <StackPanel.RenderTransform>
            <TranslateTransform x:Name="BarTranslate"/>
        </StackPanel.RenderTransform>
        <Button x:Name="MinimizeButton"
                Style="{StaticResource BarCapsuleButton}"
                Tag="{StaticResource MinimizeGlowBrush}"
                Click="MinimizeButton_Click"
                ToolTip="Minimize"
                    AutomationProperties.Name="Minimize">
                <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="CloseButton"
                    Style="{StaticResource BarCapsuleButton}"
                    Tag="{StaticResource CloseGlowBrush}"
                    Click="CloseButton_Click"
                    ToolTip="Close"
                    AutomationProperties.Name="Close">
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="14" VerticalAlignment="Center"/>
            </Button>
    </StackPanel>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource BarEntranceStoryboard}"/>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
