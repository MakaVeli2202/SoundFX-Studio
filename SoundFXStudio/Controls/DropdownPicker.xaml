<UserControl x:Class="SoundFXStudio.Controls.DropdownPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button x:Name="ToggleBtn"
                Grid.Row="0"
                Height="38"
                Padding="12,0"
                Background="#B31B263A"
                Foreground="White"
                FontSize="12"
                HorizontalContentAlignment="Stretch"
                Click="ToggleBtn_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{Binding AccentBrush, ElementName=Root}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedText"
                                       Grid.Column="0"
                                       Text="{TemplateBinding Content}"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{TemplateBinding FontSize}"/>
                            <Path Grid.Column="1"
                                  Data="M 0,0 L 8,0 L 4,5 Z"
                                  Fill="#9AAFD0"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Border x:Name="DropPanel"
                Grid.Row="1"
                Visibility="Collapsed"
                MaxHeight="280"
                Margin="0,4,0,0"
                Background="#F5121C2E"
                BorderBrush="{Binding AccentBrush, ElementName=Root}"
                BorderThickness="1"
                CornerRadius="8"
                SnapsToDevicePixels="True">
            <ListBox x:Name="ItemsList"
                     ItemsSource="{Binding ItemsSource, ElementName=Root}"
                     DisplayMemberPath="{Binding DisplayMemberPath, ElementName=Root}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ItemsList_SelectionChanged"
                     PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                     MouseLeftButtonUp="ItemsList_MouseLeftButtonUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3300D4FF"/>
                                <Setter Property="Foreground" Value="#BFF4FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A00D4FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
