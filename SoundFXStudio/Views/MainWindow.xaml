<Window x:Class="SoundFXStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundFXStudio.Controls"
        xmlns:converters="clr-namespace:SoundFXStudio.Converters"
        xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore"
        Title="SoundFX Studio"
        Icon="/Assets/SoundFXStudioLogo.png"
        Width="1366"
        Height="900"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <converters:SizeToRectConverter x:Key="SizeToRectConverter"/>

        <Storyboard x:Key="LedTravelStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LedStopA" Storyboard.TargetProperty="Offset" From="-0.4" To="1.4" Duration="0:0:7"/>
            <DoubleAnimation Storyboard.TargetName="LedStopB" Storyboard.TargetProperty="Offset" From="-0.2" To="1.6" Duration="0:0:7"/>
            <DoubleAnimation Storyboard.TargetName="LedStopC" Storyboard.TargetProperty="Offset" From="0" To="1.8" Duration="0:0:7"/>
        </Storyboard>

        <Storyboard x:Key="OpenKeyboardLedRingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RingStopA" Storyboard.TargetProperty="Offset" From="1.0" To="-1.0" Duration="0:0:4"/>
            <DoubleAnimation Storyboard.TargetName="RingStopB" Storyboard.TargetProperty="Offset" From="0.8" To="-1.2" Duration="0:0:4"/>
            <DoubleAnimation Storyboard.TargetName="RingStopC" Storyboard.TargetProperty="Offset" From="0.6" To="-1.4" Duration="0:0:4"/>
        </Storyboard>

        <Storyboard x:Key="ShellPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="ShellGlow" Storyboard.TargetProperty="Opacity" From="0.14" To="0.24" Duration="0:0:3.4"/>
        </Storyboard>

        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Background" Value="#85141E2D"/>
            <Setter Property="BorderBrush" Value="#334A647F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>



        <!-- ═══ MyBoard-Style Button Templates ═══ -->

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F43F5E" Offset="0"/>
            <GradientStop Color="#E11D48" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="RoundButton" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
        </Style>

        <Style x:Key="RoundButtonSecondary" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="RoundButtonDanger" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="{TemplateBinding Padding}" Background="{StaticResource DangerGradient}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#F43F5E" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Settings Panel Button ═══ -->
        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDEAFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#1F13233A"/>
            <Setter Property="BorderBrush" Value="#4A00D4FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                         <ControlTemplate.Triggers>
                             <Trigger Property="IsMouseOver" Value="True">
                                 <Setter TargetName="Bd" Property="Background" Value="#2A00D4FF"/>
                                 <Setter TargetName="Bd" Property="BorderBrush" Value="#AA00D4FF"/>
                                 <Setter TargetName="Bd" Property="Effect">
                                     <Setter.Value>
                                         <effects:DropShadowEffect Color="#00D4FF" BlurRadius="16" ShadowDepth="0" Opacity="0.38"/>
                                     </Setter.Value>
                                 </Setter>
                             </Trigger>
                             <Trigger Property="IsPressed" Value="True">
                                 <Setter TargetName="Bd" Property="Background" Value="#3A00D4FF"/>
                                 <Setter TargetName="Bd" Property="BorderBrush" Value="#00D4FF"/>
                             </Trigger>
                         </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Sidebar Navigation Button ═══ -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#A9BAD3"/>
            <Setter Property="Background" Value="#0F192B"/>
            <Setter Property="BorderBrush" Value="#22344D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="12"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,10,0"/>
                            </Border>
                            <Border x:Name="ActiveStrip"
                                    Width="3"
                                    Margin="0,10,0,10"
                                    HorizontalAlignment="Left"
                                    CornerRadius="3"
                                    Background="{TemplateBinding BorderBrush}"
                                    Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15253D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B5E87"/>
                                <Setter TargetName="ActiveStrip" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D3154"/>
                                <Setter TargetName="ActiveStrip" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="BorderBrush" Value="#00D4FF">
                                <Setter TargetName="ActiveStrip" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="BorderBrush" Value="#A855F7">
                                <Setter TargetName="ActiveStrip" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="BorderBrush" Value="#FF4DC8">
                                <Setter TargetName="ActiveStrip" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="BorderBrush" Value="#FFB020">
                                <Setter TargetName="ActiveStrip" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Settings Section Nav Button ═══ -->
        <Style x:Key="SettingsSectionButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- ═══ MyBoard 3D Keycap Tile Style ═══ -->
        <Style x:Key="SoundTileButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Skirt" CornerRadius="17" Margin="0,0,0,3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1B2A4A" Offset="0"/>
                                        <GradientStop Color="#0C1326" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <effects:DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.55"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Face" Margin="0,0,0,8" CornerRadius="15" BorderBrush="#2AFFFFFF" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#141E2D" Offset="0"/>
                                        <GradientStop Color="#0B1322" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <ContentPresenter x:Name="TileContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    <Border VerticalAlignment="Top" Height="20" Margin="2,1,2,0" CornerRadius="12,12,0,0" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#18FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#8800D4FF"/>
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#18243B" Offset="0"/>
                                            <GradientStop Color="#0E1628" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Skirt" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#00D4FF" BlurRadius="22" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.13"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.13"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#FF2DAF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#00D4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="10,0,10,10"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50"
                          ShadowDepth="0"
                          Color="#000000"
                          Opacity="0.6"/>
        </Border.Effect>

        <Border.BorderBrush>

            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,0">

                <GradientStop Color="#2AB8FF"
                              Offset="0"/>

                <GradientStop Color="#377DFF"
                              Offset="1"/>

            </LinearGradientBrush>

        </Border.BorderBrush>

        <Border.BorderThickness>1.5</Border.BorderThickness>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Rectangle RadiusX="10" RadiusY="10" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="/Assets/Pics/MainWindowBackground.png"
                                Stretch="UniformToFill"
                                Opacity="0.8"/>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle RadiusX="10" RadiusY="10" Fill="#4D000000" IsHitTestVisible="False"/>

            <Border x:Name="ShellGlow"
                    Margin="3"
                    CornerRadius="18"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Opacity="0.14">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#2200D4FF"/>
                </Border.BorderBrush>
            </Border>

            <Border Margin="2"
                    CornerRadius="18"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Opacity="0.58">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="LedStopA" Color="#0000D4FF" Offset="-0.4"/>
                        <GradientStop x:Name="LedStopB" Color="#D000D4FF" Offset="-0.2"/>
                        <GradientStop x:Name="LedStopC" Color="#00FF2DAF" Offset="0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="#2900D4FF" BlurRadius="10" ShadowDepth="0" Opacity="0.36"/>
                </Border.Effect>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource LedTravelStoryboard}"/>
                    </EventTrigger>
                </Border.Triggers>
            </Border>

            <!-- Dashboard Hero Section -->
            <Border x:Name="HeroSectionBorder"
                    MinHeight="420"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="308,74,40,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SOUND CONTROL"
                                   Foreground="#00D4FF"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock Grid.Row="1"
                                   Text="Launch your keyboard, browse sounds, and jump into your voice pipeline from one dashboard."
                                   Foreground="#A2B4CC"
                                   FontSize="13"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="26" ClipToBounds="True" MinHeight="350">
                        <Grid>
                            <Image x:Name="HeroImage"
                                   Source="/Assets/UI/HeroSection.png"
                                   Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry RadiusX="26" RadiusY="26">
                                        <RectangleGeometry.Rect>
                                            <MultiBinding Converter="{StaticResource SizeToRectConverter}">
                                                <Binding ElementName="HeroImage" Path="ActualWidth"/>
                                                <Binding ElementName="HeroImage" Path="ActualHeight"/>
                                            </MultiBinding>
                                        </RectangleGeometry.Rect>
                                    </RectangleGeometry>
                                </Image.Clip>
                            </Image>

                            <Button x:Name="OpenKeyboardOverlayButton"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Width="220"
                                    Height="48"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="36,488,0,0"
                                    AutomationProperties.Name="Open Keyboard"
                                    AutomationProperties.AutomationId="OpenKeyboardButton"
                                    Click="OpenKeyboardWindowButton_Click"
                                    Background="Transparent"
                                    BorderBrush="#00D4FF"
                                    BorderThickness="1"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Root"
                                                CornerRadius="12"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#0000D4FF" BlurRadius="10" ShadowDepth="0" Opacity="0"/>
                                            </Border.Effect>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#2A00D4FF"/>
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#7FDBFF"/>
                                                <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="Root" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00D4FF" BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Border x:Name="OpenKeyboardLedRing"
                                    Width="220"
                                    Height="48"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="36,488,0,0"
                                    CornerRadius="12"
                                    BorderThickness="2"
                                    IsHitTestVisible="False"
                                    SnapsToDevicePixels="True">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RingStopA" Color="#0000D4FF" Offset="1.0"/>
                                        <GradientStop x:Name="RingStopB" Color="#D000D4FF" Offset="0.8"/>
                                        <GradientStop x:Name="RingStopC" Color="#00FF2DAF" Offset="0.6"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <DropShadowEffect Color="#2900D4FF" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard Storyboard="{StaticResource OpenKeyboardLedRingStoryboard}"/>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource SurfaceCardStyle}"
                                Background="#9C141E2D"
                                Margin="0,0,8,0"
                                Padding="16">
                            <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="NavigateSoundLibrary_Click">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#00D4FF"/>
                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                        <TextBlock Text="Browse sounds" Foreground="#F7FAFF" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="Search, filter, and jump straight to a sound." Foreground="#8EA2C0" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource SurfaceCardStyle}"
                                Background="#9C141E2D"
                                Margin="8,0,8,0"
                                Padding="16">
                            <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="NavigateEffects_Click">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#22C55E"/>
                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                        <TextBlock Text="Voice changer" Foreground="#F7FAFF" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="Adjust your voice workflow and monitor status." Foreground="#8EA2C0" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource SurfaceCardStyle}"
                                Background="#9C141E2D"
                                Margin="8,0,0,0"
                                Padding="16">
                            <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="NavigateSettings_Click">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#7B3FFF"/>
                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                        <TextBlock Text="Settings" Foreground="#F7FAFF" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="Tune devices, routing, and hotkeys when needed." Foreground="#8EA2C0" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Effects Page -->
            <Border HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="308,74,40,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Effects">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="VOICE CHANGER" Foreground="#00D4FF" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="Route your microphone through the voice pipeline, then refine the effect with presets and tone controls."
                                       Foreground="#A2B4CC" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#191B2736" BorderBrush="#3300D4FF" BorderThickness="1" CornerRadius="14" Padding="14,12" MinWidth="280">
                            <StackPanel>
                                <TextBlock Text="SIGNAL FLOW" Foreground="#00D4FF" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock Text="Microphone → Voice Changer → Output" Foreground="#F7FAFF" FontSize="13.5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="Use the status snapshot below to confirm your current input and routing before you start." Foreground="#8EA2C0" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Background="#9C141E2D" Padding="20" Margin="0,0,0,14" CornerRadius="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="INPUT DEVICE" Foreground="#00D4FF" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentInputDevice, FallbackValue='No input device selected'}" Foreground="#F7FAFF" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                <TextBlock Text="PROCESSING STATUS" Foreground="#00D4FF" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock x:Name="VoiceChangerSummaryText" Text="Ready to start" Foreground="#22C55E" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="OUTPUT DEVICE" Foreground="#00D4FF" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentOutputDevice, FallbackValue='No output device selected'}" Foreground="#F7FAFF" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Background="#9C141E2D" Padding="20" Margin="0,0,8,0" CornerRadius="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="PRIMARY CONTROLS" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Start or stop the real-time processing pipeline and preview what your team hears." Foreground="#A1B2D2" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <Button x:Name="VoiceChangerToggleBtn"
                                        Content="Start Voice Changer"
                                        Height="38" HorizontalAlignment="Left" Padding="18,0"
                                        Background="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource BorderAccentBrush}" Foreground="White"
                                        BorderThickness="1" Cursor="Hand" FontSize="12" FontWeight="SemiBold" AutomationProperties.Name="Start Voice Changer"/>
                                <Border Margin="0,12,0,0" Background="#1AFFFFFF" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="VoiceChangerStatusDot" Width="8" Height="8" CornerRadius="4" Background="#E85555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="VoiceChangerStatus" Text="Stopped"
                                                   Foreground="#E85555" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <TextBlock Text="&#xE7C1;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="MONITOR" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Hear what your mic sends to your team while you talk." Foreground="#A1B2D2" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button x:Name="TeamMonitorToggleBtn"
                                        Content="Hear What People Hear"
                                        Height="34" HorizontalAlignment="Left" Padding="14,0"
                                        Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderAccentBrush}" Foreground="White"
                                        BorderThickness="1" Cursor="Hand" FontSize="11.5" FontWeight="SemiBold"
                                        Click="TeamMonitorToggle_Click" AutomationProperties.Name="Hear What People Hear"/>
                                <Border Margin="0,10,0,0" Background="#1AFFFFFF" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="TeamMonitorStatusDot" Width="8" Height="8" CornerRadius="4" Background="#98A0C0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TeamMonitorStatus" Text="Off"
                                                   Foreground="#98A0C0" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Background="#9C141E2D" Padding="20" Margin="8,0,0,0" CornerRadius="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="EFFECT CONTROLS" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Choose a preset, then tune the pitch and formant to match your voice." Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,6"/>
                                <ComboBox x:Name="VoiceChangerPresetCombo" Height="30" HorizontalAlignment="Stretch"
                                          Background="#44111A2E" BorderBrush="#558B5CF6" Foreground="White" FontSize="12"
                                          BorderThickness="1" Padding="6,1" Margin="0,0,0,4"
                                          DisplayMemberPath="Name"/>
                                <TextBlock x:Name="PresetSummaryText" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="PITCH" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Shift your voice up or down in semitones." Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="PitchSlider" Grid.Column="0"
                                            Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="1"
                                            TickFrequency="2" TickPlacement="BottomRight"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="5" Padding="8,3">
                                        <TextBlock x:Name="PitchValueText" Text="0.0 st"
                                                   Foreground="White" FontSize="11" FontWeight="Bold"
                                                   MinWidth="40" TextAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="FORMANT" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Change voice character without pitch." Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="FormantSlider" Grid.Column="0"
                                            Minimum="0.5" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="5" Padding="8,3">
                                        <TextBlock x:Name="FormantValueText" Text="1.00x"
                                                   Foreground="White" FontSize="11" FontWeight="Bold"
                                                   MinWidth="40" TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Library Page (tile grid) — MyBoard design with dark theme -->
                    <Border
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="308,74,40,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="SoundLibrary">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SOUND LIBRARY"
                                   Foreground="#00D4FF"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock Grid.Row="1"
                                   Text="Find the sound you need quickly, then trigger, edit, or manage it from one place."
                                   Foreground="#A2B4CC"
                                   FontSize="13"
                                   Margin="0,4,0,0"/>
                    </Grid>

                    <!-- TOOLBAR -->
                    <Border Grid.Row="1" Background="#1A192438" CornerRadius="16" Padding="14,12" Margin="0,0,0,12" BorderBrush="#2F3E58" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" ItemHeight="40">
                                <Button Content="+ Add Sound"
                                        Style="{StaticResource RoundButton}"
                                        Command="{Binding AddSoundCommand}"/>
                                <Button Content="&#x1F310; URL"
                                        Style="{StaticResource RoundButtonSecondary}"
                                        Command="{Binding AddSoundFromUrlCommand}"/>
                                <Button Content="&#x1F3A4; Mic"
                                        Style="{StaticResource RoundButtonSecondary}"
                                        Click="LibraryMicButton_Click"/>
                                <Button Content="&#x1F5D1; Delete"
                                        Style="{StaticResource RoundButtonDanger}"
                                        Command="{Binding DeleteMarkedSoundsCommand}"/>
                            </WrapPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#152137" BorderBrush="#2C476A" BorderThickness="1" CornerRadius="999" Padding="12,5" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Sounds.Count, StringFormat='{}{0} sounds'}" Foreground="#DDE7F8" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#152137" BorderBrush="#2C476A" BorderThickness="1" CornerRadius="999" Padding="12,5">
                                    <TextBlock Text="{Binding SoundsView.Count, StringFormat='{}{0} visible'}" Foreground="#8EA2C0" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SEARCH & FILTERS -->
                    <Border Grid.Row="2" Background="#1A192438" CornerRadius="16" BorderBrush="#2F3E58" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="#0E182A" CornerRadius="12" BorderBrush="#2C476A" BorderThickness="1" Padding="0">
                                <Grid>
                                    <TextBlock Text="&#x1F50D;" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox x:Name="LibrarySearchBox"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="White" FontSize="12" CaretBrush="White"
                                             VerticalAlignment="Center"
                                             Margin="30,0,8,0">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Text="Search sounds..." Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                               VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <ComboBox Grid.Column="1"
                                      Width="180"
                                      Margin="12,0,0,0"
                                      ItemsSource="{Binding Categories}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Name"
                                      SelectedValue="{Binding SelectedCategoryFilter, Mode=TwoWay}"/>

                            <CheckBox Grid.Column="2"
                                      Margin="12,0,0,0"
                                      Content="Favorites only"
                                      Foreground="#DDE7F8"
                                      IsChecked="{Binding FavoritesOnly, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- TILES - MyBoard 3D keycap style -->
                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="4,0,4,0">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollViewer">
                                            <Grid>
                                                <ScrollContentPresenter Margin="0,0,6,0"/>
                                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                                           Value="{TemplateBinding VerticalOffset}"
                                                           Maximum="{TemplateBinding ScrollableHeight}"
                                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                           Background="#0A1424"
                                                           BorderBrush="#1B3157"
                                                           BorderThickness="1"
                                                           Width="8"
                                                           Cursor="Hand">
                                                    <ScrollBar.Template>
                                                        <ControlTemplate TargetType="ScrollBar">
                                                            <Grid>
                                                                <Track x:Name="PART_Track">
                                                                    <Track.Thumb>
                                                                        <Thumb BorderBrush="#8B5CF6" Background="#228B5CF6" BorderThickness="1">
                                                                            <Thumb.Template>
                                                                                <ControlTemplate TargetType="Thumb">
                                                                                    <Border CornerRadius="4" Background="#228B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" Margin="0,1"/>
                                                                                </ControlTemplate>
                                                                            </Thumb.Template>
                                                                        </Thumb>
                                                                    </Track.Thumb>
                                                                </Track>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </ScrollBar.Template>
                                                </ScrollBar>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Style>

                        <ItemsControl ItemsSource="{Binding SoundsView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SoundTileButton}"
                                            Command="{Binding DataContext.PlaySoundCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <!-- image fills the whole tile face, clipped to the rounded corners -->
                                            <Border CornerRadius="15" ClipToBounds="True">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#14000000"/>
                                                </Border.Background>
                                                <Grid>
                                                    <Image x:Name="TileImage" Source="{Binding ImagePath}"
                                                           Stretch="UniformToFill"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                        <Image.Clip>
                                                            <RectangleGeometry RadiusX="15" RadiusY="15">
                                                                <RectangleGeometry.Rect>
                                                                    <MultiBinding Converter="{StaticResource SizeToRectConverter}">
                                                                        <Binding ElementName="TileImage" Path="ActualWidth"/>
                                                                        <Binding ElementName="TileImage" Path="ActualHeight"/>
                                                                    </MultiBinding>
                                                                </RectangleGeometry.Rect>
                                                            </RectangleGeometry>
                                                        </Image.Clip>
                                                    </Image>

                                                    <!-- icon fallback when no image -->
                                                    <TextBlock Text="&#x266B;" FontSize="34" Foreground="#28364F"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <!-- overlay: name + key badge -->
                                            <Grid Margin="12,10,12,12" VerticalAlignment="Stretch">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="White"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="32"
                                                               TextTrimming="CharacterEllipsis"
                                                               LineHeight="14">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1" Opacity="0.9"/>
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Category}"
                                                               Foreground="#9CEBFF"
                                                               FontSize="10.5"
                                                               Margin="0,2,0,0">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.9"/>
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Border Grid.Row="2"
                                                        CornerRadius="7"
                                                        Padding="8,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom"
                                                        Background="#B3141E2D"
                                                        BorderBrush="#00D4FF"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding AssignedKeyLabel, TargetNullValue='+ key'}" Foreground="#DDEAFF" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <Button.ContextMenu>
                                            <ContextMenu Background="#1A1A2E"
                                                         BorderBrush="#2A2A4E"
                                                         BorderThickness="1"
                                                         Foreground="White"
                                                         FontSize="12"
                                                         HasDropShadow="True">
                                                <ContextMenu.Resources>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Background" Value="#1A1A2E"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#2A2A4E"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="12,6"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter Property="Background" Value="#282850"/>
                                                                <Setter Property="BorderBrush" Value="#3535D0"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style TargetType="Separator">
                                                        <Setter Property="Background" Value="#2A2A4E"/>
                                                        <Setter Property="Margin" Value="6,2"/>
                                                        <Setter Property="Height" Value="1"/>
                                                    </Style>
                                                </ContextMenu.Resources>
                                                <MenuItem Header="&#x25B6; Play" Click="SoundTileMenu_Play"/>
                                                <MenuItem Header="&#x270E; Edit" Click="SoundTileMenu_Edit"/>
                                                <MenuItem Header="&#x1F4CC; Assign to Key" Click="SoundTileMenu_Assign"/>
                                                <Separator/>
                                                <MenuItem Header="&#x1F4CE; Duplicate" Click="SoundTileMenu_Duplicate"/>
                                                <MenuItem Header="&#x2B50; Toggle Favorite" Click="SoundTileMenu_Favorite"/>
                                                <Separator/>
                                                <MenuItem Header="&#x1F5BC; Choose Image" Click="SoundTileMenu_ChooseImage"/>
                                                <MenuItem Header="&#x274C; Remove Image" Click="SoundTileMenu_RemoveImage"/>
                                                <MenuItem Header="&#x1F511; Remove Binding" Click="SoundTileMenu_ClearBinding"/>
                                                <Separator/>
                                                <MenuItem Header="&#x1F5D1; Delete" Foreground="#F43F5E" Click="SoundTileMenu_Delete"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Settings Page -->
                        <Border
                        HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                        Margin="308,74,40,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ═══ SETTINGS SECTION RAIL ═══ -->
                        <Border Grid.Column="0" Background="#8C0C1424" BorderBrush="#1B3157"
                                BorderThickness="1" CornerRadius="18" Margin="14,14,8,14">
                            <StackPanel Margin="12">
                                <TextBlock Text="SETTINGS"
                                           Foreground="#00D4FF"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="10,8,0,14"/>
                                <TextBlock Text="Tune audio routing, hotkeys and general behavior."
                                           Foreground="#9CB0CB" FontSize="12.5" TextWrapping="Wrap" Margin="10,0,6,14"/>

                                <Button x:Name="SettingsSectionGeneralButton" Tag="General" Click="SettingsSectionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSectionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="General">
                                                    <Setter Property="Background" Value="#2A00D4FF"/>
                                                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="26" VerticalAlignment="Center"/>
                                        <TextBlock Text="General" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="SettingsSectionAudioButton" Tag="Audio" Click="SettingsSectionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSectionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Audio">
                                                    <Setter Property="Background" Value="#2A00D4FF"/>
                                                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="26" VerticalAlignment="Center"/>
                                        <TextBlock Text="Audio" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="SettingsSectionKeybindsButton" Tag="Keybinds" Click="SettingsSectionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSectionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Keybinds">
                                                    <Setter Property="Background" Value="#2A00D4FF"/>
                                                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="26" VerticalAlignment="Center"/>
                                        <TextBlock Text="Keybinds" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="SettingsSectionAdvancedButton" Tag="Advanced" Click="SettingsSectionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSectionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Advanced">
                                                    <Setter Property="Background" Value="#2A00D4FF"/>
                                                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7C4;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="26" VerticalAlignment="Center"/>
                                        <TextBlock Text="Advanced" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="SettingsSectionCalibrationButton" Tag="Calibration" Click="SettingsSectionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSectionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Calibration">
                                                    <Setter Property="Background" Value="#2A00D4FF"/>
                                                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9CE;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="26" VerticalAlignment="Center"/>
                                        <TextBlock Text="Calibration" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- ═══ SETTINGS CONTENT ═══ -->
                        <Border Grid.Column="1" Background="#8C0C1424" BorderBrush="#1B3157"
                            BorderThickness="1" CornerRadius="18" Margin="8,14,14,14">
                            <Grid>

                                <!-- ══ GENERAL ══ -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="General">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Margin="24">
                                        <TextBlock x:Name="SettingsGeneralHeader"
                                                   Text="GENERAL" Foreground="#8B5CF6" FontSize="16" FontWeight="Bold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Foreground="#7F899C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"
                                                   Text="Startup and app behavior."/>

                                        <Border Background="#66081428" BorderBrush="#558B5CF6" BorderThickness="1"
                                            CornerRadius="12" Padding="18,16">
                                            <StackPanel>
                                                <CheckBox x:Name="ShowWizardOnStartupCheck"
                                                          Content="Show setup wizard on startup"
                                                          IsChecked="{Binding Settings.ShowSetupWizardOnStartup, Mode=TwoWay}"
                                                          Foreground="#DDEAFF" FontSize="12" Margin="0,0,0,10"/>
                                                <CheckBox x:Name="StartMinimizedCheck"
                                                          Content="Start minimized to tray"
                                                          IsChecked="{Binding Settings.StartMinimized, Mode=TwoWay}"
                                                          Foreground="#DDEAFF" FontSize="12"/>
                                                <TextBlock Foreground="#7F899C" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                                                           Text="Voicemeeter hear/talk selection, routing and reset live in the Setup Wizard."/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#66081428" BorderBrush="#558B5CF6" BorderThickness="1"
                                            CornerRadius="12" Padding="18,16" Margin="0,12,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Keyboard window size" Foreground="#DDEAFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding KeyboardWindowScale, StringFormat='{}{0:P0}', ConverterCulture=en-US}"
                                                               Foreground="#00D4FF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Slider Minimum="0.5" Maximum="2.0"
                                                        Value="{Binding KeyboardWindowScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="False"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Foreground="#7F899C" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                                           Text="Size the Open Keyboard window. Opens at this size by default."/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- ══ AUDIO ══ -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Audio">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Margin="24">
                                        <TextBlock x:Name="SettingsAudioHeader"
                                                   Text="AUDIO DEVICES" Foreground="#8B5CF6" FontSize="16" FontWeight="Bold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Foreground="#7F899C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"
                                                   Text="Where SoundFX plays sounds and where your voice comes from."/>

                                        <Border Background="#66081428" BorderBrush="#558B5CF6"
                                            BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,0,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="AUDIO SETUP" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                                    <TextBlock Foreground="#A1B2D2" FontSize="10.5" TextWrapping="Wrap"
                                                               Text="Set hear/talk devices, route apps through Voicemeeter, or reset routing."/>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ItemHeight="34">
                                                    <Button x:Name="TeamMonitorBtn" Content="Hear What People Hear"
                                                            AutomationProperties.AutomationId="SettingsHearPeopleButton"
                                                            Style="{StaticResource SettingsButton}"
                                                        MinWidth="158"
                                                            FontWeight="SemiBold"
                                                            Click="TeamMonitorButton_Click"/>
                                                    <Button x:Name="RerunWizardBtn" Content="Open Setup Wizard"
                                                            AutomationProperties.AutomationId="SettingsOpenAudioSetupWizardButton"
                                                            Style="{StaticResource SettingsButton}"
                                                        MinWidth="146"
                                                            FontWeight="SemiBold"
                                                            Margin="8,0,0,0"
                                                            Click="RerunWizard_Click"/>
                                                    <Button x:Name="MixerBtn" Content="Sound Mixer"
                                                            Style="{StaticResource SettingsButton}"
                                                        MinWidth="116"
                                                            Background="#151B35" BorderBrush="#3A5A8A" Foreground="#A1B2D2"
                                                            Margin="8,0,0,0"
                                                            Click="MixerButton_Click"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="#66081428" BorderBrush="#558B5CF6"
                                                    BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="OUTPUT DEVICE" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                                    <TextBlock Foreground="#A1B2D2" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,6"
                                                               Text="Where SoundFX plays your sounds."/>
                                                    <ComboBox x:Name="SpeakersComboBox" Height="28" DisplayMemberPath="Name"
                                                              Background="#44111A2E" BorderBrush="#558B5CF6" Foreground="White" FontSize="12"
                                                              BorderThickness="1" Padding="6,1"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1" Background="#66081428" BorderBrush="#558B5CF6"
                                                    BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="MICROPHONE (VOICE INPUT)" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                                    <TextBlock Foreground="#A1B2D2" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,6"
                                                               Text="Where your voice comes from (VoiceMeeter B1 when routed)."/>
                                                    <ComboBox x:Name="MicrophoneComboBox" Height="28" DisplayMemberPath="Name"
                                                              Background="#44111A2E" BorderBrush="#558B5CF6" Foreground="White" FontSize="12"
                                                              BorderThickness="1" Padding="6,1"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ══ KEYBINDS ══ -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Keybinds">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="24">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="KEYBINDS (HOTKEYS)" Foreground="#8B5CF6" FontSize="16" FontWeight="Bold"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Foreground="#7F899C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"
                                                       Text="Global shortcuts for mute actions and the soundboard toggle."/>

                                            <Button x:Name="AddBindingButton"
                                                    AutomationProperties.AutomationId="SettingsAddBindingButton"
                                                    Click="AddBindingButton_Click"
                                                    HorizontalAlignment="Left" Margin="0,0,0,12">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Height" Value="34"/>
                                                        <Setter Property="Padding" Value="14,0"/>
                                                        <Setter Property="Foreground" Value="#8B5CF6"/>
                                                        <Setter Property="Background" Value="#0A1A2E"/>
                                                        <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Grid>
                                                                        <Rectangle x:Name="Bd" RadiusX="9" RadiusY="9"
                                                                                   Fill="{TemplateBinding Background}"
                                                                                   Stroke="{TemplateBinding BorderBrush}"
                                                                                   StrokeThickness="1"
                                                                                   StrokeDashArray="4,3"/>
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                          Margin="{TemplateBinding Padding}"/>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Fill" Value="#1A8B5CF6"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Add Binding" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                                <Border x:Name="AddBindingPanel" Visibility="Collapsed"
                                                    Background="#66081428" BorderBrush="#558B5CF6" BorderThickness="1"
                                                    CornerRadius="12" Padding="18,16" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Choose an action:" Foreground="#DDEAFF" FontSize="11" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="AddBindingActionCombo" Height="30"
                                                              ItemsSource="{Binding AvailableKeybindActions}"
                                                              Background="#44111A2E" BorderBrush="#558B5CF6" Foreground="White" FontSize="12"
                                                              BorderThickness="1" Padding="6,1"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                        <Button x:Name="AddBindingRecordButton" Content="Record"
                                                                AutomationProperties.AutomationId="SettingsAddBindingRecordButton"
                                                                Height="30" Width="90" FontSize="11"
                                                                Style="{StaticResource SettingsButton}"
                                                                Click="AddBindingRecordButton_Click"/>
                                                        <Button x:Name="AddBindingCancelButton" Content="Cancel"
                                                                Height="30" Width="90" FontSize="11" Margin="8,0,0,0"
                                                                Style="{StaticResource SettingsButton}"
                                                                Background="#151B35" BorderBrush="#3A5A8A" Foreground="#A1B2D2"
                                                                Click="AddBindingCancelButton_Click"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                <TextBlock Text="Activation:" Foreground="#A1B2D2" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <ComboBox x:Name="KeybindHoldModeCombo" Width="200" Height="30" FontSize="12"
                                                          Background="#44111A2E" BorderBrush="#558B5CF6" Foreground="White"
                                                          BorderThickness="1" Padding="6,1">
                                                    <ComboBoxItem Content="Hold + tap sound key"/>
                                                    <ComboBoxItem Content="Toggle"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Grid.Row="1">
                                            <ItemsControl x:Name="KeybindingsList" ItemsSource="{Binding Keybindings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#8C0C1424" BorderBrush="#1B3157" BorderThickness="1"
                                                                CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ActionName}" Foreground="#DDEAFF" FontSize="12" FontWeight="SemiBold"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding Key}" Foreground="#8B5CF6" FontSize="12" FontWeight="Bold"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="Change" Height="26" FontSize="10.5" Margin="0,0,6,0"
                                                                            Click="KeybindingChangeButton_Click" Tag="{Binding}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}">
                                                                                <Setter Property="Padding" Value="8,3"/>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                    <Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                                            Height="26" Click="KeybindingDeleteButton_Click" Tag="{Binding}"
                                                                            Background="#33151515" BorderBrush="#F43F5E" Foreground="#F43F5E">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}">
                                                                                <Setter Property="Padding" Value="0"/>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="NoKeybindingsText" Text="No keybindings yet. Click Add Binding."
                                                       Foreground="#7F899C" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- ══ CALIBRATION ══ -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Calibration">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Margin="24">
                                        <TextBlock Text="CALIBRATION" Foreground="#00D4FF" FontSize="16" FontWeight="Bold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Foreground="#7F899C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"
                                                   Text="Match the on-screen keyboard to your physical keyboard."/>

                                        <Border Background="#66081428" BorderBrush="#5500D4FF" BorderThickness="1"
                                            CornerRadius="12" Padding="18,16" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="KEYBOARD LAYOUT" Foreground="#00D4FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <ComboBox ItemsSource="{Binding KeyboardLayoutOptions}"
                                                          SelectedItem="{Binding KeyboardLayout}"
                                                          Height="28" HorizontalAlignment="Left" Width="220"
                                                          Background="#44111A2E" BorderBrush="#5500D4FF" Foreground="White" FontSize="12"
                                                          BorderThickness="1" Padding="6,1"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#66081428" BorderBrush="#5500D4FF" BorderThickness="1"
                                            CornerRadius="12" Padding="18,16">
                                            <StackPanel>
                                                <TextBlock Text="KEYBOARD CALIBRATION" Foreground="#00D4FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <TextBlock Foreground="#A1B2D2" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8"
                                                           Text="Adjust key positions for your physical keyboard."/>
                                                <Button Content="Open Keyboard Calibration"
                                                        Style="{StaticResource SettingsButton}"
                                                        Click="OpenCalibrationButton_Click"
                                                        HorizontalAlignment="Left" Width="200"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- ══ ADVANCED ══ -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Advanced">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Margin="24">
                                        <TextBlock Text="ADVANCED" Foreground="#8B5CF6" FontSize="16" FontWeight="Bold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Foreground="#7F899C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"
                                                   Text="Voicemeeter routing and advanced options."/>

                                        <Border Background="#66081428" BorderBrush="#558B5CF6" BorderThickness="1"
                                            CornerRadius="12" Padding="18,16" Margin="0,14,0,0">
                                            <StackPanel>
                                                <TextBlock Text="VOICEMEETER ROUTING" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <TextBlock Foreground="#A1B2D2" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,10"
                                                           Text="Live control of Voicemeeter strips — same switches the setup wizard used to offer."/>

                                                <Border Background="#22081428" CornerRadius="10" Padding="12,10" Margin="0,0,0,10"
                                                        BorderBrush="#338B5CF6" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="INPUT STRIP B1 (mic → Discord/teams)"
                                                                   Foreground="#C9D7F0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ToggleButton x:Name="AdvancedB1ToggleBtn"
                                                                          Content="Teammates (Input B1)"
                                                                          ClickMode="Press"
                                                                          Checked="AdvancedB1Toggle_Checked"
                                                                          Unchecked="AdvancedB1Toggle_Unchecked"
                                                                          Height="34"
                                                                          Background="#222A2A66" BorderBrush="#10B981"
                                                                          Foreground="#A7F3D0" Cursor="Hand" FontWeight="SemiBold" FontSize="12"
                                                                          ToolTip="Routes Input 1 to B1 — what people hear in Discord/teams">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#3310B981"/>
