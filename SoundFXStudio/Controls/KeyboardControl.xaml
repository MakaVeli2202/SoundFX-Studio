<UserControl x:Class="SoundFXStudio.Controls.KeyboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SoundFXStudio.Controls"
             xmlns:converters="clr-namespace:SoundFXStudio.Converters"
             xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore"
             Background="Transparent"
             Width="1512.6"
             Height="608"
             ClipToBounds="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:KeyboardLabelForegroundConverter x:Key="KeyboardLabelForegroundConverter" />
        <converters:InnerSectionMarginConverter x:Key="InnerSectionMarginConverter" />
        <converters:SizeToRectConverter x:Key="SizeToRectConverter" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F5F7FB" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <Border x:Name="GlowLayer"
                                    Margin="-2"
                                    CornerRadius="12"
                                    Background="Transparent"
                                    BorderBrush="#22D3FF"
                                    BorderThickness="2"
                                    Opacity="0"
                                    IsHitTestVisible="False" />

                            <Border x:Name="Frame"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                    Opacity="{TemplateBinding Opacity}" />

                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Margin="0"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter TargetName="GlowLayer" Property="Opacity" Value="1" />
                                <Setter TargetName="GlowLayer" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#22D3FF" BlurRadius="10" ShadowDepth="0" Opacity="0.7" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter TargetName="GlowLayer" Property="Opacity" Value="1" />
                                <Setter TargetName="GlowLayer" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#22D3FF" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <DataTrigger Binding="{Binding HasAssignment}" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter TargetName="Frame" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasAssignment}" Value="True">
                                <Setter Property="Opacity" Value="0.95" />
                                <Setter TargetName="Frame" Property="Opacity" Value="0.95" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter TargetName="GlowLayer" Property="Opacity" Value="1" />
                                <Setter TargetName="GlowLayer" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#FF4D8D" BlurRadius="10" ShadowDepth="0" Opacity="0.7" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                    <Condition Binding="{Binding CalibrationSelectionHighlight, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="GlowLayer" Property="Opacity" Value="1" />
                                <Setter TargetName="GlowLayer" Property="Margin" Value="0" />
                                <Setter TargetName="GlowLayer" Property="CornerRadius" Value="10" />
                                <Setter TargetName="GlowLayer" Property="BorderBrush" Value="#FF4D8D" />
                                <Setter TargetName="GlowLayer" Property="BorderThickness" Value="2" />
                                <Setter TargetName="GlowLayer" Property="Effect" Value="{x:Null}" />
                            </MultiDataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="Transparent"
            CornerRadius="0"
            BorderBrush="Transparent"
            BorderThickness="0"
            Padding="0">
                 <Grid Width="1536" Height="1024" Margin="-12.31,-179.69,0,0">
                     <Image Source="/Assets/Keyboards/SoundFXKeyBoard.png"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" />

                          <Canvas Width="1536"
                            Height="1024"
                            IsHitTestVisible="False"
                            Panel.ZIndex="50">
                           <Image Width="34"
                               Height="30"
                               Canvas.Left="{Binding DataContext.CapsLockIndicatorOffsetX, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Canvas.Top="{Binding DataContext.CapsLockIndicatorOffsetY, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Source="/Assets/Keyboards/LEDOFF.png"
                               Opacity="1">
                               <Image.Effect>
                                   <effects:DropShadowEffect Color="#22D3FF" BlurRadius="7" ShadowDepth="0" Opacity="0.9" />
                               </Image.Effect>
                           </Image>
                           <Image Width="34"
                               Height="30"
                               Canvas.Left="{Binding DataContext.NumLockIndicatorOffsetX, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Canvas.Top="{Binding DataContext.NumLockIndicatorOffsetY, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Source="/Assets/Keyboards/LEDOFF.png"
                               Opacity="1">
                               <Image.Effect>
                                   <effects:DropShadowEffect Color="#22D3FF" BlurRadius="7" ShadowDepth="0" Opacity="0.9" />
                               </Image.Effect>
                           </Image>
                           <Image Width="34"
                               Height="30"
                               Canvas.Left="{Binding DataContext.ScrollLockIndicatorOffsetX, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Canvas.Top="{Binding DataContext.ScrollLockIndicatorOffsetY, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Source="/Assets/Keyboards/LEDOFF.png"
                               Opacity="1">
                               <Image.Effect>
                                   <effects:DropShadowEffect Color="#22D3FF" BlurRadius="7" ShadowDepth="0" Opacity="0.9" />
                               </Image.Effect>
                           </Image>
                          </Canvas>

            <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Panel.ZIndex="1">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:KeyboardLayoutPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button AutomationProperties.AutomationId="{Binding Id}"
                            AutomationProperties.Name="{Binding AutomationName}"
                            Command="{Binding KeyClickedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">

                            <Grid ClipToBounds="True">
                                <Border CornerRadius="10"
                                        Background="#09000000"
                                        Opacity="0.06" />

                                <Grid Margin="1">
                                    <Border x:Name="FaceSectionBorder"
                                            CornerRadius="7"
                                            Background="#10000000"
                                            ClipToBounds="True">
                                        <Border.Clip>
                                            <RectangleGeometry RadiusX="7" RadiusY="7">
                                                <RectangleGeometry.Rect>
                                                    <MultiBinding Converter="{StaticResource SizeToRectConverter}">
                                                        <Binding ElementName="FaceSectionBorder" Path="ActualWidth" />
                                                        <Binding ElementName="FaceSectionBorder" Path="ActualHeight" />
                                                    </MultiBinding>
                                                </RectangleGeometry.Rect>
                                            </RectangleGeometry>
                                        </Border.Clip>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#3AFFFFFF"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                            <Condition Binding="{Binding CalibrationSelectionHighlight, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="BorderBrush" Value="#FF4D8D"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Margin>
                                            <MultiBinding Converter="{StaticResource InnerSectionMarginConverter}">
                                                <Binding RelativeSource="{RelativeSource AncestorType=Button}" Path="ActualWidth" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=Button}" Path="ActualHeight" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="InnerInsetXPercent" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="InnerInsetYPercent" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="InnerOffsetXPercent" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="InnerOffsetYPercent" />
                                                <Binding Path="InnerInsetAdjustmentPercent" />
                                                <Binding Path="InnerInsetXAdjustmentPercent" />
                                                <Binding Path="InnerInsetYAdjustmentPercent" />
                                                <Binding Path="InnerOffsetXAdjustmentPercent" />
                                                <Binding Path="InnerOffsetYAdjustmentPercent" />
                                            </MultiBinding>
                                        </Border.Margin>

                                        <Grid>
                                            <Border Opacity="0.95"
                                                    SnapsToDevicePixels="True"
                                                    Visibility="{Binding HasAssignment, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding ImagePath}"
                                                                Stretch="UniformToFill"
                                                                AlignmentX="Center"
                                                                AlignmentY="Center" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <StackPanel VerticalAlignment="Bottom"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,2"
                                            Visibility="{Binding HasAssignment, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding AssignedSoundName}"
                                               Foreground="#FFFFFFFF"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="2,0,2,0">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="0" Opacity="0.9" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>

                                <Grid Margin="6,4,6,4">
                                    <TextBlock Text="{Binding DisplayLabel}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Opacity="1">
                                        <TextBlock.Foreground>
                                            <MultiBinding Converter="{StaticResource KeyboardLabelForegroundConverter}">
                                                <Binding Path="State" />
                                                <Binding Path="DataContext.Settings.KeyboardPressedTextColor"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </TextBlock.Foreground>
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="0" Opacity="0.85" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>