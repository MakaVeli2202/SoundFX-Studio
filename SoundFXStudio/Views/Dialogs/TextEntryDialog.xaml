<Window x:Class="SoundFXStudio.Views.Dialogs.TextEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Text"
        Width="460"
        Height="250"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Assets/SoundFXStudioLogo.png">

    <Window.Resources>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#EAF1FF"/>

        <SolidColorBrush x:Key="MutedBrush"
                         Color="#A1B2D2"/>

        <Style x:Key="GlassPanel"
               TargetType="Border">

            <Setter Property="CornerRadius"
                    Value="24"/>

            <Setter Property="Background"
                    Value="{StaticResource SurfaceRaisedBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderAccentBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

        <Style x:Key="CyberButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#22112233"/>

            <Setter Property="BorderBrush"
                    Value="#338B5CF6"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#8B5CF6"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#228B5CF6"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#338B5CF6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            CornerRadius="28"
            ClipToBounds="True">

        <Border.BorderBrush>

            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,0">

                <GradientStop Color="#8B5CF6"
                              Offset="0"/>

                <GradientStop Color="#7C3AED"
                              Offset="1"/>

            </LinearGradientBrush>

        </Border.BorderBrush>

        <Border.BorderThickness>2</Border.BorderThickness>

        <Grid Margin="18">

            <Grid.RowDefinitions>

                <RowDefinition Height="80"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="70"/>

            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Border Grid.Row="0"
                    Style="{StaticResource GlassPanel}">

                <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0">

                        <Image Source="/Assets/UI/MainDashboardLogo.png"
                               Height="50"
                               Stretch="Uniform"/>

                        <StackPanel Margin="14,0,0,0">

                            <TextBlock Text="SOUNDFX STUDIO"
                                       Foreground="#8B5CF6"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding DialogTitle}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>

                        </StackPanel>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Height="40"
                            Margin="0,10,10,10"
                            Content="&#x2715;"
                            Background="#55203030"
                            BorderBrush="#8B5CF6"
                            Foreground="White"
                            Click="CloseButton_Click"/>

                </Grid>

            </Border>

            <!-- CONTENT -->

            <Border Grid.Row="1"
                    Style="{StaticResource GlassPanel}"
                    Margin="0,14,0,14">

                <StackPanel Margin="16">

                    <TextBlock Text="{Binding PromptText}"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <TextBox x:Name="ValueTextBox"
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             Background="#22112233"
                             BorderBrush="#338B5CF6"
                             BorderThickness="1"
                             Foreground="{StaticResource TextBrush}"/>

                </StackPanel>

            </Border>

            <!-- FOOTER -->

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Clear"
                        Margin="0,0,10,0"
                        Style="{StaticResource CyberButton}"
                        Visibility="{Binding ClearButtonVisibility}"
                        Click="ClearButton_Click"/>

                <Button Content="Cancel"
                        Margin="0,0,10,0"
                        Style="{StaticResource CyberButton}"
                        Click="CancelButton_Click"/>

                <Button Content="Save"
                        FontWeight="Bold"
                        Foreground="#081428"
                        Click="SaveButton_Click">

                    <Button.Background>

                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0">

                            <GradientStop Color="#8B5CF6"/>

                            <GradientStop Color="#7C3AED"/>

                        </LinearGradientBrush>

                    </Button.Background>

                </Button>

            </StackPanel>

        </Grid>

    </Border>

</Window>