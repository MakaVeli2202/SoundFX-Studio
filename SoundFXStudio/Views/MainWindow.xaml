                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ActionName}" Foreground="#DDEAFF" FontSize="12" FontWeight="SemiBold"/>
