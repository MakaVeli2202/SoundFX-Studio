<Window x:Class="SoundFXStudio.Views.Dialogs.KeyPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign to Key"
        Width="480"
        Height="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#081428" CornerRadius="20" ClipToBounds="True">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00D8FF" Offset="0"/>
                <GradientStop Color="#FF44CC" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.BorderThickness>2</Border.BorderThickness>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="ASSIGN TO KEY"
                       Foreground="#00D8FF" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Row="1"
                     x:Name="SearchBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Height="32" Margin="0,0,0,8"
                     Background="#44111A2E" BorderBrush="#5580CFFF"
                     Foreground="White" BorderThickness="1" Padding="8,4" FontSize="13"/>

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding FilteredKeys}"
                     SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0C1424" BorderBrush="#1B3157"
                                BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,4"
                                Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayLabel}"
                                           Foreground="#DDEAFF" FontSize="14" FontWeight="SemiBold"
                                           MinWidth="80"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AssignedSoundName}"
                                           Foreground="#A1B2D2" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding State}"
                                           Foreground="#00D8FF" FontSize="11"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancel" Width="100" Height="34" Margin="0,0,8,0"
                        Background="#22112233" BorderBrush="#3370AFFF" Foreground="White"
                        BorderThickness="1" Cursor="Hand" Click="CancelButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#00D8FF"/>
                                    <Setter TargetName="Bd" Property="Background" Value="#2200D8FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Assign" Width="110" Height="34"
                        Background="#1A2A4580" BorderBrush="#00D8FF" Foreground="White"
                        BorderThickness="1" FontWeight="Bold" Cursor="Hand" Click="AssignButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#00D8FF"/>
                                    <Setter TargetName="Bd" Property="Background" Value="#442A4580"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
