<Window x:Class="SoundFXStudio.Views.Dialogs.KeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign to Key"
        Width="420"
        Height="260"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#081428" CornerRadius="28" ClipToBounds="True" BorderThickness="2">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00D8FF" Offset="0"/>
                <GradientStop Color="#FF44CC" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="24" Background="#66081428" BorderBrush="#5580CFFF" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Image Source="/Assets/UI/MainDashboardLogo.png" Height="40" Stretch="Uniform"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="SOUNDFX STUDIO" Foreground="#00D8FF" FontWeight="Bold"/>
                            <TextBlock Text="Assign to Key" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="CloseButton" Width="36" Height="36" Content="&#x2715;"
                            Background="#55203030" BorderBrush="#FF5A7A" Foreground="White"
                            HorizontalAlignment="Right" Margin="0,8,8,8"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" CornerRadius="24" Background="#66081428" BorderBrush="#5580CFFF" BorderThickness="1" Margin="0,12,0,12">
                <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="InstructionText" Text="Press a key to assign..." FontSize="14" Foreground="#A1B2D2"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <Border x:Name="KeyDisplayBorder" Background="#22000000" BorderBrush="#3370AFFF" BorderThickness="1" CornerRadius="14" Padding="32,16">
                        <StackPanel>
                            <TextBlock x:Name="ModifierText" Text="" FontSize="14" Foreground="#FF44CC"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="CapturedKeyText" Text="-" FontSize="36" FontWeight="Bold" Foreground="#00D8FF"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ChordHintText" Text="" FontSize="12" Foreground="#8891B8"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="SaveButton" Content="Save" Width="100" Margin="0,0,10,0" IsDefault="True"
                        IsEnabled="False" Click="SaveButton_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00D8FF" Offset="0"/>
                            <GradientStop Color="#FF44CC" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="14"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="ClearButton" Content="Clear" Width="90" Margin="0,0,10,0" IsEnabled="False" Click="ClearButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Foreground" Value="#DDEAFF"/>
                            <Setter Property="Background" Value="#22112233"/>
                            <Setter Property="BorderBrush" Value="#5580CFFF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="14"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D8FF"/>
                                                <Setter TargetName="Bd" Property="Background" Value="#2200D8FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Cancel" Width="100" IsCancel="True" Click="CancelButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Foreground" Value="#DDEAFF"/>
                            <Setter Property="Background" Value="#22112233"/>
                            <Setter Property="BorderBrush" Value="#5580CFFF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="14"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D8FF"/>
                                                <Setter TargetName="Bd" Property="Background" Value="#2200D8FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
