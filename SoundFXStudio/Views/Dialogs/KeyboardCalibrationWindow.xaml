<Window x:Class="SoundFXStudio.Views.Dialogs.KeyboardCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundFXStudio.Controls"
        Title="Keyboard Calibration"
        Width="1400"
        Height="920"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="/Assets/SoundFXStudioLogo.png"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#9FB0CF"/>
        <SolidColorBrush x:Key="Cyan" Color="#00D4FF"/>
        <SolidColorBrush x:Key="DarkBg" Color="#080D17"/>
        <SolidColorBrush x:Key="CardBg" Color="#111827"/>
        <SolidColorBrush x:Key="CardBorder" Color="#324760"/>

        <Storyboard x:Key="CalibrationGlowPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="CalibrationGlow" Storyboard.TargetProperty="Opacity" From="0.2" To="0.42" Duration="0:0:2.2"/>
        </Storyboard>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#EAF1FF"/>
            <Setter Property="Background" Value="#0A1222"/>
            <Setter Property="BorderBrush" Value="#2E4568"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="64"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="NudgeBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#CFE0F5"/>
            <Setter Property="Background" Value="#16243B"/>
            <Setter Property="BorderBrush" Value="#35527A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D2F4A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5AD8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3F60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1A2A45"/>
            <Setter Property="BorderBrush" Value="#3A6A9F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#253A5A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#304A70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- nudge row: label left, buttons right -->
        <DataTemplate x:Key="NudgeRow">
            <Border Style="{StaticResource Card}" Padding="14,10" BorderBrush="#1E3050" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource NudgeBtn}" Content="▲"
                                Tag="{Binding DownTag}" Click="NudgeValue_Click"/>
                    <TextBlock Text="{Binding Value, Mode=OneWay}" 
                               Foreground="White" VerticalAlignment="Center" Width="56" TextAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="▼"
                                Tag="{Binding UpTag}" Click="NudgeValue_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Style="{StaticResource AppWindowRoot}"
            CornerRadius="24"
            BorderThickness="1.5">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Background="#101722" BorderBrush="#2A3D57" BorderThickness="0,0,0,1" CornerRadius="24,24,0,0">
                <Grid MouseLeftButtonDown="Window_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,14">
                        <Image Source="/Assets/UI/MainDashboardLogo.png" Height="44" Stretch="Uniform"/>
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="SOUNDFX STUDIO" FontWeight="Bold" Foreground="{StaticResource Cyan}" FontSize="11"/>
                            <TextBlock Text="Keyboard Calibration" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Dial in position, spacing, keycap fit, and overlay precision." FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Height="36" Margin="0,0,18,0"
                            Content="&#x2715;" FontSize="16"
                            Background="#301A2A45" BorderBrush="#4A5A7A" Foreground="White"
                            Click="CloseButton_Click" Cursor="Hand"/>
                </Grid>
            </Border>

            <Border x:Name="CalibrationGlow" Margin="2" BorderBrush="#3800D4FF" BorderThickness="1" CornerRadius="22" Opacity="0.2" IsHitTestVisible="False"/>

            <!-- BODY -->
            <Grid Grid.Row="1" Margin="0,10,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="500"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: SETTINGS -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,0,0,0">
                    <StackPanel Margin="0,0,6,0">

                        <!-- QUICK TIPS -->
                        <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12" Background="#0F1A2A" BorderBrush="#355378">
                            <StackPanel>
                                <TextBlock Text="Quick Tips" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                                <TextBlock Text="Use small nudges by default. Hold Shift while pressing nudge buttons for faster movement."
                                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="For the Open Keyboard overlay, step size is now fine-tuned for precise placement."
                                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12" Background="#121D2C" BorderBrush="#304A66">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="#00D4FF" Margin="0,0,7,0"/>
                                    <TextBlock Text="Position" FontSize="11.5" Foreground="#E6F4FF" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="#7B3FFF" Margin="0,0,7,0"/>
                                    <TextBlock Text="Shape" FontSize="11.5" Foreground="#D4E4F8" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Ellipse Width="9" Height="9" Fill="#22C55E" Margin="0,0,7,0"/>
                                    <TextBlock Text="Finalize" FontSize="11.5" Foreground="#D4E4F8" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 1. POSITION -->
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Position" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,0,0,14"/>

                                <TextBlock Text="Move keyboard left or right" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="-250" Maximum="250" Value="{Binding PreviewOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="1" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button Style="{StaticResource NudgeBtn}" Content="◀" Tag="PreviewOffsetX:-1" Click="NudgeValue_Click"/>
                                        <TextBlock Text="{Binding PreviewOffsetX, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" Width="56" TextAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                        <Button Style="{StaticResource NudgeBtn}" Content="▶" Tag="PreviewOffsetX:1" Click="NudgeValue_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Move keyboard up or down" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="-250" Maximum="250" Value="{Binding PreviewOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="1" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button Style="{StaticResource NudgeBtn}" Content="▲" Tag="PreviewOffsetY:-1" Click="NudgeValue_Click"/>
                                        <TextBlock Text="{Binding PreviewOffsetY, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" Width="56" TextAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                        <Button Style="{StaticResource NudgeBtn}" Content="▼" Tag="PreviewOffsetY:1" Click="NudgeValue_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Key size" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="20" Maximum="80" Value="{Binding PreviewKeyUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.5" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button Style="{StaticResource NudgeBtn}" Content="−" FontSize="18" Tag="PreviewKeyUnit:-0.5" Click="NudgeValue_Click"/>
                                        <TextBlock Text="{Binding PreviewKeyUnit, StringFormat='{}{0:F1}'}" VerticalAlignment="Center" Width="56" TextAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                        <Button Style="{StaticResource NudgeBtn}" Content="+" FontSize="18" Tag="PreviewKeyUnit:0.5" Click="NudgeValue_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Button size" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0.4" Maximum="1.6" Value="{Binding PreviewButtonScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.05" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button Style="{StaticResource NudgeBtn}" Content="−" FontSize="18" Tag="PreviewButtonScale:-0.05" Click="NudgeValue_Click"/>
                                        <TextBlock Text="{Binding PreviewButtonScale, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" Width="56" TextAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                        <Button Style="{StaticResource NudgeBtn}" Content="+" FontSize="18" Tag="PreviewButtonScale:0.05" Click="NudgeValue_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. SPACING & INSIDE -->
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Spacing" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,0,0,14"/>

                                <TextBlock Text="Gap between keys" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="-10" Maximum="20" Value="{Binding PreviewGapX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.25" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button Style="{StaticResource NudgeBtn}" Content="−" FontSize="18" Tag="PreviewGapX:-0.25" Click="NudgeValue_Click"/>
                                        <TextBlock Text="{Binding PreviewGapX, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" Width="56" TextAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                        <Button Style="{StaticResource NudgeBtn}" Content="+" FontSize="18" Tag="PreviewGapX:0.25" Click="NudgeValue_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Gap between rows" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="-10" Maximum="20" Value="{Binding PreviewGapY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.25" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button Style="{StaticResource NudgeBtn}" Content="−" FontSize="18" Tag="PreviewGapY:-0.25" Click="NudgeValue_Click"/>
                                        <TextBlock Text="{Binding PreviewGapY, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" Width="56" TextAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                        <Button Style="{StaticResource NudgeBtn}" Content="+" FontSize="18" Tag="PreviewGapY:0.25" Click="NudgeValue_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Key face width" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="45" Value="{Binding PreviewInnerInsetXPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="1" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button Style="{StaticResource NudgeBtn}" Content="−" FontSize="18" Tag="PreviewInnerInsetXPercent:-1" Click="NudgeValue_Click"/>
                                        <TextBlock Text="{Binding PreviewInnerInsetXPercent, StringFormat='{}{0:F0}%'}" VerticalAlignment="Center" Width="56" TextAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                        <Button Style="{StaticResource NudgeBtn}" Content="+" FontSize="18" Tag="PreviewInnerInsetXPercent:1" Click="NudgeValue_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Key face height" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="45" Value="{Binding PreviewInnerInsetYPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="1" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button Style="{StaticResource NudgeBtn}" Content="−" FontSize="18" Tag="PreviewInnerInsetYPercent:-1" Click="NudgeValue_Click"/>
                                        <TextBlock Text="{Binding PreviewInnerInsetYPercent, StringFormat='{}{0:F0}%'}" VerticalAlignment="Center" Width="56" TextAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                        <Button Style="{StaticResource NudgeBtn}" Content="+" FontSize="18" Tag="PreviewInnerInsetYPercent:1" Click="NudgeValue_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Face shift sideways" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="-30" Maximum="30" Value="{Binding PreviewInnerOffsetXPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="1" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button Style="{StaticResource NudgeBtn}" Content="◀" Tag="PreviewInnerOffsetXPercent:-1" Click="NudgeValue_Click"/>
                                        <TextBlock Text="{Binding PreviewInnerOffsetXPercent, StringFormat='{}{0:F0}%'}" VerticalAlignment="Center" Width="56" TextAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                        <Button Style="{StaticResource NudgeBtn}" Content="▶" Tag="PreviewInnerOffsetXPercent:1" Click="NudgeValue_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Face shift up/down" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="-30" Maximum="30" Value="{Binding PreviewInnerOffsetYPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="1" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button Style="{StaticResource NudgeBtn}" Content="▲" Tag="PreviewInnerOffsetYPercent:-1" Click="NudgeValue_Click"/>
                                        <TextBlock Text="{Binding PreviewInnerOffsetYPercent, StringFormat='{}{0:F0}%'}" VerticalAlignment="Center" Width="56" TextAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                        <Button Style="{StaticResource NudgeBtn}" Content="▼" Tag="PreviewInnerOffsetYPercent:1" Click="NudgeValue_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. LAMPS -->
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Lock Indicators" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,0,0,6"/>
                                <TextBlock Text="Position the Caps / Num / Scroll lock lights" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14"/>

                                <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8" Background="#0D1525">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Num Lock" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource NudgeBtn}" Content="◀" Tag="NumLockIndicatorOffsetX:-1" Click="NudgeValue_Click"/>
                                            <TextBlock Text="{Binding NumLockIndicatorOffsetX, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                            <Button Style="{StaticResource NudgeBtn}" Content="▶" Tag="NumLockIndicatorOffsetX:1" Click="NudgeValue_Click" Margin="4,0,10,0"/>
                                            <Button Style="{StaticResource NudgeBtn}" Content="▲" Tag="NumLockIndicatorOffsetY:-1" Click="NudgeValue_Click"/>
                                            <TextBlock Text="{Binding NumLockIndicatorOffsetY, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                            <Button Style="{StaticResource NudgeBtn}" Content="▼" Tag="NumLockIndicatorOffsetY:1" Click="NudgeValue_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8" Background="#0D1525">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Caps Lock" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource NudgeBtn}" Content="◀" Tag="CapsLockIndicatorOffsetX:-1" Click="NudgeValue_Click"/>
                                            <TextBlock Text="{Binding CapsLockIndicatorOffsetX, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                            <Button Style="{StaticResource NudgeBtn}" Content="▶" Tag="CapsLockIndicatorOffsetX:1" Click="NudgeValue_Click" Margin="4,0,10,0"/>
                                            <Button Style="{StaticResource NudgeBtn}" Content="▲" Tag="CapsLockIndicatorOffsetY:-1" Click="NudgeValue_Click"/>
                                            <TextBlock Text="{Binding CapsLockIndicatorOffsetY, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                            <Button Style="{StaticResource NudgeBtn}" Content="▼" Tag="CapsLockIndicatorOffsetY:1" Click="NudgeValue_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="14,10" Background="#0D1525">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Scroll Lock" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource NudgeBtn}" Content="◀" Tag="ScrollLockIndicatorOffsetX:-1" Click="NudgeValue_Click"/>
                                            <TextBlock Text="{Binding ScrollLockIndicatorOffsetX, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                            <Button Style="{StaticResource NudgeBtn}" Content="▶" Tag="ScrollLockIndicatorOffsetX:1" Click="NudgeValue_Click" Margin="4,0,10,0"/>
                                            <Button Style="{StaticResource NudgeBtn}" Content="▲" Tag="ScrollLockIndicatorOffsetY:-1" Click="NudgeValue_Click"/>
                                            <TextBlock Text="{Binding ScrollLockIndicatorOffsetY, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                            <Button Style="{StaticResource NudgeBtn}" Content="▼" Tag="ScrollLockIndicatorOffsetY:1" Click="NudgeValue_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 4. GROUPS -->
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Key Groups" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,0,0,6"/>
                                <TextBlock Text="Reposition and resize entire groups at once" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14"/>

                                <ItemsControl ItemsSource="{Binding ClusterItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8" Background="#0D1525">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#D7E3F5" Margin="0,0,0,8"/>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="X" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource NudgeBtn}" Content="◀" Tag="OffsetX:-1" Click="NudgeValue_Click"/>
                                                            <TextBlock Text="{Binding OffsetX, StringFormat='{}{0:F0}'}" Foreground="White" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                                            <Button Style="{StaticResource NudgeBtn}" Content="▶" Tag="OffsetX:1" Click="NudgeValue_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Y" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource NudgeBtn}" Content="▲" Tag="OffsetY:-1" Click="NudgeValue_Click"/>
                                                            <TextBlock Text="{Binding OffsetY, StringFormat='{}{0:F0}'}" Foreground="White" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                                            <Button Style="{StaticResource NudgeBtn}" Content="▼" Tag="OffsetY:1" Click="NudgeValue_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Width" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource NudgeBtn}" Content="−" FontSize="18" Tag="WidthAdjustment:-1" Click="NudgeValue_Click"/>
                                                            <TextBlock Text="{Binding WidthAdjustment, StringFormat='{}{0:F0}'}" Foreground="White" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                                            <Button Style="{StaticResource NudgeBtn}" Content="+" FontSize="18" Tag="WidthAdjustment:1" Click="NudgeValue_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Height" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource NudgeBtn}" Content="−" FontSize="18" Tag="HeightAdjustment:-1" Click="NudgeValue_Click"/>
                                                            <TextBlock Text="{Binding HeightAdjustment, StringFormat='{}{0:F0}'}" Foreground="White" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                                            <Button Style="{StaticResource NudgeBtn}" Content="+" FontSize="18" Tag="HeightAdjustment:1" Click="NudgeValue_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Button Content="Reset" Click="ResetSelectedCluster_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Height="28" Padding="14,0" FontSize="11" Cursor="Hand" Background="#1A2A45" BorderBrush="#3A5A7A" Foreground="#D7E3F5" BorderThickness="1"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 5. OPEN KEYBOARD BUTTON -->
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Open Keyboard Button" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,0,0,6"/>
                                <TextBlock Text="Position and size the transparent main-window overlay button" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14"/>
                                <TextBlock Text="Fine mode: 1px / 1 unit. Hold Shift for faster movement." Foreground="#B7C6E0" FontSize="11" Margin="0,0,0,10"/>

                                <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8" Background="#0D1525">
                                    <StackPanel>
                                        <TextBlock Text="Position X" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="0" Maximum="1500" Value="{Binding OpenKeyboardButtonX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SmallChange="0.1" LargeChange="1" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                <Button Style="{StaticResource NudgeBtn}" Content="◀" Tag="OpenKeyboardButtonX:-1" Click="NudgeValue_Click"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="−0.1" Tag="OpenKeyboardButtonX:-0.1" Click="NudgeValue_Click"/>
                                                <TextBlock Text="{Binding OpenKeyboardButtonX, StringFormat='{}{0:F1}'}" VerticalAlignment="Center" Width="60" TextAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="+0.1" Tag="OpenKeyboardButtonX:0.1" Click="NudgeValue_Click"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="▶" Tag="OpenKeyboardButtonX:1" Click="NudgeValue_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8" Background="#0D1525">
                                    <StackPanel>
                                        <TextBlock Text="Position Y" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="0" Maximum="1200" Value="{Binding OpenKeyboardButtonY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SmallChange="0.1" LargeChange="1" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                <Button Style="{StaticResource NudgeBtn}" Content="▲" Tag="OpenKeyboardButtonY:-1" Click="NudgeValue_Click"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="−0.1" Tag="OpenKeyboardButtonY:-0.1" Click="NudgeValue_Click"/>
                                                <TextBlock Text="{Binding OpenKeyboardButtonY, StringFormat='{}{0:F1}'}" VerticalAlignment="Center" Width="60" TextAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="+0.1" Tag="OpenKeyboardButtonY:0.1" Click="NudgeValue_Click"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="▼" Tag="OpenKeyboardButtonY:1" Click="NudgeValue_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8" Background="#0D1525">
                                    <StackPanel>
                                        <TextBlock Text="Width" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="100" Maximum="600" Value="{Binding OpenKeyboardButtonWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SmallChange="0.1" LargeChange="1" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                <Button Style="{StaticResource NudgeBtn}" Content="−" FontSize="18" Tag="OpenKeyboardButtonWidth:-1" Click="NudgeValue_Click"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="−0.1" Tag="OpenKeyboardButtonWidth:-0.1" Click="NudgeValue_Click"/>
                                                <TextBlock Text="{Binding OpenKeyboardButtonWidth, StringFormat='{}{0:F1}'}" VerticalAlignment="Center" Width="60" TextAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="+0.1" Tag="OpenKeyboardButtonWidth:0.1" Click="NudgeValue_Click"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="+" FontSize="18" Tag="OpenKeyboardButtonWidth:1" Click="NudgeValue_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8" Background="#0D1525">
                                    <StackPanel>
                                        <TextBlock Text="Height" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="20" Maximum="200" Value="{Binding OpenKeyboardButtonHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SmallChange="0.1" LargeChange="1" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                <Button Style="{StaticResource NudgeBtn}" Content="−" FontSize="18" Tag="OpenKeyboardButtonHeight:-1" Click="NudgeValue_Click"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="−0.1" Tag="OpenKeyboardButtonHeight:-0.1" Click="NudgeValue_Click"/>
                                                <TextBlock Text="{Binding OpenKeyboardButtonHeight, StringFormat='{}{0:F1}'}" VerticalAlignment="Center" Width="60" TextAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="+0.1" Tag="OpenKeyboardButtonHeight:0.1" Click="NudgeValue_Click"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="+" FontSize="18" Tag="OpenKeyboardButtonHeight:1" Click="NudgeValue_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Button Content="Reset" Click="ResetOpenKeyboardButton_Click" HorizontalAlignment="Left" Height="30" Padding="14,0" FontSize="12" Cursor="Hand" Background="#1A2A45" BorderBrush="#3A5A7A" Foreground="#D7E3F5" BorderThickness="1"/>
                            </StackPanel>
                        </Border>

                        <!-- 6. PER KEY -->
                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Individual Keys" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,0,0,6"/>
                                <TextBlock Text="Click a key in the preview, then tweak" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14"/>
                                <TextBlock Text="{Binding SelectedKeyItem.Name, TargetNullValue='Click a key in the preview'}" FontWeight="SemiBold" FontSize="14" Foreground="#5AD8FF" Margin="0,0,0,12"/>

                                <StackPanel DataContext="{Binding SelectedKeyItem}">
                                    <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6" Background="#0D1525">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Shift X" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource NudgeBtn}" Content="◀" Tag="OffsetX:-1" Click="NudgeValue_Click"/>
                                                <TextBlock Text="{Binding OffsetX, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="▶" Tag="OffsetX:1" Click="NudgeValue_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6" Background="#0D1525">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Shift Y" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource NudgeBtn}" Content="▲" Tag="OffsetY:-1" Click="NudgeValue_Click"/>
                                                <TextBlock Text="{Binding OffsetY, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="▼" Tag="OffsetY:1" Click="NudgeValue_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6" Background="#0D1525">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Width" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource NudgeBtn}" Content="−" FontSize="18" Tag="WidthAdjustment:-0.1" Click="NudgeValue_Click"/>
                                                <TextBlock Text="{Binding WidthAdjustment, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="+" FontSize="18" Tag="WidthAdjustment:0.1" Click="NudgeValue_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6" Background="#0D1525">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Height" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource NudgeBtn}" Content="−" FontSize="18" Tag="HeightAdjustment:-0.1" Click="NudgeValue_Click"/>
                                                <TextBlock Text="{Binding HeightAdjustment, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="+" FontSize="18" Tag="HeightAdjustment:0.1" Click="NudgeValue_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6" Background="#0D1525">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Face W" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource NudgeBtn}" Content="−" FontSize="18" Tag="InnerInsetXAdjustmentPercent:-1" Click="NudgeValue_Click"/>
                                                <TextBlock Text="{Binding InnerInsetXAdjustmentPercent, StringFormat='{}{0:F0}%'}" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="+" FontSize="18" Tag="InnerInsetXAdjustmentPercent:1" Click="NudgeValue_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6" Background="#0D1525">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Face H" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource NudgeBtn}" Content="−" FontSize="18" Tag="InnerInsetYAdjustmentPercent:-1" Click="NudgeValue_Click"/>
                                                <TextBlock Text="{Binding InnerInsetYAdjustmentPercent, StringFormat='{}{0:F0}%'}" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="+" FontSize="18" Tag="InnerInsetYAdjustmentPercent:1" Click="NudgeValue_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6" Background="#0D1525">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Face ⇔" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource NudgeBtn}" Content="◀" Tag="InnerOffsetXAdjustmentPercent:-1" Click="NudgeValue_Click"/>
                                                <TextBlock Text="{Binding InnerOffsetXAdjustmentPercent, StringFormat='{}{0:F0}%'}" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="▶" Tag="InnerOffsetXAdjustmentPercent:1" Click="NudgeValue_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="#1E3050" BorderThickness="1" CornerRadius="10" Padding="12,8" Background="#0D1525">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Face ⇅" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource NudgeBtn}" Content="▲" Tag="InnerOffsetYAdjustmentPercent:-1" Click="NudgeValue_Click"/>
                                                <TextBlock Text="{Binding InnerOffsetYAdjustmentPercent, StringFormat='{}{0:F0}%'}" VerticalAlignment="Center" Width="50" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                                <Button Style="{StaticResource NudgeBtn}" Content="▼" Tag="InnerOffsetYAdjustmentPercent:1" Click="NudgeValue_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Button Content="Reset This Key" Margin="0,12,0,0" Click="ResetSelectedKey_Click" Height="32" FontSize="12" Cursor="Hand" Background="#1A2A45" BorderBrush="#3A5A7A" Foreground="#D7E3F5" BorderThickness="1" HorizontalAlignment="Left" Padding="16,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- RIGHT: PREVIEW -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Preview" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Cyan}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                <Button Style="{StaticResource NudgeBtn}" Content="−" FontSize="16" Click="ZoomOut_Click" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:0}%'}" VerticalAlignment="Center" Width="44" TextAlignment="Center" FontSize="13" Foreground="{StaticResource Muted}"/>
                                <Button Style="{StaticResource NudgeBtn}" Content="+" FontSize="16" Click="ZoomIn_Click" Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="1" Margin="0,0,0,10" Background="#060C18" BorderBrush="#1A2A45" BorderThickness="1" CornerRadius="12" Padding="6">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Viewbox Stretch="Uniform" x:Name="PreviewViewbox" MinWidth="200" MinHeight="100">
                                    <controls:KeyboardControl x:Name="PreviewKeyboard"
                                                              ItemsSource="{Binding KeyboardKeys}"
                                                              ButtonScale="{Binding PreviewButtonScale}"
                                                              CalibrationSelectionHighlight="True"
                                                              InnerInsetXPercent="{Binding PreviewInnerInsetXPercent}"
                                                              InnerInsetYPercent="{Binding PreviewInnerInsetYPercent}"
                                                              InnerOffsetXPercent="{Binding PreviewInnerOffsetXPercent}"
                                                              InnerOffsetYPercent="{Binding PreviewInnerOffsetYPercent}"
                                                              KeyClickedCommand="{Binding KeyClickedCommand}"/>
                                </Viewbox>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Row="2" Margin="0,0,0,10" Background="#0F1A2B" BorderBrush="#2D455F" BorderThickness="1" CornerRadius="14" Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Open Keyboard Button" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Cyan}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Click the rectangle to select, then tweak it below" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <Grid x:Name="OverlayPreviewHost" Width="340" Height="190" Background="#060C18" ClipToBounds="True" HorizontalAlignment="Left">
                                    <Grid x:Name="OverlayPreviewStage" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
                                        <Image Source="/Assets/UI/HeroSection.png" Stretch="UniformToFill" Opacity="0.35"/>
                                        <Button x:Name="OverlayPreviewButton"
                                                Click="OverlayPreviewButton_Click"
                                                Cursor="Hand"
                                                PreviewMouseLeftButtonDown="OverlayPreviewButton_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="OverlayPreviewButton_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="OverlayPreviewButton_PreviewMouseLeftButtonUp"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="OverlayPreviewRect" CornerRadius="6" Background="#33000000" BorderBrush="#33AAFFFF" BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="OverlayPreviewRect" Property="BorderBrush" Value="#88AAFFFF"/>
                                                        <Setter TargetName="OverlayPreviewRect" Property="Background" Value="#22FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Button Style="{StaticResource ActionBtn}" Content="Reset All" Margin="0,0,10,0" Click="ResetAll_Click"/>
                            <Button Style="{StaticResource ActionBtn}" Content="💾 Save" Margin="0,0,10,0" Click="SavePermanently_Click"/>
                            <Button Style="{StaticResource ActionBtn}" Content="Close" Click="CloseButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource CalibrationGlowPulse}"/>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</Window>