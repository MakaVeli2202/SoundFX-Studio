                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSectionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Keybinds">
                                                    <Setter Property="Background" Value="#228B5CF6"/>
                                                    <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="26" VerticalAlignment="Center"/>
                                        <TextBlock Text="Keybinds" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="SettingsSectionAdvancedButton" Tag="Advanced" Click="SettingsSectionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSectionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Advanced">
                                                    <Setter Property="Background" Value="#228B5CF6"/>
                                                    <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7C4;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="26" VerticalAlignment="Center"/>
                                        <TextBlock Text="Advanced" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- ═══ SETTINGS CONTENT ═══ -->
                        <Border Grid.Column="1" Background="#0C1424" BorderBrush="#1B3157"
                                BorderThickness="1" CornerRadius="14" Margin="6,12,12,12">
                            <Grid>

                                <!-- ══ GENERAL ══ -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="General">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Margin="24">
                                        <TextBlock x:Name="SettingsGeneralHeader"
                                                   Text="GENERAL" Foreground="#8B5CF6" FontSize="16" FontWeight="Bold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Foreground="#7F899C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"
                                                   Text="Startup and app behavior."/>

                                        <Border Background="#66081428" BorderBrush="#558B5CF6" BorderThickness="1"
                                            CornerRadius="12" Padding="18,16">
                                            <StackPanel>
                                                <CheckBox x:Name="ShowWizardOnStartupCheck"
                                                          Content="Show setup wizard on startup"
                                                          IsChecked="{Binding Settings.ShowSetupWizardOnStartup, Mode=TwoWay}"
                                                          Foreground="#DDEAFF" FontSize="12" Margin="0,0,0,10"/>
                                                <CheckBox x:Name="StartMinimizedCheck"
                                                          Content="Start minimized to tray"
                                                          IsChecked="{Binding Settings.StartMinimized, Mode=TwoWay}"
                                                          Foreground="#DDEAFF" FontSize="12"/>
                                                <TextBlock Foreground="#7F899C" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                                                           Text="Voicemeeter hear/talk selection, routing and reset live in the Setup Wizard."/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- ══ AUDIO ══ -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Audio">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Margin="24">
                                        <TextBlock x:Name="SettingsAudioHeader"
                                                   Text="AUDIO DEVICES" Foreground="#8B5CF6" FontSize="16" FontWeight="Bold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Foreground="#7F899C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"
                                                   Text="Where SoundFX plays sounds and where your voice comes from."/>

                                        <Border Background="#66081428" BorderBrush="#558B5CF6"
                                            BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,0,16">
                                            <Grid>
