<Window x:Class="SoundFXStudio.Views.Dialogs.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundFXStudio.Controls"
        Title="SoundFX Studio Setup"
        Width="980"
        Height="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#141E2D"
        Icon="/Assets/SoundFXStudioLogo.png">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#EAF1FF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AAFD0"/>

        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Background" Value="#C0141E2D"/>
            <Setter Property="BorderBrush" Value="#334A647F"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="InnerCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#CC141E2D"/>
            <Setter Property="BorderBrush" Value="#334A647F"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1A2435"/>
            <Setter Property="BorderBrush" Value="#4A00D4FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2200D4FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D4FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A00D4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeroButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="190"/>
            <Setter Property="Foreground" Value="#080D17"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00D4FF" Offset="0"/>
                                    <GradientStop Color="#7B3FFF" Offset="0.6"/>
                                    <GradientStop Color="#FF2DAF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D9F8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Foreground" Value="#FFE3E3"/>
            <Setter Property="Background" Value="#2B1A1A"/>
            <Setter Property="BorderBrush" Value="#8A3A3A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A2020"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E05B5B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5A2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#B3102A3A"/>
        </Style>

        <Storyboard x:Key="StepFlowPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="StepArrow1" Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1" Duration="0:0:0.9" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="StepArrow2" Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1" Duration="0:0:0.9" AutoReverse="True" BeginTime="0:0:0.45"/>
            <DoubleAnimation Storyboard.TargetName="StepBadge2" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.75" Duration="0:0:0.9" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="StepBadge3" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.75" Duration="0:0:0.9" AutoReverse="True" BeginTime="0:0:0.45"/>
        </Storyboard>

    </Window.Resources>

    <Border Background="#B3080D17" CornerRadius="30" ClipToBounds="True" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00D4FF" Offset="0"/>
                <GradientStop Color="#7B3FFF" Offset="0.55"/>
                <GradientStop Color="#FF2DAF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>
            <!-- Inset background image: rounded to match the window curve so edges are smooth -->
            <Border Margin="5" CornerRadius="25">
                <Border.Background>
                    <ImageBrush ImageSource="/Assets/Pics/MainWindowBackground.png"
                                Stretch="UniformToFill"
                                Opacity="0.62"/>
                </Border.Background>
            </Border>

            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="88"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="SOUNDFX STUDIO" Foreground="#9CEBFF" FontSize="10.5" FontWeight="Bold"/>
                        <TextBlock Text="SET UP YOUR SOUNDBOARD" Margin="0,6,0,0" Foreground="White" FontSize="25" FontWeight="Bold">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="Pick your devices, hit configure, you're good to go." Margin="0,3,0,0" Foreground="#BCD0EC" FontSize="12"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                        <Border x:Name="VmStatusBadge" Background="#C0141E2D" BorderBrush="#334A647F"
                                BorderThickness="1" CornerRadius="12" Padding="14,6" VerticalAlignment="Center">
                            <Ellipse x:Name="VmStatusDot" Width="9" Height="9" Fill="#22C55E" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Content -->
                <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Margin="10,12,10,0" Padding="20,16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Animated step flow: Choose Devices → Auto Configure → Ready to Play -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Step 1 -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <Border x:Name="StepBadge1" Style="{StaticResource StepBadge}" BorderBrush="#00D4FF"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="1" Foreground="#BFF4FF" FontSize="18" FontWeight="Black"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="CHOOSE DEVICES" Margin="0,8,0,0" Foreground="White" FontSize="12.5"
                                               FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Your speakers &amp; mic" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}"
                                               FontSize="10.5" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Arrow 1 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0">
                                    <TextBlock x:Name="StepArrow1" Text="➜" Foreground="#00D4FF" FontSize="22"
                                               FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#00D4FF" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Step 2 -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <Border x:Name="StepBadge2" Style="{StaticResource StepBadge}" BorderBrush="#7B3FFF"
                                            HorizontalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#7B3FFF" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                                        </Border.Effect>
                                        <TextBlock Text="2" Foreground="#E0D2FF" FontSize="18" FontWeight="Black"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="AUTO CONFIGURE" Margin="0,8,0,0" Foreground="White" FontSize="12.5"
                                               FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="One click to wire everything up" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}"
                                               FontSize="10.5" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Arrow 2 -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0">
                                    <TextBlock x:Name="StepArrow2" Text="➜" Foreground="#FF2DAF" FontSize="22"
                                               FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#FF2DAF" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Step 3 -->
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                    <Border x:Name="StepBadge3" Style="{StaticResource StepBadge}" BorderBrush="#22C55E"
                                            HorizontalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#22C55E" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                                        </Border.Effect>
                                        <TextBlock Text="3" Foreground="#95EAB1" FontSize="18" FontWeight="Black"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="READY TO PLAY" Margin="0,8,0,0" Foreground="White" FontSize="12.5"
                                               FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="You're all set" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}"
                                               FontSize="10.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Device selection -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource InnerCard}" Padding="16,13" Margin="0,0,8,0">
                                    <StackPanel>
                                        <Border HorizontalAlignment="Left" CornerRadius="7" Padding="8,3"
                                                Background="#3300D4FF" BorderBrush="#00D4FF" BorderThickness="1">
                                            <TextBlock Text="OUT" Foreground="#BFF4FF" FontFamily="Consolas" FontWeight="Bold" FontSize="10.5"/>
                                        </Border>
                                        <TextBlock Text="OUTPUT DEVICE" Margin="0,7,0,0" Foreground="White" FontSize="13.5" FontWeight="Bold"/>
                                        <TextBlock Text="What you hear game audio through." Margin="0,2,0,7" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                        <ComboBox x:Name="WizardHearCombo"
                                                  DisplayMemberPath="Name"
                                                  FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource InnerCard}" Padding="16,13" Margin="8,0,0,0">
                                    <StackPanel>
                                        <Border HorizontalAlignment="Left" CornerRadius="7" Padding="8,3"
                                                Background="#337B3FFF" BorderBrush="#7B3FFF" BorderThickness="1">
                                            <TextBlock Text="MIC" Foreground="#E0D2FF" FontFamily="Consolas" FontWeight="Bold" FontSize="10.5"/>
                                        </Border>
                                        <TextBlock Text="INPUT DEVICE" Margin="0,7,0,0" Foreground="White" FontSize="13.5" FontWeight="Bold"/>
                                        <TextBlock Text="Your microphone." Margin="0,2,0,7" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                        <ComboBox x:Name="WizardTalkCombo"
                                                  DisplayMemberPath="Name"
                                                  FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Auto configure group box -->
                            <Border Style="{StaticResource InnerCard}" Margin="0,16,0,0" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="AUTO CONFIGURE" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="One click to wire your mic and speakers. No manual setup needed."
                                               Margin="0,5,0,12" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="WizardAutoSetupBtn"
                                                Style="{StaticResource HeroButton}"
                                                Width="235"
                                                Height="46"
                                                Click="WizardAutoSetup_Click"
                                                Content="AUTO CONFIGURE"/>
                                        <Button x:Name="WizardResetWindowsBtn"
                                                Style="{StaticResource DangerButton}"
                                                Width="200"
                                                Height="46"
                                                Margin="12,0,0,0"
                                                Click="WizardResetWindows_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="↺" FontSize="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="RESET AUDIO" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Log output -->
                            <Border Background="#AA0F1623" BorderBrush="#2A384E" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="LOG OUTPUT" Foreground="#00D4FF" FontSize="10.5" FontWeight="Bold"/>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#334A647F" VerticalAlignment="Center"/>
                                            <TextBlock Text="SYSTEM LOG" Margin="6,0,0,0" Foreground="#5A6E8A" FontSize="10" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="#263648" Margin="0,7,0,0"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="84">
                                        <StackPanel>
                                            <TextBlock x:Name="VmSetupStatus"
                                                       Margin="0,7,0,0"
                                                       Foreground="#22C55E"
                                                       FontFamily="Consolas"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock x:Name="WizardStatusText"
                                                       Margin="0,4,0,0"
                                                       Foreground="#A8C0E0"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Footer -->
                <Border Grid.Row="2" Margin="10,12,10,0" Style="{StaticResource GlassPanel}" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="DontShowAgainCheckBox"
                                  VerticalAlignment="Center"
                                  Content="Skip setup next time"
                                  Foreground="#DDEAFF"
                                  FontSize="12"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="OPEN WINDOWS SOUND"
                                    Width="185"
                                    Style="{StaticResource CyberButton}"
                                    Click="OpenSound_Click"/>

                            <Button Style="{StaticResource HeroButton}"
                                    Width="200"
                                    Margin="12,0,0,0"
                                    Click="Finish_Click"
                                    Content="LET'S GO"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource StepFlowPulse}"/>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</Window>
