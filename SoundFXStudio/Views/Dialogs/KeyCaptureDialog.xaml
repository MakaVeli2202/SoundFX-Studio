<Window x:Class="SoundFXStudio.Views.Dialogs.KeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign to Key"
        Width="460"
        Height="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <Storyboard x:Key="ListeningPulse"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <DoubleAnimation
                Storyboard.TargetName="KeyDisplayBorder"
                Storyboard.TargetProperty="Opacity"
                From="0.88"
                To="1"
                Duration="0:0:1.2"/>

        </Storyboard>

    </Window.Resources>

    <Border Style="{StaticResource AppWindowRoot}">

        <Grid Margin="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Border Grid.Row="0"
                    Background="#111C2E"
                    BorderBrush="#2F4668"
                    BorderThickness="1"
                    CornerRadius="18">

                <Grid>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0">

                        <Image Source="/Assets/UI/MainDashboardLogo.png"
                               Height="30"/>

                        <StackPanel Margin="10,0,0,0">

                            <TextBlock Text="SOUNDFX STUDIO"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#00D4FF"/>

                            <TextBlock Text="Assign To Key"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#EAF1FF"/>

                        </StackPanel>

                    </StackPanel>

                    <Button x:Name="CloseButton"
                            Content="✕"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click"
                            Style="{StaticResource DialogCloseButtonStyle}"/>

                </Grid>

            </Border>

            <!-- MAIN CONTENT -->

            <Border Grid.Row="1"
                    Margin="0,12,0,12"
                    Background="#101A2B"
                    BorderBrush="#2F4668"
                    BorderThickness="1"
                    CornerRadius="20">

                <StackPanel Margin="20"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="InstructionText"
                               Text="Press a key to assign..."
                               HorizontalAlignment="Center"
                               FontSize="13"
                               Foreground="#9AAFD0"
                               Margin="0,0,0,10"/>

                    <Border x:Name="KeyDisplayBorder"
                            Height="90"
                            BorderThickness="2"
                            CornerRadius="18"
                            Background="#151F2E"
                            BorderBrush="#2E6BFF">

                        <Border.Effect>
                            <DropShadowEffect Color="#1D4ED8"
                                              BlurRadius="14"
                                              ShadowDepth="0"
                                              Opacity="0.16"/>
                        </Border.Effect>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock x:Name="ModifierText"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#7B3FFF"/>

                            <TextBlock x:Name="CapturedKeyText"
                                       Text="-"
                                       HorizontalAlignment="Center"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#00D4FF"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Border>

                    <TextBlock x:Name="ChordHintText"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               FontSize="11"
                               Foreground="#9AAFD0"/>

                </StackPanel>

            </Border>

            <!-- FOOTER -->

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="SaveButton"
                        Content="Save"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="SaveButton_Click"
                        Style="{StaticResource PrimaryGradientButtonStyle}"/>

                <Button x:Name="ClearButton"
                        Content="Clear"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="ClearButton_Click"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Height="40" MinWidth="100"/>

                <Button Content="Cancel"
                        IsCancel="True"
                        Click="CancelButton_Click"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Height="40" MinWidth="100"/>

            </StackPanel>

        </Grid>

        <Border.Triggers>

            <EventTrigger RoutedEvent="FrameworkElement.Loaded">

                <BeginStoryboard Storyboard="{StaticResource ListeningPulse}"/>

            </EventTrigger>

        </Border.Triggers>

    </Border>

</Window>