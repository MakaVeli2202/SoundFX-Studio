                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="AUDIO SETUP" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                                    <TextBlock Foreground="#A1B2D2" FontSize="10.5" TextWrapping="Wrap"
                                                               Text="Set hear/talk devices, route apps through Voicemeeter, or reset routing."/>
                                                </StackPanel>
