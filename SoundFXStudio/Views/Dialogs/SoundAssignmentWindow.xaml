<Window x:Class="SoundFXStudio.Views.Dialogs.SoundAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundFXStudio.Controls"
        Title="Add Sound"
        Height="680"
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Assets/SoundFXStudioLogo.png">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#EAF1FF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AAFD0"/>

        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1F13233A"/>
            <Setter Property="BorderBrush" Value="#3300D4FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#00D4FF"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2A00D4FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3300D4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource AppWindowRoot}"
            CornerRadius="28"
            BorderThickness="1.5">

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Style="{StaticResource GlassPanel}">
                <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Image Source="/Assets/UI/MainDashboardLogo.png" Height="50" Stretch="Uniform"/>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Text="SOUNDFX STUDIO" Foreground="#00D4FF" FontWeight="Bold"/>
                            <TextBlock Text="Sound Details" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>

                    <controls:WindowControlBar Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"
                                                ShowMinimize="False"
                                                CloseClicked="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Margin="0,14,0,14">
                <ScrollViewer>
                    <StackPanel Margin="16">

                        <!-- File Selection -->
                        <TextBlock Text="Sound File" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Pick an audio file (MP3, WAV, OGG, FLAC)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FilePathBox" IsReadOnly="True" Text="{Binding FilePath, Mode=OneWay}"
                                     Height="40" Padding="10,6" Background="#1F13233A" BorderBrush="#3300D4FF"
                                     BorderThickness="1" Foreground="{StaticResource TextBrush}" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Browse" Height="40"
                                    Click="BrowseButton_Click" Style="{StaticResource CyberButton}"/>
                        </Grid>

                        <!-- Sound Name -->
                        <StackPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Sound Name" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="(label on keyboard button)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,2,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="NameBox" Text="{Binding Name}" Height="40" Padding="10,6"
                                     Background="#1F13233A" BorderBrush="#3300D4FF" BorderThickness="1"
                                     Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>

                        <!-- Chord Key -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Chord Sequence (optional)" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="Set a key combo (up to 3 keys): press keys in sequence within 1s" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ChordKeyBox" IsReadOnly="True"
                                         Text="{Binding ChordKeyDisplay, Mode=OneWay}" Height="40" Padding="10,6"
                                         Background="#1F13233A" BorderBrush="#3300D4FF" BorderThickness="1"
                                         Foreground="{StaticResource TextBrush}" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="Capture" Height="40"
                                        Click="CaptureChordKey_Click" Style="{StaticResource CyberButton}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Volume -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Volume" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="100" Value="{Binding VolumePercent}"
                                        Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#00D4FF"/>
                                <TextBlock Grid.Column="1" Text="{Binding VolumePercent, StringFormat='0%'}"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- Options -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Options" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                            <CheckBox Content="Mark as favorite" IsChecked="{Binding IsFavorite}"
                                      Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>

                        <!-- Image Selection -->
                        <Border Style="{StaticResource GlassPanel}" CornerRadius="14" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Custom Image (Optional)" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#0A0F18" CornerRadius="8" Height="96" BorderBrush="#3300D4FF"
                                            BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding ImagePath, Mode=OneWay}" Stretch="Uniform"/>
                                            <TextBlock Text="No image" FontSize="11" Foreground="#556288"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ImagePath}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBox x:Name="ImagePathBox" IsReadOnly="True" Text="{Binding ImagePath, Mode=OneWay}"
                                                 Height="40" Padding="10,6" Background="#1F13233A" BorderBrush="#3300D4FF"
                                                 BorderThickness="1" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Choose" Height="40"
                                                    Click="ImageBrowseButton_Click" Style="{StaticResource CyberButton}"/>
                                            <Button Content="Remove" Height="40" Margin="8,0,0,0"
                                                    Click="RemoveImageButton_Click" Style="{StaticResource CyberButton}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- FOOTER -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancel" Margin="0,0,10,0"
                        Style="{StaticResource CyberButton}" Height="40" Click="CancelButton_Click"/>
                <Button Content="Save"
                        Style="{StaticResource PrimaryGradientButtonStyle}" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
