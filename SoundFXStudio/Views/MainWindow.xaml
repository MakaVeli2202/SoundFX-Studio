<Window x:Class="SoundFXStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundFXStudio.Controls"
        xmlns:converters="clr-namespace:SoundFXStudio.Converters"
        xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore"
        Title="SoundFX Studio"
        Icon="/Assets/SoundFXStudioLogo.png"
        Width="1366"
        Height="900"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <SolidColorBrush x:Key="WindowBrush"
                         Color="#050A15"/>

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#0A1222"/>

        <SolidColorBrush x:Key="PanelBrushAlt"
                         Color="#0F1830"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#EAF1FF"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#A1B2D2"/>

        <Style x:Key="SidebarButton" TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="65"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="#22112233"/>
            <Setter Property="BorderBrush" Value="#3370AFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>


            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                        CornerRadius="14"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

        <Grid PreviewMouseLeftButtonDown="WindowShell_PreviewMouseLeftButtonDown">

                                <Rectangle Fill="#08FFFFFF"
                                   RadiusX="14"
                                   RadiusY="14"/>

                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="22,0,0,0"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="Border"
                                Property="BorderBrush"
                                Value="#00D8FF"/>

                                <Setter TargetName="Border"
                                Property="Background"
                                Value="#331A2948"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter TargetName="Border"
                                Property="Background"
                                Value="#552A4580"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="NeonButton"
       TargetType="Button">

            <Setter Property="Foreground"
            Value="White"/>

            <Setter Property="FontWeight"
            Value="Bold"/>

            <Setter Property="FontSize"
            Value="18"/>

            <Setter Property="Height"
            Value="60"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border CornerRadius="16">

                            <Border.Background>

                                <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0">

                                    <GradientStop Color="#00BFFF"
                                          Offset="0"/>

                                    <GradientStop Color="#AA45FF"
                                          Offset="1"/>

                                </LinearGradientBrush>

                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#66081428"/>
            <Setter Property="BorderBrush" Value="#5580CFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>



        <Style x:Key="WindowControlButtonStyle" TargetType="Button">

            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#22112233"/>
            <Setter Property="BorderBrush" Value="#3370AFFF"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                        CornerRadius="10"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#1100D8FF"/>

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#00D8FF"/>

                                <Setter TargetName="Border"
                                        Property="BorderThickness"
                                        Value="1"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="HeroOverlayButton"
       TargetType="Button">

            <Setter Property="Background"
            Value="Transparent"/>

            <Setter Property="BorderThickness"
            Value="0"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="HoverBorder"
                        CornerRadius="10"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="HoverBorder"
                                Property="Background"
                                Value="#1100D8FF"/>

                                <Setter TargetName="HoverBorder"
                                Property="BorderBrush"
                                Value="#33AAFFFF"/>

                                <Setter TargetName="HoverBorder"
                                Property="BorderThickness"
                                Value="1"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter TargetName="HoverBorder"
                                Property="Background"
                                Value="#22FF44CC"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="WindowControlButton"
       TargetType="Button">

            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="#EAF1FF"/>
            <Setter Property="Background" Value="#15000000"/>
            <Setter Property="BorderBrush" Value="#336AAEFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ChromeBorder"
                        CornerRadius="12"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="ChromeBorder"
                                Property="BorderBrush"
                                Value="#00D8FF"/>

                                <Setter TargetName="ChromeBorder"
                                Property="Background"
                                Value="#2200D8FF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter TargetName="ChromeBorder"
                                Property="Background"
                                Value="#4400D8FF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="CloseWindowButton"
       BasedOn="{StaticResource WindowControlButton}"
       TargetType="Button">

            <Setter Property="Background"
             Value="#331E0E12"/>

            <Setter Property="BorderBrush"
             Value="#AAFF4D6D"/>

        </Style>

        <!-- ═══ MyBoard-Style Button Templates ═══ -->

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00D8FF" Offset="0"/>
            <GradientStop Color="#AA45FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradientHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22E0FF" Offset="0"/>
            <GradientStop Color="#BB55FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F43F5E" Offset="0"/>
            <GradientStop Color="#E11D48" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="{StaticResource PrimaryGradient}">
                            <Border.Effect>
                                <effects:DropShadowEffect Color="#00D8FF" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryGradientHover}"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#00D8FF" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8822AA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundButtonSecondary" TargetType="Button">
            <Setter Property="Foreground" Value="#DDEAFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#14FFFFFF" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderBrush="#5580CFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2200D8FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FF44CC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundButtonDanger" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="{StaticResource DangerGradient}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#F43F5E" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Settings Panel Button ═══ -->
        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDEAFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#1A2A4580"/>
            <Setter Property="BorderBrush" Value="#5580CFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                         <ControlTemplate.Triggers>
                             <Trigger Property="IsMouseOver" Value="True">
                                 <Setter TargetName="Bd" Property="Background" Value="#2200D8FF"/>
                                 <Setter TargetName="Bd" Property="BorderBrush" Value="#00D8FF"/>
                                 <Setter TargetName="Bd" Property="Effect">
                                     <Setter.Value>
                                         <effects:DropShadowEffect Color="#00D8FF" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                     </Setter.Value>
                                 </Setter>
                             </Trigger>
                             <Trigger Property="IsPressed" Value="True">
                                 <Setter TargetName="Bd" Property="Background" Value="#33FF44CC"/>
                                 <Setter TargetName="Bd" Property="BorderBrush" Value="#FF44CC"/>
                             </Trigger>
                         </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ MyBoard 3D Keycap Tile Style ═══ -->
        <Style x:Key="SoundTileButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="118"/>
            <Setter Property="Height" Value="118"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Skirt" CornerRadius="16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#252A4E" Offset="0"/>
                                        <GradientStop Color="#141838" Offset="0.5"/>
                                        <GradientStop Color="#0A0E20" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <effects:DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.55"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Face" Margin="4,4,4,10" CornerRadius="13" BorderBrush="#2AFFFFFF" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1E2448" Offset="0"/>
                                        <GradientStop Color="#141838" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <ContentPresenter x:Name="TileContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    <Border VerticalAlignment="Top" Height="22" Margin="2,1,2,0" CornerRadius="12,12,0,0" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#18FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#803535D0"/>
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#282E58" Offset="0"/>
                                            <GradientStop Color="#1C2248" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Skirt" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#3535D0" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Margin" Value="4,9,4,5"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#00D8FF"/>
                                <Setter TargetName="Skirt" Property="Effect">
                                    <Setter.Value>
                                        <effects:DropShadowEffect Color="#00D8FF" BlurRadius="26" ShadowDepth="0" Opacity="0.7"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="8,0,8,8"
        CornerRadius="16"
        Background="#070E18">

        <Border.Effect>
            <DropShadowEffect BlurRadius="50"
                          ShadowDepth="0"
                          Color="#000000"
                          Opacity="0.6"/>
        </Border.Effect>

        <Border.BorderBrush>

            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,0">

                <GradientStop Color="#00D8FF"
                              Offset="0"/>

                <GradientStop Color="#FF44CC"
                              Offset="1"/>

            </LinearGradientBrush>

        </Border.BorderBrush>

        <Border.BorderThickness>2</Border.BorderThickness>

        <Grid>

            <!-- Dashboard Skin -->
                 <Image Source="/Assets/UI/MainWindowBackground.png"
                     Stretch="Fill"
                     Margin="0,44,0,0"/>

            <!-- Dashboard Logo -->


            <Image Source="/Assets/UI/MainDashboardLogo.png"
                   Width="250"
                   Height="110"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                    Margin="35,70,0,0">
            </Image>

            <!-- Dashboard Hero Section -->
            <Border Width="930"
                    Height="520"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="300,170,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Image Source="/Assets/UI/HeroSection.png"
                           Stretch="Uniform"
                           Margin="20"/>

                    <Button Style="{StaticResource HeroOverlayButton}"
                            Width="275"
                            Height="54"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="52,-15,0,0"
                            AutomationProperties.Name="Open Keyboard"
                            AutomationProperties.AutomationId="OpenKeyboardButton"
                            Click="OpenKeyboardWindowButton_Click"/>
                </Grid>
            </Border>

            <!-- Effects Page -->
            <Border Width="930"
                    Height="470"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="300,220,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Effects">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <TextBlock Text="EFFECTS"
                               Foreground="#00D8FF"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-40,0,0"/>
                    <TextBlock Text="Coming Soon"
                               Foreground="#A1B2D2"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,20,0,0"/>
                </Grid>
            </Border>

            <!-- Library Page (tile grid) — MyBoard design with dark theme -->
            <Border Width="990"
                    Height="530"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="300,210,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="SoundLibrary">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <TextBlock Text="LIBRARY"
                               Foreground="#00D8FF"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <!-- TOOLBAR - MyBoard style -->
                    <Border Grid.Row="1" Background="#0AFFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="+ Add Sound"
                                        Style="{StaticResource RoundButton}"
                                        Command="{Binding AddSoundCommand}"/>
                                <Button Content="&#x1F310; URL"
                                        Style="{StaticResource RoundButtonSecondary}"
                                        Command="{Binding AddSoundFromUrlCommand}"/>
                                <Button Content="&#x1F3A4; Mic"
                                        Style="{StaticResource RoundButtonSecondary}"
                                        Click="LibraryMicButton_Click"/>
                                <Button Content="&#x1F5D1; Delete"
                                        Style="{StaticResource RoundButtonDanger}"
                                        Command="{Binding DeleteMarkedSoundsCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SEARCH - MyBoard style -->
                    <Border Grid.Row="2" Background="#14FFFFFF" CornerRadius="10" BorderBrush="#3370AFFF" BorderThickness="1" Height="34" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="&#x1F50D;" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#8891B8"/>
                            <TextBox x:Name="LibrarySearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="White" FontSize="12" CaretBrush="White"
                                     VerticalAlignment="Center"
                                     Margin="30,0,8,0">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock Text="Search sounds..." Foreground="#5A6488" FontSize="12"
                                       VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- TILES - MyBoard 3D keycap style -->
                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="4,0,4,0">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollViewer">
                                            <Grid>
                                                <ScrollContentPresenter Margin="0,0,6,0"/>
                                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                                           Value="{TemplateBinding VerticalOffset}"
                                                           Maximum="{TemplateBinding ScrollableHeight}"
                                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                           Background="#0A1424"
                                                           BorderBrush="#1B3157"
                                                           BorderThickness="1"
                                                           Width="8"
                                                           Cursor="Hand">
                                                    <ScrollBar.Template>
                                                        <ControlTemplate TargetType="ScrollBar">
                                                            <Grid>
                                                                <Track x:Name="PART_Track">
                                                                    <Track.Thumb>
                                                                        <Thumb BorderBrush="#00D8FF" Background="#225580CFFF" BorderThickness="1">
                                                                            <Thumb.Template>
                                                                                <ControlTemplate TargetType="Thumb">
                                                                                    <Border CornerRadius="4" Background="#225580CFFF" BorderBrush="#00D8FF" BorderThickness="1" Margin="0,1"/>
                                                                                </ControlTemplate>
                                                                            </Thumb.Template>
                                                                        </Thumb>
                                                                    </Track.Thumb>
                                                                </Track>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </ScrollBar.Template>
                                                </ScrollBar>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Style>

                        <ItemsControl ItemsSource="{Binding SoundsView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SoundTileButton}"
                                            Command="{Binding DataContext.EditSoundCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <!-- Image area -->
                                            <Border CornerRadius="12" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding ImagePath}"
                                                           Stretch="UniformToFill"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <!-- icon fallback when no image -->
                                                    <TextBlock Text="&#x266B;" FontSize="28" Foreground="#334466"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding ImagePath, TargetNullValue=Visible, FallbackValue=Collapsed}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- scrim so text is legible -->
                                                    <Border Background="#44000000"/>
                                                </Grid>
                                            </Border>

                                            <!-- overlay: name + key badge -->
                                            <Grid Margin="8,6,8,7" VerticalAlignment="Stretch">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="30"
                                                           TextTrimming="CharacterEllipsis"
                                                           LineHeight="13"
                                                           VerticalAlignment="Top"
                                                           Margin="0,0,4,0"/>

                                                <Border Grid.Row="2"
                                                        CornerRadius="5"
                                                        Padding="6,2,6,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom"
                                                        Background="#558891B8">
                                                    <TextBlock Text="{Binding AssignedKeyLabel, TargetNullValue='+ key'}"
                                                               Foreground="White"
                                                               FontSize="11"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <Button.ContextMenu>
                                            <ContextMenu Background="#1A1A2E"
                                                         BorderBrush="#2A2A4E"
                                                         BorderThickness="1"
                                                         Foreground="White"
                                                         FontSize="12"
                                                         HasDropShadow="True">
                                                <ContextMenu.Resources>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Background" Value="#1A1A2E"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#2A2A4E"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="12,6"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter Property="Background" Value="#282850"/>
                                                                <Setter Property="BorderBrush" Value="#3535D0"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style TargetType="Separator">
                                                        <Setter Property="Background" Value="#2A2A4E"/>
                                                        <Setter Property="Margin" Value="6,2"/>
                                                        <Setter Property="Height" Value="1"/>
                                                    </Style>
                                                </ContextMenu.Resources>
                                                <MenuItem Header="&#x25B6; Play" Click="SoundTileMenu_Play"/>
                                                <MenuItem Header="&#x270E; Edit" Click="SoundTileMenu_Edit"/>
                                                <MenuItem Header="&#x1F4CC; Assign to Key" Click="SoundTileMenu_Assign"/>
                                                <Separator/>
                                                <MenuItem Header="&#x1F5D1; Delete" Foreground="#F43F5E" Click="SoundTileMenu_Delete"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Settings Page -->
            <Border Width="850"
                    Height="470"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="300,220,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,16,20,16">

                        <TextBlock Text="SETTINGS"
                                   Foreground="#00D8FF"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,14"/>

                        <!-- ══ VOICEMEETER (RECOMMENDED) ══ -->
                        <Border Background="#66081428" BorderBrush="#5580CFFF"
                                BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                           Text="VOICEMEETER" Foreground="#00D8FF" FontSize="11" FontWeight="Bold"
                                           Margin="0,0,0,8"/>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="What you HEAR with" Foreground="#DDEAFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="HearCombo" Height="30" DisplayMemberPath="Name"
                                              Background="#44111A2E" BorderBrush="#5580CFFF" Foreground="White" FontSize="12"
                                              BorderThickness="1" Padding="6,2"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="What you TALK with" Foreground="#DDEAFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="TalkCombo" Height="30" DisplayMemberPath="Name"
                                              Background="#44111A2E" BorderBrush="#5580CFFF" Foreground="White" FontSize="12"
                                              BorderThickness="1" Padding="6,2"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <Button x:Name="VoicemeeterButton"
                                            Content="Auto-setup for Voicemeeter" Width="240"
                                            Style="{StaticResource SettingsButton}"
                                            Click="VoicemeeterButton_Click"
                                            FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock x:Name="VoicemeeterStatus" Text="" Foreground="#10B981"
                                               FontSize="10.5" TextWrapping="Wrap" FontFamily="Consolas" Margin="2,6,2,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button x:Name="MixerBtn" Content="Sound Mixer" Width="120"
                                                Style="{StaticResource SettingsButton}"
                                                Background="#151B35" BorderBrush="#3A5A8A" Foreground="#A1B2D2"
                                                Click="MixerButton_Click"/>
                                        <Button x:Name="RerunWizardBtn" Content="Setup Wizard" Width="120"
                                                Style="{StaticResource SettingsButton}"
                                                Background="#151B35" BorderBrush="#3A5A8A" Foreground="#A1B2D2"
                                                Click="RerunWizard_Click"/>
                                        <Button x:Name="TestRoutingBtn" Content="Test Routing" Width="120"
                                                Style="{StaticResource SettingsButton}"
                                                Background="#151B35" BorderBrush="#3A5A8A" Foreground="#A1B2D2"
                                                Command="{Binding TestRoutingCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ══ ROUTE YOURSELF / HOTKEY / OUTPUT / PITCH — compact row ══ -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#66081428" BorderBrush="#5580CFFF"
                                    BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="ROUTE IT YOURSELF" Foreground="#00D8FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Foreground="#A1B2D2" FontSize="10.5" TextWrapping="Wrap" LineHeight="17"
                                               LineStackingStrategy="BlockLineHeight" Margin="0,0,0,8">
                                        <Run FontWeight="Bold" Foreground="#00D8FF">1.</Run> Open Volume Mixer → set SoundFX output to Voicemeeter input.<LineBreak/>
                                        <Run FontWeight="Bold" Foreground="#00D8FF">2.</Run> In your game/Discord, set mic to that cable's output.
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="OpenAppVolumeButton" Content="Volume Mixer" Width="120"
                                                Style="{StaticResource SettingsButton}"
                                                Background="#151B35" BorderBrush="#3A5A8A" Foreground="#A1B2D2"
                                                Click="OpenAppVolumeButton_Click"/>
                                        <Button x:Name="OpenSoundBtn" Content="Sound Settings" Width="120"
                                                Style="{StaticResource SettingsButton}"
                                                Background="#151B35" BorderBrush="#3A5A8A" Foreground="#A1B2D2"
                                                Click="OpenSound_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#66081428" BorderBrush="#5580CFFF"
                                    BorderThickness="1" CornerRadius="12" Padding="14,12" Width="310">
                                <StackPanel>
                                    <TextBlock Text="ACTIVATION" Foreground="#00D8FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Key" Foreground="#DDEAFF" FontSize="10.5" Margin="0,0,0,2"/>
                                    <TextBox x:Name="ActivationKeyBox"
                                             Text="{Binding Settings.SoundboardToggleKey}"
                                             Height="26" FontSize="11"
                                             Background="#44111A2E" BorderBrush="#5580CFFF" Foreground="White"
                                             BorderThickness="1" Padding="6,2" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ActivationModeCombo" Height="28"
                                              Background="#44111A2E" BorderBrush="#5580CFFF" Foreground="White" FontSize="11"
                                              BorderThickness="1" Padding="4,1">
                                        <ComboBoxItem Content="Hold key + tap a sound key"/>
                                        <ComboBoxItem Content="Toggle: press key once on/off"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ══ OUTPUT DEVICE & PITCH — side by side ══ -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#66081428" BorderBrush="#5580CFFF"
                                    BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="OUTPUT DEVICE" Foreground="#00D8FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Foreground="#A1B2D2" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Text="Where SoundFX plays your sounds."/>
                                    <ComboBox x:Name="SpeakersComboBox" Height="28" DisplayMemberPath="Name"
                                              Background="#44111A2E" BorderBrush="#5580CFFF" Foreground="White" FontSize="12"
                                              BorderThickness="1" Padding="6,1"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#66081428" BorderBrush="#5580CFFF"
                                    BorderThickness="1" CornerRadius="12" Padding="14,12" Width="310">
                                <StackPanel>
                                    <TextBlock Text="PITCH SHIFT" Foreground="#00D8FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="PitchSlider" Grid.Column="0"
                                                Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="1"
                                                TickFrequency="2" TickPlacement="BottomRight"
                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="5" Padding="8,3">
                                            <TextBlock x:Name="PitchValueText" Text="0.0 st"
                                                       Foreground="White" FontSize="11" FontWeight="Bold"
                                                       MinWidth="40" TextAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ══ KEYBOARD LAYOUT & ADVANCED — side by side ══ -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#66081428" BorderBrush="#5580CFFF"
                                    BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="KEYBOARD LAYOUT" Foreground="#00D8FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding KeyboardLayoutOptions}"
                                              SelectedItem="{Binding KeyboardLayout}"
                                              Height="28"
                                              Background="#44111A2E" BorderBrush="#5580CFFF" Foreground="White" FontSize="12"
                                              BorderThickness="1" Padding="6,1"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#66081428" BorderBrush="#5580CFFF"
                                    BorderThickness="1" CornerRadius="12" Padding="14,12" Width="310">
                                <StackPanel>
                                    <TextBlock Text="ADVANCED" Foreground="#00D8FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <Button Content="Keyboard Calibration"
                                            Style="{StaticResource SettingsButton}"
                                            Click="OpenCalibrationButton_Click"
                                            HorizontalAlignment="Left" Width="180"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ══ VOICE CHANGER ══ -->
                        <Border Background="#66081428" BorderBrush="#5580CFFF"
                                BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                           Text="VOICE CHANGER" Foreground="#00D8FF" FontSize="11" FontWeight="Bold"
                                           Margin="0,0,0,8"/>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Mic passthrough with real-time pitch. Routes your mic through SoundFX." 
                                               Foreground="#A1B2D2" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <Button x:Name="VoiceChangerToggleBtn"
                                            Content="Start Voice Changer"
                                            Height="30" Width="180" HorizontalAlignment="Left"
                                            Background="#222A4580" BorderBrush="#5580CFFF" Foreground="White"
                                            BorderThickness="1" Cursor="Hand" FontSize="11"/>
                                </StackPanel>

                                <Border Grid.Row="1" Grid.Column="1" Background="#1AFFFFFF" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="VoiceChangerStatus" Text="Stopped"
                                               Foreground="#E85555" FontSize="11" FontWeight="Bold"
                                               MinWidth="60" TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ══ QUICK-MUTE HOTKEYS ══ -->
                        <Border Background="#66081428" BorderBrush="#5580CFFF"
                                BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                           Text="MUTE HOTKEYS (Voicemeeter)" Foreground="#00D8FF" FontSize="11" FontWeight="Bold"
                                           Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Mute All:" 
                                           Foreground="#DDEAFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="MuteAllKeyBox"
                                         Text="{Binding Settings.MuteAllKey}" Height="26" FontSize="11"
                                         Margin="0,0,0,4" ToolTip="e.g. Ctrl+Shift+F13"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Mute Hear:" 
                                           Foreground="#DDEAFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="MuteHearKeyBox"
                                         Text="{Binding Settings.MuteHearKey}" Height="26" FontSize="11"
                                         Margin="0,0,0,4" ToolTip="e.g. Ctrl+Shift+F14"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Mute Team:" 
                                           Foreground="#DDEAFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="MuteTeamKeyBox"
                                         Text="{Binding Settings.MuteTeamKey}" Height="26" FontSize="11"
                                         ToolTip="e.g. Ctrl+Shift+F15"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#A1B2D2"
                                   FontSize="11"
                                   Margin="0,4,0,4"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Page Tabs (overlaid on hero section, rendered after content for click priority) -->
            <Border Width="930"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="300,164,0,0" Padding="6,6,6,0">
                <StackPanel Orientation="Horizontal">

                    <!-- Home Tab -->
                    <Border x:Name="HomeTabBorder" CornerRadius="8" Padding="0" ToolTip="Home"
                            Cursor="Hand" MouseLeftButtonDown="NavigateHome_Click" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="&#x2302;  Home" FontSize="16" FontWeight="SemiBold" Padding="16,10,16,2"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#506078"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                                <Setter Property="Foreground" Value="#DDEAFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Height="3" CornerRadius="1.5" HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                                <Setter Property="Background" Value="#00D8FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                        <Setter Property="Background" Value="#1800D8FF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Sound Library Tab -->
                    <Border x:Name="SoundLibTabBorder" CornerRadius="8" Padding="0" ToolTip="Library"
                            Cursor="Hand" MouseLeftButtonDown="NavigateSoundLibrary_Click" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="&#x266B;  Library" FontSize="16" FontWeight="SemiBold" Padding="16,10,16,2"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#506078"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="SoundLibrary">
                                                <Setter Property="Foreground" Value="#DDEAFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Height="3" CornerRadius="1.5" HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="SoundLibrary">
                                                <Setter Property="Background" Value="#00D8FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="SoundLibrary">
                                        <Setter Property="Background" Value="#1800D8FF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Effects Tab -->
                    <Border x:Name="EffectsTabBorder" CornerRadius="8" Padding="0" ToolTip="Effects"
                            Cursor="Hand" MouseLeftButtonDown="NavigateEffects_Click" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="&#x1F39A;  Effects" FontSize="16" FontWeight="SemiBold" Padding="16,10,16,2"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#506078"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="Effects">
                                                <Setter Property="Foreground" Value="#DDEAFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Height="3" CornerRadius="1.5" HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="Effects">
                                                <Setter Property="Background" Value="#00D8FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Effects">
                                        <Setter Property="Background" Value="#1800D8FF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Settings Tab -->
                    <Border x:Name="SettingsTabBorder" CornerRadius="8" Padding="0" ToolTip="Settings"
                            Cursor="Hand" MouseLeftButtonDown="NavigateSettings_Click">
                        <StackPanel>
                            <TextBlock Text="&#x2699;  Settings" FontSize="16" FontWeight="SemiBold" Padding="16,10,16,2"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#506078"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                                                <Setter Property="Foreground" Value="#DDEAFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Height="3" CornerRadius="1.5" HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                                                <Setter Property="Background" Value="#00D8FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                                        <Setter Property="Background" Value="#1800D8FF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Title Bar -->

                <Border HorizontalAlignment="Stretch"
                    Height="44"
                    VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Style="{StaticResource WindowChromeBar}"
                    CornerRadius="0">
                <Grid Margin="18,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="SOUNDFX STUDIO"
                               VerticalAlignment="Center"
                               Foreground="#F2F2F2"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <Button Grid.Column="1"
                            Width="110"
                            Height="32"
                            Click="OpenCalibrationButton_Click"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#00D8FF"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CalBorder" CornerRadius="8"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CalBorder" Property="Background" Value="#2200D8FF"/>
                                                    <Setter TargetName="CalBorder" Property="BorderBrush" Value="#00D8FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2699;" FontSize="13" Foreground="#00D8FF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Calibration" FontSize="13" Foreground="#DDEAFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowChromeButton}"
                                Content="&#x2212;"
                                FontSize="17"
                                Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource WindowChromeCloseButton}"
                                Content="&#x2715;"
                                FontSize="15"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>



            <!-- Sidebar -->

            <Border Style="{StaticResource GlassPanel}"
                    Width="250"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="35,170,0,0"
                    ClipToBounds="True">

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">

                        <!-- QUICK ACTIONS -->
                        <TextBlock Text="QUICK ACTIONS" FontSize="12" FontWeight="SemiBold" Foreground="#00D8FF" Margin="0,0,0,8"/>

                        <Border Background="#0C1424" BorderBrush="#1B3157" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                            <StackPanel>

                                <Button Click="OpenKeyboardWindowButton_Click" Height="44" Margin="0,0,0,8"
                                        Background="#101A2A" BorderBrush="#243A63" BorderThickness="1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="BtnBorder" CornerRadius="10" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="BtnBorder" Property="Background" Value="#152542"/>
                                                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#00D8FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2328;" FontSize="20" Foreground="#00D8FF" Width="28" VerticalAlignment="Center"/>
                                        <TextBlock Text="Open Keyboard" FontSize="14" Foreground="#DDEAFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Height="44" Margin="0,0,0,8"
                                        Background="#101A2A" BorderBrush="#243A63" BorderThickness="1"
                                        Command="{Binding AddSoundCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="BtnBorder" CornerRadius="10" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="BtnBorder" Property="Background" Value="#152542"/>
                                                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#AA45FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="26" FontWeight="Bold" Foreground="#AA45FF" Width="28" VerticalAlignment="Center"/>
                                        <TextBlock Text="Add Sound" FontSize="14" Foreground="#DDEAFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Height="44" Margin="0,0,0,8"
                                        Background="#101A2A" BorderBrush="#243A63" BorderThickness="1"
                                        Command="{Binding AddMultipleSoundsCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="BtnBorder" CornerRadius="10" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="BtnBorder" Property="Background" Value="#152542"/>
                                                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FF44CC"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2B07;" FontSize="20" Foreground="#FF44CC" Width="28" VerticalAlignment="Center"/>
                                        <TextBlock Text="Import Sounds" FontSize="14" Foreground="#DDEAFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Height="44"
                                        Background="#101A2A" BorderBrush="#243A63" BorderThickness="1"
                                        Click="OpenCalibrationButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="BtnBorder" CornerRadius="10" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="BtnBorder" Property="Background" Value="#152542"/>
                                                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#00D8FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F50A;" FontSize="20" Foreground="#00D8FF" Width="28" VerticalAlignment="Center"/>
                                        <TextBlock Text="Configure Audio" FontSize="14" Foreground="#DDEAFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- PROFILE -->
                        <TextBlock Text="PROFILE" FontSize="12" FontWeight="SemiBold" Foreground="#00D8FF" Margin="0,4,0,8"/>
                        <Border Background="#0C1424" BorderBrush="#1B3157" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2605;" FontSize="18" Foreground="#FFD700" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding KeyboardLayoutOptions}"
                                          SelectedItem="{Binding KeyboardLayout}"
                                          Background="Transparent" Foreground="#DDEAFF" BorderBrush="#1B3157"
                                          BorderThickness="1" Padding="8,8" FontSize="14" MinWidth="170"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- AUDIO STATUS -->
                        <TextBlock Text="AUDIO STATUS" FontSize="12" FontWeight="SemiBold" Foreground="#00D8FF" Margin="0,4,0,8"/>

                        <Border Background="#0C1424" BorderBrush="#1B3157" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="#2CE96E" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Output" FontSize="11" Foreground="#7F899C"/>
                                        <TextBlock Text="{Binding CurrentOutputDevice}" FontSize="13" Foreground="#DDEAFF"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="#2CE96E" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Input" FontSize="11" Foreground="#7F899C"/>
                                        <TextBlock Text="{Binding CurrentInputDevice}" FontSize="13" Foreground="#DDEAFF"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding RoutingStatus}" FontSize="11" Foreground="#7F899C" Margin="0,0,0,10"/>
                                <Button Height="40" Background="#101827" BorderBrush="#22385D" BorderThickness="1"
                                        Command="{Binding TestRoutingCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="BtnBorder" CornerRadius="8" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="BtnBorder" Property="Background" Value="#152542"/>
                                                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#00D8FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x25B6;" FontSize="12" Foreground="#00D8FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Test Routing" FontSize="14" Foreground="#DDEAFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Footer Bar -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="35,0,35,35" Width="1256"
                    Background="#0C1424" BorderBrush="#1B3157" BorderThickness="1" CornerRadius="12"
                    Padding="18,10,18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x266B;" FontSize="14" Foreground="#00D8FF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="#7F899C" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="SOUNDFX STUDIO" Foreground="#33506A" FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>