<Window x:Class="SoundFXStudio.Views.Dialogs.LoadingScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundFX Studio"
        Width="460"
        Height="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Icon="/Assets/SoundFXStudioLogo.png">

    <Window.Resources>
        <PathGeometry x:Key="SpinnerArcGeometry">
            <PathFigure StartPoint="60,10">
                <ArcSegment Point="16.7,35" Size="50,50" SweepDirection="Clockwise" IsLargeArc="True"/>
            </PathFigure>
        </PathGeometry>

        <Storyboard x:Key="SpinnerSpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:1.15"/>
        </Storyboard>

        <Storyboard x:Key="SpinnerGlowPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SpinnerGlow"
                             Storyboard.TargetProperty="Effect.Opacity"
                             From="0.45" To="0.9"
                             Duration="0:0:0.75"/>
        </Storyboard>

        <Storyboard x:Key="AmbientGlowStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="AmbientGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.8"
                             Duration="0:0:1.7"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="#B3080D17" CornerRadius="30" ClipToBounds="True" BorderThickness="1.5">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00D4FF" Offset="0"/>
                <GradientStop Color="#7B3FFF" Offset="0.55"/>
                <GradientStop Color="#FF2DAF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#3300D4FF" BlurRadius="34" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <!-- Inset background image: rounded to match the window curve so edges are smooth -->
            <Border Margin="5" CornerRadius="25">
                <Border.Background>
                    <ImageBrush ImageSource="/Assets/Pics/MainWindowBackground.png"
                                Stretch="UniformToFill"
                                Opacity="0.62"/>
                </Border.Background>
            </Border>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Border Width="88" Height="88" CornerRadius="24"
                            Background="#CC141E2D" BorderBrush="#334A647F" BorderThickness="1"
                            HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#3300D4FF" BlurRadius="18" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <Image Source="/Assets/SoundFXStudioLogo.png" Width="54" Height="54"/>
                    </Border>
                    <TextBlock Text="SOUNDFX STUDIO" HorizontalAlignment="Center" Margin="0,18,0,0"
                               Foreground="#9CEBFF" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="LOADING" HorizontalAlignment="Center" Margin="0,5,0,0"
                               Foreground="White" FontSize="24" FontWeight="Bold">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.8"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Spinner -->
                <Grid Grid.Row="1" Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="AmbientGlow" Width="170" Height="170" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#3300D4FF" Offset="0"/>
                                <GradientStop Color="#0000D4FF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Dim full ring track -->
                        <Path Stroke="#2E5C7896" StrokeThickness="5">
                            <Path.Data>
                                <EllipseGeometry Center="60,60" RadiusX="50" RadiusY="50"/>
                            </Path.Data>
                        </Path>

                        <!-- Rotating bright arc -->
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Grid.RenderTransform>
                            <Path x:Name="SpinnerGlow" Data="{StaticResource SpinnerArcGeometry}"
                                  StrokeThickness="9"
                                  Stroke="{StaticResource AppBorderGradient}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round">
                                <Path.Effect>
                                    <DropShadowEffect Color="#00D4FF" BlurRadius="14" ShadowDepth="0" Opacity="0.75"/>
                                </Path.Effect>
                            </Path>
                            <Path Data="{StaticResource SpinnerArcGeometry}"
                                  StrokeThickness="5"
                                  Stroke="#CCEAF1FF"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Opacity="0.9"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Status -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock x:Name="StatusText" Text="Starting SoundFX Studio…"
                               Foreground="#BCD0EC" FontSize="12.5"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340"/>
                    <TextBlock Text="SoundFX Studio is loading, one moment."
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Foreground="#6B7F9E" FontSize="10.5"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource SpinnerSpinStoryboard}"/>
                <BeginStoryboard Storyboard="{StaticResource SpinnerGlowPulseStoryboard}"/>
                <BeginStoryboard Storyboard="{StaticResource AmbientGlowStoryboard}"/>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</Window>
