<Window x:Class="SoundFXStudio.Views.Dialogs.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Setup Wizard"
        Width="920"
        Height="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Assets/SoundFXStudioLogo.png">

    <Window.Resources>

        <SolidColorBrush x:Key="TextBrush" Color="#EAF1FF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A1B2D2"/>

        <Style x:Key="GlassPanel"
               TargetType="Border">

            <Setter Property="CornerRadius"
                    Value="24"/>

            <Setter Property="Background"
                    Value="#66081428"/>

            <Setter Property="BorderBrush"
                    Value="#558B5CF6"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

        <Style x:Key="CyberButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#22112233"/>

            <Setter Property="BorderBrush"
                    Value="#338B5CF6"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Height"
                    Value="42"/>

        </Style>

    </Window.Resources>

    <Border Background="#081428"
            CornerRadius="28"
            ClipToBounds="True">

        <Border.BorderBrush>
            <SolidColorBrush Color="#558B5CF6"/>
        </Border.BorderBrush>

        <Border.BorderThickness>1</Border.BorderThickness>

        <Grid Margin="18">

            <Grid.RowDefinitions>

                <RowDefinition Height="80"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="70"/>

            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Border Grid.Row="0"
                    Style="{StaticResource GlassPanel}">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0">

                        <Image Source="/Assets/UI/MainDashboardLogo.png"
                               Height="50"
                               Stretch="Uniform"/>

                        <StackPanel Margin="16,0,0,0">

                            <TextBlock Text="AUDIO SETUP WIZARD"
                                       Foreground="#8B5CF6"
                                       FontSize="22"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Configure playback and recording devices"
                                       Foreground="{StaticResource MutedBrush}"/>

                        </StackPanel>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Height="40"
                            Margin="0,10,10,10"
                            Content="&#x2715;"
                            Background="#55203030"
                            BorderBrush="#8B5CF6"
                            Foreground="White"
                            Click="CloseButton_Click"/>

                </Grid>

            </Border>

            <!-- DESCRIPTION -->

            <TextBlock Grid.Row="1"
                       Margin="5,15,5,15"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Text="Choose what you HEAR and TALK with, then auto-setup routes your audio through Voicemeeter. Manage your speakers and microphone in Settings."/>

            <!-- MAIN CONTENT -->

            <Border Grid.Row="2"
                    Style="{StaticResource GlassPanel}">

                <!-- VOICEMEETER SETUP -->

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="16">

                        <TextBlock Text="VOICEMEETER AUTO-SETUP"
                                   Foreground="#8B5CF6"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <Border Background="#148B5CF6" CornerRadius="8" Padding="10,7" Margin="0,0,0,12">
                            <TextBlock x:Name="VmDetectText" Text="Checking for Voicemeeter..."
                                       Foreground="#8891B8" FontSize="12"/>
                        </Border>

                        <Border Background="#22081428" CornerRadius="12" Padding="14,12" Margin="0,0,0,10"
                                BorderBrush="#338B5CF6" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="WHAT YOU HEAR WITH (headphones)"
                                           Foreground="#C9D7F0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="WizardHearCombo"
                                          Height="32"
                                          DisplayMemberPath="Name"
                                          Background="#44111A2E" BorderBrush="#558B5CF6"
                                          Foreground="White" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#22081428" CornerRadius="12" Padding="14,12" Margin="0,0,0,12"
                                BorderBrush="#338B5CF6" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="WHAT YOU TALK WITH (microphone)"
                                           Foreground="#C9D7F0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="WizardTalkCombo"
                                          Height="32"
                                          DisplayMemberPath="Name"
                                          Background="#44111A2E" BorderBrush="#558B5CF6"
                                          Foreground="White" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Button x:Name="WizardAutoSetupBtn"
                                    Content="Auto-setup for Voicemeeter"
                                    Click="WizardAutoSetup_Click"
                                    Height="36"
                                    Background="#222A2A66" BorderBrush="#558B5CF6"
                                    Foreground="White" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#442A2A66"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8B5CF6"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                            </Button>

                            <Button x:Name="WizardResetWindowsBtn"
                                    Content="Reset Windows Settings"
                                    Margin="8,0,0,0"
                                    Click="WizardResetWindows_Click"
                                    Height="36"
                                    Background="#222A2A66" BorderBrush="#F43F5E"
                                    Foreground="White" Cursor="Hand" FontSize="12">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#442A2A66"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F43F5E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="VmSetupStatus"
                                   Margin="0,8,0,0"
                                   Foreground="#10B981"
                                   FontSize="10.5" TextWrapping="Wrap"
                                   FontFamily="Consolas"/>

                        <TextBlock x:Name="WizardStatusText"
                                   Margin="0,12,0,0"
                                   Foreground="#8B5CF6"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <!-- FOOTER -->

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <CheckBox x:Name="DontShowAgainCheckBox"
                          Content="Don't show this again"
                          Foreground="{StaticResource TextBrush}"
                          Margin="0,0,20,0"
                          VerticalAlignment="Center"/>

                <Button Content="Open Windows Sound"
                        Margin="0,0,8,0"
                        Style="{StaticResource CyberButton}"
                        Click="OpenSound_Click"/>

                <Button Content="Finish"
                        FontWeight="Bold"
                        Foreground="#081428"
                        Click="Finish_Click">

                    <Button.Background>

                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0">

                            <GradientStop Color="#8B5CF6"/>

                            <GradientStop Color="#7C3AED"/>

                        </LinearGradientBrush>

                    </Button.Background>

                </Button>

            </StackPanel>

        </Grid>

    </Border>

</Window>