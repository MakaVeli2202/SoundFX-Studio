                                                              BorderThickness="1" Padding="6,1"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1" Background="#66081428" BorderBrush="#558B5CF6"
                                                    BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="MICROPHONE (VOICE INPUT)" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                                    <TextBlock Foreground="#A1B2D2" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,6"
                                                               Text="Where your voice comes from (VoiceMeeter B1 when routed)."/>
                                                    <ComboBox x:Name="MicrophoneComboBox" Height="28" DisplayMemberPath="Name"
                                                              Background="#44111A2E" BorderBrush="#558B5CF6" Foreground="White" FontSize="12"
                                                              BorderThickness="1" Padding="6,1"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ══ KEYBINDS ══ -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Keybinds">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="24">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="KEYBINDS (HOTKEYS)" Foreground="#8B5CF6" FontSize="16" FontWeight="Bold"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Foreground="#7F899C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"
                                                       Text="Global shortcuts for mute actions and the soundboard toggle."/>

                                            <Button x:Name="AddBindingButton"
                                                    AutomationProperties.AutomationId="SettingsAddBindingButton"
                                                    Click="AddBindingButton_Click"
                                                    HorizontalAlignment="Left" Margin="0,0,0,12">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Height" Value="34"/>
                                                        <Setter Property="Padding" Value="14,0"/>
                                                        <Setter Property="Foreground" Value="#8B5CF6"/>
                                                        <Setter Property="Background" Value="#0A1A2E"/>
                                                        <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Grid>
                                                                        <Rectangle x:Name="Bd" RadiusX="9" RadiusY="9"
                                                                                   Fill="{TemplateBinding Background}"
                                                                                   Stroke="{TemplateBinding BorderBrush}"
                                                                                   StrokeThickness="1"
                                                                                   StrokeDashArray="4,3"/>
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                          Margin="{TemplateBinding Padding}"/>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Fill" Value="#1A8B5CF6"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Add Binding" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                                <Border x:Name="AddBindingPanel" Visibility="Collapsed"
                                                    Background="#66081428" BorderBrush="#558B5CF6" BorderThickness="1"
                                                    CornerRadius="12" Padding="18,16" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Choose an action:" Foreground="#DDEAFF" FontSize="11" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="AddBindingActionCombo" Height="30"
                                                              ItemsSource="{Binding AvailableKeybindActions}"
                                                              Background="#44111A2E" BorderBrush="#558B5CF6" Foreground="White" FontSize="12"
                                                              BorderThickness="1" Padding="6,1"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                        <Button x:Name="AddBindingRecordButton" Content="Record"
                                                                AutomationProperties.AutomationId="SettingsAddBindingRecordButton"
                                                                Height="30" Width="90" FontSize="11"
                                                                Style="{StaticResource SettingsButton}"
                                                                Click="AddBindingRecordButton_Click"/>
                                                        <Button x:Name="AddBindingCancelButton" Content="Cancel"
                                                                Height="30" Width="90" FontSize="11" Margin="8,0,0,0"
                                                                Style="{StaticResource SettingsButton}"
                                                                Background="#151B35" BorderBrush="#3A5A8A" Foreground="#A1B2D2"
                                                                Click="AddBindingCancelButton_Click"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                <TextBlock Text="Activation:" Foreground="#A1B2D2" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <ComboBox x:Name="KeybindHoldModeCombo" Width="200" Height="30" FontSize="12"
                                                          Background="#44111A2E" BorderBrush="#558B5CF6" Foreground="White"
                                                          BorderThickness="1" Padding="6,1">
                                                    <ComboBoxItem Content="Hold + tap sound key"/>
                                                    <ComboBoxItem Content="Toggle"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Grid.Row="1">
                                            <ItemsControl x:Name="KeybindingsList" ItemsSource="{Binding Keybindings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#0C1424" BorderBrush="#1B3157" BorderThickness="1"
                                                                CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ActionName}" Foreground="#DDEAFF" FontSize="12" FontWeight="SemiBold"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding Key}" Foreground="#8B5CF6" FontSize="12" FontWeight="Bold"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="Change" Height="26" FontSize="10.5" Margin="0,0,6,0"
                                                                            Click="KeybindingChangeButton_Click" Tag="{Binding}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}">
                                                                                <Setter Property="Padding" Value="8,3"/>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                    <Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                                            Height="26" Click="KeybindingDeleteButton_Click" Tag="{Binding}"
                                                                            Background="#33151515" BorderBrush="#F43F5E" Foreground="#F43F5E">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}">
                                                                                <Setter Property="Padding" Value="0"/>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="NoKeybindingsText" Text="No keybindings yet. Click Add Binding."
                                                       Foreground="#7F899C" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- ══ ADVANCED ══ -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsSection}" Value="Advanced">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Margin="24">
                                        <TextBlock Text="ADVANCED" Foreground="#8B5CF6" FontSize="16" FontWeight="Bold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Foreground="#7F899C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"
                                                   Text="Keyboard layout and calibration."/>

                                        <Border Background="#66081428" BorderBrush="#558B5CF6" BorderThickness="1"
                                            CornerRadius="12" Padding="18,16" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="KEYBOARD LAYOUT" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <ComboBox ItemsSource="{Binding KeyboardLayoutOptions}"
                                                          SelectedItem="{Binding KeyboardLayout}"
                                                          Height="28" HorizontalAlignment="Left" Width="220"
                                                          Background="#44111A2E" BorderBrush="#558B5CF6" Foreground="White" FontSize="12"
                                                          BorderThickness="1" Padding="6,1"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#66081428" BorderBrush="#558B5CF6" BorderThickness="1"
                                            CornerRadius="12" Padding="18,16">
                                            <StackPanel>
                                                <TextBlock Text="KEYBOARD CALIBRATION" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <TextBlock Foreground="#A1B2D2" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8"
                                                           Text="Adjust key positions for your physical keyboard."/>
                                                <Button Content="Open Keyboard Calibration"
                                                        Style="{StaticResource SettingsButton}"
                                                        Click="OpenCalibrationButton_Click"
                                                        HorizontalAlignment="Left" Width="200"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="#A1B2D2"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Bottom"
                                           Margin="18,0,18,12"/>

                            </Grid>
                        </Border>
                    </Grid>
            </Border>

            <!-- Title Bar -->

                <Border HorizontalAlignment="Stretch"
                    Height="44"
                    VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Style="{StaticResource WindowChromeBar}"
                    CornerRadius="0">
                <Grid Margin="18,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="SOUNDFX STUDIO"
                               VerticalAlignment="Center"
                               Foreground="#F2F2F2"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <Button Grid.Column="1"
                            Width="110"
                            Height="32"
                            Click="OpenCalibrationButton_Click"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            AutomationProperties.Name="Calibration">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CalBorder" CornerRadius="8"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CalBorder" Property="Background" Value="#228B5CF6"/>
                                                    <Setter TargetName="CalBorder" Property="BorderBrush" Value="#8B5CF6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2699;" FontSize="13" Foreground="#8B5CF6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Calibration" FontSize="13" Foreground="#DDEAFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowChromeButton}"
                                Content="&#x2212;"
                                FontSize="17"
                                Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource WindowChromeCloseButton}"
                                Content="&#x2715;"
                                FontSize="15"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>



            <!-- Sidebar -->

                <Border Style="{StaticResource GlassPanel}"
                    Width="252"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="35,70,0,0"
                    ClipToBounds="True">

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">

                        <!-- NAVIGATION -->
                        <TextBlock Text="NAVIGATION" FontSize="11" FontWeight="Bold" Foreground="#8B5CF6" Margin="6,2,0,8"/>

                        <!-- Home -->
                        <Button Click="NavigateHome_Click"
                                AutomationProperties.Name="Home"
                                ToolTip="Home">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                            <Setter Property="Background" Value="#228B5CF6"/>
                                            <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="Home" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Sound Library -->
                        <Button Click="NavigateSoundLibrary_Click"
                                AutomationProperties.Name="Sound Library"
                                ToolTip="Sound Library">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="SoundLibrary">
                                            <Setter Property="Background" Value="#228B5CF6"/>
                                            <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="Sound Library" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Effects -->
                        <Button Click="NavigateEffects_Click"
                                AutomationProperties.Name="Effects"
                                ToolTip="Effects">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="Effects">
                                            <Setter Property="Background" Value="#228B5CF6"/>
                                            <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="Effects" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Settings -->
                        <Button Click="NavigateSettings_Click"
                                AutomationProperties.Name="Settings"
                                ToolTip="Settings">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                                            <Setter Property="Background" Value="#228B5CF6"/>
                                            <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#1B3157" Margin="6,8,6,12"/>

                        <!-- AUDIO STATUS -->
                        <TextBlock Text="AUDIO STATUS" FontSize="11" FontWeight="Bold" Foreground="#8B5CF6" Margin="6,14,0,8"/>

                        <Border Background="#0C1424" BorderBrush="#1B3157" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8C6;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#2CE96E" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Output" FontSize="10.5" Foreground="#7F899C"/>
                                        <TextBlock Text="{Binding CurrentOutputDevice}" FontSize="12.5" Foreground="#DDEAFF" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#2CE96E" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Input" FontSize="10.5" Foreground="#7F899C"/>
                                        <TextBlock Text="{Binding CurrentInputDevice}" FontSize="12.5" Foreground="#DDEAFF" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" HorizontalAlignment="Left" Margin="4,0,0,0"
                                             VerticalAlignment="Center" Fill="{Binding IsSoundboardActiveColor}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Soundboard" FontSize="10.5" Foreground="#7F899C"/>
                                        <TextBlock Text="{Binding IsSoundboardActiveText}" FontSize="12.5" Foreground="{Binding IsSoundboardActiveColor}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding RoutingStatus}" FontSize="10.5" Foreground="#7F899C" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>


            <!-- Footer Bar -->
                <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                    Margin="35,0,35,35"
                    Background="#101A2A" BorderBrush="#33476684" BorderThickness="1" CornerRadius="12"
                    Padding="18,10,18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x266B;" FontSize="14" Foreground="#8B5CF6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="#7F899C" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="SOUNDFX STUDIO" Foreground="#33506A" FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>