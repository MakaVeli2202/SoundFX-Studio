<UserControl x:Class="SoundFXStudio.Controls.GamingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SoundFXStudio.Models"
             Foreground="#F7FAFF">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="GAMING ENHANCEMENT"
                           Foreground="#00D4FF"
                           FontSize="24"
                           FontWeight="Bold"/>
                <TextBlock Text="Capture game audio, apply EQ and dynamics for a competitive edge."
                           Foreground="#A2B4CC"
                           FontSize="13"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#191B2736"
                    BorderBrush="#3300D4FF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,12"
                    MinWidth="260">
                <StackPanel>
                    <TextBlock Text="SIGNAL FLOW" Foreground="#00D4FF" FontSize="10.5" FontWeight="Bold"/>
                    <TextBlock Text="Game → Loopback Capture → EQ/DSP → Output"
                               Foreground="#F7FAFF" FontSize="12.5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <TextBlock Text="Voice Changer and Soundboard are independent."
                               Foreground="#8EA2C0" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="1"
                Background="#9C141E2D"
                BorderBrush="#2200D4FF"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="STATUS" Foreground="#00D4FF" FontSize="10.5" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="#F7FAFF" FontSize="14" FontWeight="SemiBold"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ErrorText}" Foreground="#E85555" FontSize="12"
                               Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ErrorText, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1AFFFFFF" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4"
                                    Background="{Binding EnableStatusColor}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding EnableToggleText}"
                                       Foreground="{Binding EnableStatusColor}"
                                       FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Controls -->
            <Border Grid.Column="0"
                    Background="#1A192438"
                    BorderBrush="#2F3E58"
                    BorderThickness="1"
                    Padding="20"
                    Margin="0,0,8,0"
                    CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section: Enable -->
                    <Border Grid.Row="0" Background="#161E31" BorderBrush="#2C476A"
                            BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BF;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                       Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="PRIMARY CONTROLS" Foreground="#00D4FF" FontSize="11"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Enable/Disable Toggle -->
                    <Button Grid.Row="1"
                            Command="{Binding ToggleEnableCommand}"
                            Content="{Binding EnableToggleText}"
                            Height="38"
                            HorizontalAlignment="Left"
                            Padding="18,0"
                            Background="{StaticResource AccentBlueBrush}"
                            BorderBrush="{StaticResource BorderAccentBrush}"
                            Foreground="White"
                            BorderThickness="1"
                            Cursor="Hand"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Margin="0,0,0,14"/>

                    <!-- Process Selection -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE7AC;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                       Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="GAME PROCESS" Foreground="#00D4FF" FontSize="11"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Select the running game or application to capture."
                                   Foreground="#A1B2D2" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding RunningProcesses}"
                                      SelectedItem="{Binding SelectedProcess}"
                                      DisplayMemberPath="DisplayName"
                                      Height="32"
                                      Background="#122036"
                                      BorderBrush="#334A647F"
                                      Foreground="White"
                                      FontSize="12"
                                      BorderThickness="1"
                                      Padding="6,2"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,8,0"/>
                            <Button Grid.Column="1"
                                    Command="{Binding RefreshProcessesCommand}"
                                    Content="&#xE72C;"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Width="34"
                                    Height="32"
                                    Background="#161E31"
                                    BorderBrush="#2C476A"
                                    Foreground="#00D4FF"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Refresh process list"/>
                        </Grid>
                    </StackPanel>

                    <!-- Profile Selection -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                       Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="GAMING PROFILE" Foreground="#00D4FF" FontSize="11"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Choose a preset that matches your use case."
                                   Foreground="#A1B2D2" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding AvailableProfiles}"
                                  SelectedItem="{Binding SelectedProfile}"
                                  DisplayMemberPath="Name"
                                  Height="32"
                                  Background="#122036"
                                  BorderBrush="#334A647F"
                                  Foreground="White"
                                  FontSize="12"
                                  BorderThickness="1"
                                  Padding="6,2"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Headphone EQ Section -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE7F3;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                       Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="HEADPHONE EQ" Foreground="#00D4FF" FontSize="11"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Apply AutoEq-style headphone compensation EQ."
                                   Foreground="#A1B2D2" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Command="{Binding ToggleHeadphoneEqCommand}"
                                Content="{Binding HeadphoneEqToggleText}"
                                Height="34"
                                HorizontalAlignment="Left"
                                Padding="16,0"
                                Background="#161E31"
                                BorderBrush="#2C476A"
                                Foreground="{Binding HeadphoneEqStatusColor}"
                                BorderThickness="1"
                                Cursor="Hand"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding AvailableHeadphoneProfiles}"
                                  SelectedItem="{Binding SelectedHeadphoneProfile}"
                                  DisplayMemberPath="Name"
                                  Height="32"
                                  Background="#122036"
                                  BorderBrush="#334A647F"
                                  Foreground="White"
                                  FontSize="12"
                                  BorderThickness="1"
                                  Padding="6,2"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Spatial Audio Section -->
                    <StackPanel Grid.Row="5" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                       Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="SPATIAL AUDIO" Foreground="#00D4FF" FontSize="11"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="HRTF spatialization for headphone 3D audio."
                                   Foreground="#A1B2D2" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Command="{Binding ToggleHrtfCommand}"
                                Content="{Binding HrtfToggleText}"
                                Height="34"
                                HorizontalAlignment="Left"
                                Padding="16,0"
                                Background="#161E31"
                                BorderBrush="#2C476A"
                                Foreground="{Binding HrtfStatusColor}"
                                BorderThickness="1"
                                Cursor="Hand"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding AvailableHrtfProfiles}"
                                  SelectedItem="{Binding SelectedHrtfProfile}"
                                  DisplayMemberPath="Name"
                                  Height="32"
                                  Background="#122036"
                                  BorderBrush="#334A647F"
                                  Foreground="White"
                                  FontSize="12"
                                  BorderThickness="1"
                                  Padding="6,2"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding ImportHrtfProfileCommand}"
                                    Content="Import SOFA Profile"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    Padding="12,0"
                                    Background="#161E31"
                                    BorderBrush="#2C476A"
                                    Foreground="#00D4FF"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    FontSize="11"
                                    FontWeight="SemiBold"/>
                            <Button Grid.Column="1"
                                    Command="{Binding DeleteHrtfProfileCommand}"
                                    Content="Delete"
                                    Height="30"
                                    Width="60"
                                    Padding="8,0"
                                    Background="#161E31"
                                    BorderBrush="#5C2C2C"
                                    Foreground="#E85555"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    FontSize="11"
                                    FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Azimuth -->
                        <TextBlock Text="AZIMUTH" Foreground="#00D4FF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Minimum="-180" Maximum="180"
                                    SmallChange="5" LargeChange="15"
                                    TickFrequency="45"
                                    TickPlacement="BottomRight"
                                    Value="{Binding HrtfAzimuth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"/>
                            <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="5" Padding="8,3">
                                <TextBlock Text="{Binding HrtfAzimuth, StringFormat='{}{0:F0}°'}"
                                           Foreground="White" FontSize="11" FontWeight="Bold"
                                           MinWidth="44" TextAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Elevation -->
                        <TextBlock Text="ELEVATION" Foreground="#00D4FF" FontSize="10.5" FontWeight="Bold" Margin="0,6,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Minimum="-90" Maximum="90"
                                    SmallChange="5" LargeChange="15"
                                    TickFrequency="30"
                                    TickPlacement="BottomRight"
                                    Value="{Binding HrtfElevation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"/>
                            <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="5" Padding="8,3">
                                <TextBlock Text="{Binding HrtfElevation, StringFormat='{}{0:F0}°'}"
                                           Foreground="White" FontSize="11" FontWeight="Bold"
                                           MinWidth="44" TextAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Spatial Intensity -->
                        <TextBlock Text="SPATIAL INTENSITY" Foreground="#00D4FF" FontSize="10.5" FontWeight="Bold" Margin="0,6,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Minimum="0" Maximum="100"
                                    SmallChange="5" LargeChange="10"
                                    TickFrequency="10"
                                    TickPlacement="BottomRight"
                                    Value="{Binding HrtfSpatialMixPct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"/>
                            <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="5" Padding="8,3">
                                <TextBlock Text="{Binding HrtfSpatialMixPct, StringFormat='{}{0:F0}%'}"
                                           Foreground="White" FontSize="11" FontWeight="Bold"
                                           MinWidth="44" TextAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Head Tracking Section -->
                        <Border Background="#0DFFFFFF" CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="HEAD TRACKING" Foreground="#00D4FF" FontSize="11"
                                           FontWeight="Bold" Margin="0,0,0,6"/>

                                <!-- Provider Info -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Provider"
                                               Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding HeadTrackingProviderName}"
                                                   Foreground="White" FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Background="#1AFFFFFF" CornerRadius="5" Padding="6,2">
                                            <TextBlock Text="{Binding HeadTrackingProviderStatus}"
                                                       Foreground="{Binding HeadTrackingProviderStatusColor}"
                                                       FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Enable Toggle -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Enable Head Tracking"
                                               Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding IsHrtfHeadTrackingEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding HeadTrackingAvailable}"
                                              Foreground="White" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Status -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Status"
                                               Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding HeadTrackingStatus}"
                                               Foreground="{Binding HeadTrackingStatusColor}"
                                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Orientation display -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="Yaw: " Foreground="#AAAAAA" FontSize="11"/>
                                        <TextBlock Text="{Binding HeadYaw, StringFormat='{}{0:F1}°'}"
                                                   Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Pitch: " Foreground="#AAAAAA" FontSize="11"/>
                                        <TextBlock Text="{Binding HeadPitch, StringFormat='{}{0:F1}°'}"
                                                   Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Calibrate Button -->
                                <Button Command="{Binding CalibrateHeadTrackingCommand}"
                                        Content="Calibrate"
                                        Height="28" Padding="12,0"
                                        Background="#2563EB" BorderBrush="#1D4ED8"
                                        Foreground="White" BorderThickness="1"
                                        Cursor="Hand" FontSize="11" FontWeight="SemiBold"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Capture Buttons -->
                    <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Command="{Binding StartCaptureCommand}"
                                Content="{Binding CaptureButtonText}"
                                Height="40"
                                Padding="20,0"
                                Background="#22C55E"
                                BorderBrush="#16A34A"
                                Foreground="White"
                                BorderThickness="1"
                                Cursor="Hand"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Margin="0,0,10,0"/>
                        <Button Command="{Binding StopCaptureCommand}"
                                Content="Stop"
                                Height="40"
                                Padding="20,0"
                                Background="#E85555"
                                BorderBrush="#DC2626"
                                Foreground="White"
                                BorderThickness="1"
                                Cursor="Hand"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- LATENCY / PERFORMANCE Section -->
                    <Border Grid.Row="7" Background="#0DFFFFFF" CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="LATENCY / PERFORMANCE" Foreground="#00D4FF" FontSize="11"
                                       FontWeight="Bold" Margin="0,0,0,6"/>

                            <!-- Safety Warning -->
                            <Border Background="#22E85555" CornerRadius="5" Padding="8,6" Margin="0,0,0,6"
                                    Visibility="{Binding HasLatencyModeWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding LatencyModeSafetyMessage}"
                                           Foreground="#FCA5A5" FontSize="10" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Latency Mode -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mode"
                                           Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableLatencyModes}"
                                          SelectedItem="{Binding SelectedLatencyMode}"
                                          Width="120" Height="26"
                                          Background="#122036" BorderBrush="#334A647F"
                                          Foreground="White" FontSize="11"
                                          BorderThickness="1" Padding="4,1"/>
                            </Grid>

                            <!-- DSP P95 -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DSP P95"
                                           Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DspP95Us, StringFormat='{}{0:F0} µs'}"
                                           Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Grid>

                            <!-- DSP P99 -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DSP P99"
                                           Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DspP99Us, StringFormat='{}{0:F0} µs'}"
                                           Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Grid>

                            <!-- DSP Budget -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DSP Budget"
                                           Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DspBudgetPercent, StringFormat='{}{0:F1}%'}"
                                           Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Grid>

                            <!-- Capture → DSP Latency -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Capture → DSP"
                                           Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CaptureToDspLatencyMs, StringFormat='{}{0:F1} ms'}"
                                           Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Grid>

                            <!-- Output Buffer -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Output Buffer"
                                           Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ConfiguredOutputLatencyMs, StringFormat='{}{0:F0} ms (est.)'}"
                                           Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Grid>

                            <!-- Pipeline -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pipeline"
                                           Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding EstimatedPipelineLatencyMs, StringFormat='{}{0:F0} ms (app est.)'}"
                                           Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Grid>

                            <!-- Capture Starvation -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Capture Starvation"
                                           Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CaptureStarvationCount}"
                                           Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Grid>

                            <!-- Status -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Status"
                                           Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding LatencyHealthStatus}"
                                           Foreground="{Binding LatencyHealthStatusColor}"
                                           FontSize="11" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Profile Description -->
                    <Border Grid.Row="8"
                            Background="#0DFFFFFF"
                            CornerRadius="10"
                            Padding="14"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedProfile.Name}"
                                       Foreground="#F7FAFF" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedProfile.Description}"
                                       Foreground="#8EA2C0" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: Info -->
            <Border Grid.Column="1"
                    Background="#1A192438"
                    BorderBrush="#2F3E58"
                    BorderThickness="1"
                    Padding="20"
                    Margin="8,0,0,0"
                    CornerRadius="18">
                <StackPanel>
                    <Border Background="#161E31" BorderBrush="#2C476A"
                            BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                       Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="HOW IT WORKS" Foreground="#00D4FF" FontSize="11"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="1. Select a running game process from the list."
                               Foreground="#A1B2D2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="2. Choose a gaming profile (EQ + dynamics preset)."
                               Foreground="#A1B2D2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="3. Enable the enhancement and start capture."
                               Foreground="#A1B2D2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="4. Game audio is captured, processed, and sent to your speakers."
                               Foreground="#A1B2D2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Border Height="1" Background="#2F3E58" Margin="0,8,0,12"/>

                    <TextBlock Text="NOTES" Foreground="#00D4FF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="&#x2022; The game's original audio is suppressed to prevent doubling.&#x0a;&#x2022; Voice Changer and Soundboard remain independent.&#x0a;&#x2022; Requires the audio engine for routing."
                               Foreground="#8EA2C0" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
