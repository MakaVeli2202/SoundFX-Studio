<Window x:Class="SoundFXStudio.Views.Dialogs.VoicemeeterPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Mixer"
        Width="600" Height="640"
        WindowStyle="None"
        Background="#08091F"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        SourceInitialized="Window_SourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1"
            CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Sound Mixer" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Background="#1AFFFFFF" CornerRadius="6" Padding="8,3" Margin="12,0,0,0"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <TextBlock Text="powered by Voicemeeter" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="Done_Click" Cursor="Hand" Width="30" Height="30">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                                    <Path Data="M 8 8 L 22 22 M 22 8 L 8 22" Stroke="#8891B8"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E8F43F5E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Session overview -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Routing overview" Foreground="{StaticResource UiTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Review what you hear, what your team hears, and how each strip is currently routed." Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <Border HorizontalAlignment="Left" Background="#142AB8FF" CornerRadius="999" BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="1" Padding="10,4" Margin="0,10,0,0">
                            <TextBlock x:Name="ConnectionStateText" Text="Connecting" Foreground="{StaticResource AccentBlueBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="12" Padding="14,10" MinWidth="220">
                        <StackPanel>
                            <TextBlock Text="Quick controls" Foreground="{StaticResource UiTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Mute the current mix or review the live routing state at a glance." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Global quick-mute bar -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MuteHearBtn" Click="MuteHear_Click" Cursor="Hand" Margin="0,0,10,0"
                                ToolTip="Mute what YOU hear (bus A1)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="9" Padding="12,8"
                                            Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mute what I hear" Foreground="#C7CEEA" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MuteTeamBtn" Click="MuteTeam_Click" Cursor="Hand" Margin="0,0,10,0"
                                ToolTip="Mute what your TEAM hears (bus B1)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="9" Padding="12,8"
                                            Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mute what team hears" Foreground="#C7CEEA" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MuteAllBtn" Click="MuteAll_Click" Cursor="Hand"
                                ToolTip="Mute EVERY input">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="9" Padding="12,8"
                                            Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mute all" Foreground="#C7CEEA" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <CheckBox x:Name="ShowAllCheck" Grid.Column="1" Content="Show all inputs"
                              Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"
                              Cursor="Hand" Click="ShowAll_Click"/>
                </Grid>
            </Border>

            <!-- Device actions -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" Padding="20,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Device actions:" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="RemoveInput1Btn" Content="Remove Input 1 device"
                            Background="#22112233" BorderBrush="#10B981" Foreground="#A7F3D0"
                            BorderThickness="1" Cursor="Hand" FontSize="11" Padding="12,6" Margin="0,0,8,0"
                            ToolTip="Unselect the microphone/device assigned to Hardware Input 1 (Strip[0]) by auto-setup"
                            Click="RemoveInput1_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#3310B981"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="RemoveHwOutBtn" Content="Remove Hardware Out device"
                            Background="#22112233" BorderBrush="#10B981" Foreground="#A7F3D0"
                            BorderThickness="1" Cursor="Hand" FontSize="11" Padding="12,6" Margin="0,0,8,0"
                            ToolTip="Unselect the device assigned to Hardware Output A1 (Bus[0]) by auto-setup"
                            Click="RemoveHwOut_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#3310B981"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="ResetBothBtn" Content="Reset Both"
                            Background="#331E0E12" BorderBrush="#F43F5E" Foreground="#FECDD3"
                            BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11" Padding="12,6"
                            ToolTip="Remove selection from both Hardware Input 1 and Hardware Output — no device selected"
                            Click="ResetBoth_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#44F43F5E"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#F43F5E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Strips (generated) -->
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="StripsPanel" Margin="20,14,20,8"/>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="5" Background="{StaticResource SurfaceAltBrush}" CornerRadius="0,0,16,16">
                <Grid Margin="20,0">
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="TestHearBtn" Content="Hear what others hear"
                                Background="#22112233" BorderBrush="#10B981" Foreground="#A7F3D0"
                                BorderThickness="1" Cursor="Hand" FontSize="12" Padding="14,7" Margin="0,0,10,0"
                                ToolTip="Listen to the exact mix your mic sends to Discord (VoiceMeeter B1)"
                                Click="TestHear_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3310B981"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="OpenVmBtn" Content="Open Voicemeeter" 
                                Background="#151B35" BorderBrush="#3A5A8A" Foreground="#A1B2D2"
                                BorderThickness="1" Cursor="Hand" FontSize="12" Padding="14,7"
                                Click="OpenVm_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2A2A5A8A"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8B5CF6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Done"
                                Background="#222A2A66" BorderBrush="#558B5CF6" Foreground="White"
                                BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="12" Padding="14,7" Margin="10,0,0,0"
                                Click="Done_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#442A2A66"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8B5CF6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
